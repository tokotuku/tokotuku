{
  "name": "tokotuku-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "template/packages/*"
  ],
  "scripts": {
    "build": "moon run :build",
    "dev": "moon run :dev",
    "example": "moon run example:dev",
    "lint": "moon run :lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "moon run :typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "lefthook": "2.1.10",
    "typescript": "5.9.3"
  }
}
