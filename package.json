{
  "name": "karsa",
  "version": "0.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/karsa-ui/karsa.git"
  },
  "homepage": "https://github.com/karsa-ui/karsa#readme",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*",
    "configs",
    "tools/e2e-install"
  ],
  "scripts": {
    "build": "WRANGLER_WRITE_LOGS=false bun run --workspaces --if-present --sequential build",
    "dev": "bun run --workspaces --if-present --parallel dev",
    "test": "bun run --workspaces --if-present --sequential test",
    "lint": "bun run --workspaces --if-present --sequential lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:assets": "node scripts/check-asset-budgets.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:performance": "node scripts/check-performance-budgets.mjs",
    "check:refactor": "node scripts/check-refactor-invariants.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:docs-i18n": "bun run --cwd apps/docs parity",
    "typecheck:dependencies": "bun run --cwd packages/core build && bun run --cwd packages/catalog build && bun run --cwd packages/orders build",
    "typecheck": "bun run typecheck:dependencies && bun run --workspaces --if-present --sequential typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "release:private": "bun scripts/publish-private.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "2.31.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.10.6",
    "lefthook": "2.1.10",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
