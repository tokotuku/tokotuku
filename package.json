{
  "name": "karsa",
  "version": "0.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/karsa-ui/karsa.git"
  },
  "homepage": "https://github.com/karsa-ui/karsa#readme",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*",
    "configs",
    "tools/e2e-install"
  ],
  "scripts": {
    "build": "WRANGLER_WRITE_LOGS=false moon run :build",
    "dev": "moon run :dev",
    "test": "moon run :test",
    "lint": "moon run :lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:docs-i18n": "bun run --cwd apps/docs parity",
    "typecheck": "moon run :typecheck",
    "ci": "WRANGLER_WRITE_LOGS=false moon run :lint :typecheck :test :build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "release:private": "bun scripts/publish-private.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "2.31.0",
    "@moonrepo/cli": "2.4.3",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.10.6",
    "lefthook": "2.1.10",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "trustedDependencies": [
    "@moonrepo/cli"
  ]
}
