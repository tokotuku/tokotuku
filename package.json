{
  "name": "tokotuku-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*",
    "configs"
  ],
  "scripts": {
    "build": "moon run :build",
    "dev": "moon run :dev",
    "example-bare": "moon run example-bare:dev",
    "example-seeded": "moon run example-seeded:dev",
    "example-styled": "moon run example-styled:dev",
    "test": "moon run :test",
    "lint": "moon run :lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "moon run :typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "2.31.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.10.6",
    "lefthook": "2.1.10",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
