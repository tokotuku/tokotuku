---
import brand from "virtual:karsa/config";
import Card from "@karsa/ui/Card.astro";
import Layout from "@karsa/ui/DocumentLayout.astro";
import SiteFooter from "@karsa/ui/SiteFooter.astro";
import SiteHeader from "@karsa/ui/SiteHeader.astro";

const navLinks = brand.site?.links ?? [];
const capabilities = [
  {
    number: "01",
    title: "Pengembangan energi",
    description:
      "Merancang dan mengembangkan solusi energi yang relevan dengan kebutuhan wilayah serta potensi lokal.",
  },
  {
    number: "02",
    title: "Operasi berkelanjutan",
    description:
      "Menjaga aset dan operasi tetap andal melalui disiplin keselamatan, kinerja, dan perbaikan berkelanjutan.",
  },
  {
    number: "03",
    title: "Kemitraan strategis",
    description:
      "Menghubungkan pemangku kepentingan untuk menciptakan nilai jangka panjang bagi bisnis dan masyarakat.",
  },
];
const projects = [
  {
    label: "Transisi energi",
    title: "Membuka akses pada energi yang lebih tangguh",
    description:
      "Portofolio dan kemitraan Arunika diarahkan untuk memperkuat ketahanan energi sekaligus mendukung pertumbuhan ekonomi daerah.",
  },
  {
    label: "Dampak bersama",
    title: "Tumbuh bersama ekosistem lokal",
    description:
      "Kami membangun kolaborasi yang menghargai keahlian lokal, membuka kesempatan, dan meninggalkan manfaat yang bertahan lama.",
  },
];
---

<Layout
  title={`${brand.name} — Energi untuk hari esok`}
  description="Arunika Energi membangun solusi energi Indonesia yang andal, bertanggung jawab, dan berorientasi pada masa depan."
  siteName={brand.name}
  lang={brand.locale}
  palette={brand.palette}
>
  <SiteHeader
    brand={brand}
    current="home"
    showSearch={false}
    announcement={brand.site?.announcement}
    links={navLinks}
    labels={{
      home: "Beranda",
      openMenu: "Buka menu",
      closeMenu: "Tutup menu",
      navigation: "Navigasi utama",
      theme: "Ganti tema",
    }}
  />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <p class="eyebrow">Arunika Energi / Company profile</p>
        <h1 id="hero-title">Energi yang menggerakkan <em>masa depan.</em></h1>
        <div class="hero-bottom">
          <p class="hero-lede">Kami membangun fondasi energi Indonesia yang andal, bertanggung jawab, dan siap menjawab perubahan.</p>
          <a class="text-link" href="#kontak">Mari berbicara <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="tentang" class="intro section-shell" aria-labelledby="intro-title">
      <div class="section-label"><span>01</span><span>Tentang Arunika</span></div>
      <div class="intro-copy">
        <h2 id="intro-title">Menyalakan kemungkinan, dengan tanggung jawab.</h2>
        <p>Arunika Energi adalah perusahaan Indonesia yang berfokus pada pengembangan dan pengelolaan solusi energi. Kami percaya kemajuan dimulai dari energi yang tersedia, terjangkau, dan dikelola dengan cara yang tepat.</p>
        <p>Dengan memadukan ketajaman bisnis, keunggulan operasional, dan kepedulian pada lingkungan sekitar, kami bekerja untuk menghadirkan nilai yang bertahan bagi pelanggan, mitra, dan generasi berikutnya.</p>
      </div>
    </section>

    <section id="kapabilitas" class="capabilities section-shell" aria-labelledby="capabilities-title">
      <div class="section-label"><span>02</span><span>Kapabilitas</span></div>
      <div>
        <h2 id="capabilities-title">Dari visi menjadi dampak nyata.</h2>
        <div class="capability-grid">
          {capabilities.map((capability) => (
            <Card class="capability-card">
              <span class="card-number">{capability.number}</span>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <section id="proyek" class="proof section-shell" aria-labelledby="proof-title">
      <div class="section-label"><span>03</span><span>Jejak dan proyek</span></div>
      <div>
        <h2 id="proof-title">Bukti terbaik adalah kemajuan yang terasa.</h2>
        <div class="project-grid">
          {projects.map((project) => (
            <Card class="project-card">
              <p class="project-label">{project.label}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <span class="project-mark" aria-hidden="true">↗</span>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <section id="kontak" class="contact section-shell" aria-labelledby="contact-title">
      <div class="section-label"><span>04</span><span>Hubungi kami</span></div>
      <div class="contact-panel">
        <h2 id="contact-title">Mari membangun hari esok, bersama.</h2>
        <p>Baik Anda mencari mitra, memiliki peluang kolaborasi, atau ingin mengenal Arunika lebih jauh, kami siap mendengarkan.</p>
        <a class="contact-email" href="mailto:halo@arunikaenergi.id">halo@arunikaenergi.id <span aria-hidden="true">↗</span></a>
        <div class="contact-details">
          <div><span>Telepon</span><a href="tel:+622150555050">+62 21 5055 5050</a></div>
          <div><span>Kantor</span><address>Jakarta, Indonesia</address></div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter
    brandName={brand.name}
    tagline="Energi yang bertumbuh bersama Indonesia."
    links={navLinks}
    newsletterLabel="Mari tetap terhubung"
    newsletterHint="Untuk informasi perusahaan dan kabar terbaru Arunika Energi."
    newsletterEmailLabel="Alamat email"
    newsletterSubmit="Kirim"
    navigationLabel="Navigasi footer"
    madeWith="Bergerak dengan tanggung jawab."
  />
</Layout>

<style>
  :global(body) { margin: 0; }
  .hero { border-bottom: 1px solid var(--karsa-color-border); }
  .hero-inner { width: min(100% - 2.5rem, 78rem); margin: auto; padding: clamp(5rem, 13vw, 10rem) 0 clamp(3rem, 7vw, 5.5rem); }
  .eyebrow, .section-label, .project-label, .card-number, .contact-details span { color: var(--karsa-color-accent); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .eyebrow { margin: 0 0 2rem; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 10ch; margin-bottom: 0; font-family: var(--karsa-font-family-display); font-size: clamp(3.8rem, 10vw, 8.5rem); font-weight: 400; letter-spacing: -.045em; line-height: .92; }
  h1 em { color: var(--karsa-color-accent); font-style: normal; }
  .hero-bottom { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: clamp(3rem, 8vw, 7rem); }
  .hero-lede { max-width: 27rem; margin-bottom: 0; color: var(--karsa-color-fg-muted); font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.65; }
  .text-link, .contact-email { color: var(--karsa-color-fg); font-weight: 700; text-decoration: none; }
  .text-link span, .contact-email span { color: var(--karsa-color-accent); font-size: 1.25em; }
  .section-shell { display: grid; grid-template-columns: minmax(8rem, 1fr) minmax(0, 3fr); gap: clamp(2rem, 8vw, 8rem); width: min(100% - 2.5rem, 78rem); margin: auto; padding: clamp(4.5rem, 10vw, 8rem) 0; border-bottom: 1px solid var(--karsa-color-border); }
  .section-label { display: flex; gap: .8rem; align-items: start; color: var(--karsa-color-fg-muted); }
  .section-label span:first-child { color: var(--karsa-color-accent); }
  h2 { max-width: 14ch; margin-bottom: 2.2rem; font-family: var(--karsa-font-family-display); font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 400; letter-spacing: -.035em; line-height: .98; }
  .intro-copy { max-width: 42rem; }
  .intro-copy p { max-width: 39rem; color: var(--karsa-color-fg-muted); font-size: 1.05rem; line-height: 1.75; }
  .intro-copy p + p { margin-top: 1.2rem; }
  .capability-grid, .project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .capability-card, .project-card { min-height: 16rem; justify-content: space-between; padding: 1.5rem; box-shadow: none; }
  .capability-card h3, .project-card h3 { max-width: 12ch; margin: 2.5rem 0 .8rem; font-family: var(--karsa-font-family-display); font-size: 1.65rem; font-weight: 400; line-height: 1; }
  .capability-card p, .project-card p:last-of-type { margin-bottom: 0; color: var(--karsa-color-fg-muted); font-size: .9rem; line-height: 1.6; }
  .proof h2 { max-width: 12ch; }
  .project-grid { grid-template-columns: repeat(2, 1fr); }
  .project-card { position: relative; min-height: 18rem; background: var(--karsa-color-bg-subtle); }
  .project-card h3 { max-width: 16ch; margin-top: 3.5rem; font-size: clamp(1.7rem, 3vw, 2.6rem); }
  .project-label { margin-bottom: 0; }
  .project-mark { align-self: end; color: var(--karsa-color-accent); font-size: 1.7rem; }
  .contact { border-bottom: 0; }
  .contact-panel { padding: clamp(2rem, 5vw, 4rem); background: var(--karsa-color-fg); color: var(--karsa-color-surface); }
  .contact-panel h2 { max-width: 10ch; color: var(--karsa-color-surface); }
  .contact-panel > p { max-width: 32rem; color: color-mix(in srgb, var(--karsa-color-surface) 70%, transparent); line-height: 1.65; }
  .contact-email { display: inline-block; margin: 1.4rem 0 3rem; color: var(--karsa-color-surface); font-family: var(--karsa-font-family-display); font-size: clamp(1.3rem, 3vw, 2.4rem); font-weight: 400; }
  .contact-details { display: flex; gap: 4rem; padding-top: 1.25rem; border-top: 1px solid color-mix(in srgb, var(--karsa-color-surface) 25%, transparent); }
  .contact-details div { display: grid; gap: .4rem; }
  .contact-details span { color: var(--karsa-color-accent); }
  .contact-details a, .contact-details address { color: var(--karsa-color-surface); font-size: .9rem; font-style: normal; text-decoration: none; }
  @media (max-width: 760px) { .hero-inner, .section-shell { width: min(100% - 2rem, 78rem); } .hero-bottom, .contact-details { align-items: start; flex-direction: column; } .section-shell { grid-template-columns: 1fr; gap: 2rem; } .capability-grid, .project-grid { grid-template-columns: 1fr; } .capability-card, .project-card { min-height: auto; } }
</style>
