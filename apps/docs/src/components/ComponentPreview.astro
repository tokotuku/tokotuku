---
import "@takontuku/theme/styles.css";

interface Props {
  label?: string;
  layout?: "row" | "stack";
}

const { label = "Component preview", layout = "row" } = Astro.props;
const layoutClass = {
  row: "preview--row",
  stack: "preview--stack",
}[layout];

import "./ComponentPreview.css";
---

<div class:list={["preview", layoutClass]} aria-label={label}>
  <slot />
</div>
