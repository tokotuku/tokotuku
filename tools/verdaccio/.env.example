# Copy to .env (gitignored) and fill in.
#
# Get this from the Cloudflare dashboard: Networking > Tunnels > Create a
# tunnel > pick "Cloudflared" as the connector > copy the token value shown
# (the long string starting "eyJ...", not the whole install command) > add a
# Public Hostname for the tunnel pointing at http://verdaccio:4873 (the
# service name on this compose network, not localhost).
CLOUDFLARE_TUNNEL_TOKEN=
