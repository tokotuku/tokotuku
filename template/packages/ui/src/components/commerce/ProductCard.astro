---
interface Props {
  id: number;
  name: string;
  description: string;
  price: string;
  priceCents: number;
  imageUrl: string;
  stock?: number;
}

const { id, name, description, price, priceCents, imageUrl, stock = 1 } = Astro.props;
const serialized = JSON.stringify({ id, name, priceCents, imageUrl });
---

<article class="product-card">
  <a class="media" href={`/products/${id}`} aria-label={`View ${name}`}>
    <img src={imageUrl} alt="" loading="lazy" />
  </a>
  <div class="body">
    <div>
      <p class="eyebrow">Everyday essential</p>
      <h2><a href={`/products/${id}`}>{name}</a></h2>
      <p class="description">{description}</p>
    </div>
    <div class="footer">
      <strong>{price}</strong>
      <button type="button" data-add-to-cart data-product={serialized} disabled={stock <= 0}>{stock > 0 ? "Add to cart" : "Sold out"}</button>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--tk-color-border);
    border-radius: var(--tk-radius-xl);
    background: var(--tk-color-bg);
    box-shadow: var(--tk-shadow-sm);
    transition:
      transform var(--tk-duration-normal) var(--tk-easing-standard),
      box-shadow var(--tk-duration-normal) var(--tk-easing-standard);
  }

  .product-card:hover {
    transform: translateY(-0.2rem);
    box-shadow: var(--tk-shadow-md);
  }

  .media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--tk-color-bg-subtle);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--tk-duration-slow) var(--tk-easing-standard);
  }

  .product-card:hover img {
    transform: scale(1.03);
  }

  .body {
    display: flex;
    min-height: 12rem;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--tk-spacing-5);
    padding: var(--tk-spacing-5);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    margin-top: var(--tk-spacing-1);
    font-size: var(--tk-font-size-xl);
  }

  h2 a {
    color: var(--tk-color-fg);
    text-decoration: none;
  }

  .eyebrow {
    color: var(--tk-color-accent);
    font-size: var(--tk-font-size-xs);
    font-weight: var(--tk-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .description {
    display: -webkit-box;
    margin-top: var(--tk-spacing-2);
    overflow: hidden;
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-sm);
    line-height: var(--tk-line-height-relaxed);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tk-spacing-3);
  }

  strong {
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-lg);
  }

  button {
    min-height: 2.5rem;
    padding-inline: var(--tk-spacing-4);
    border: 0;
    border-radius: var(--tk-radius-md);
    background: var(--tk-color-accent);
    color: var(--tk-color-accent-fg);
    cursor: pointer;
    font: inherit;
    font-size: var(--tk-font-size-sm);
    font-weight: var(--tk-font-weight-semibold);
  }

  button:focus-visible {
    outline: 2px solid var(--tk-color-focus-ring);
    outline-offset: 2px;
  }
</style>
