---
import type { ChartInput } from "../../charts/types.js";

interface Props {
  input: ChartInput;
  title: string;
  description?: string;
  height?: number;
  showTable?: boolean;
}

const { input, title, description, height = 360, showTable = true } = Astro.props;
const rows = (
  "values" in input.data && Array.isArray(input.data.values) ? input.data.values : []
) as Record<string, unknown>[];
const columns = rows.length > 0 ? Object.keys(rows[0] as object) : [];
const serialized = JSON.stringify({ input, title, description }).replaceAll("<", "\\u003c");
---

<figure data-chart-root data-chart-state="loading" style={`--chart-height:${height}px`}>
  <figcaption>
    <div>
      <h2>{title}</h2>
      {description && <p>{description}</p>}
    </div>
    <slot name="actions" />
  </figcaption>

  <div class="chart-stage">
    <div data-chart-canvas role="img" aria-label={description ?? title}></div>
    <p class="loading" data-chart-loading>Rendering visualization…</p>
    <p class="error" data-chart-error>Unable to render chart.</p>
  </div>

  {
    showTable && rows.length > 0 && (
      <details>
        <summary>View accessible data table</summary>
        <div class="table-frame">
          <table>
            <caption>{title}</caption>
            <thead>
              <tr>{columns.map((column) => <th>{column}</th>)}</tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>{columns.map((column) => <td>{String(row[column] ?? "—")}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )
  }

  <script is:inline type="application/json" data-chart-config set:html={serialized}></script>
</figure>

<script>
  import { disposeCharts, mountCharts } from "../../charts/client.js";

  mountCharts();
  document.addEventListener("astro:page-load", () => mountCharts());
  document.addEventListener("astro:before-swap", disposeCharts);
</script>

<style>
  figure {
    margin: 0;
    padding: var(--tk-spacing-5);
    border: 1px solid var(--tk-color-border);
    border-radius: var(--tk-radius-xl);
    background: var(--tk-color-bg);
    box-shadow: var(--tk-shadow-sm);
  }

  figcaption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--tk-spacing-4);
    margin-bottom: var(--tk-spacing-4);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-lg);
  }

  figcaption p {
    margin-top: var(--tk-spacing-1);
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-sm);
  }

  .chart-stage {
    position: relative;
    min-height: var(--chart-height);
  }

  [data-chart-canvas] {
    width: 100%;
    height: var(--chart-height);
  }

  .loading,
  .error {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-sm);
  }

  .error {
    display: none;
    color: var(--tk-color-danger);
  }

  figure[data-chart-state="ready"] .loading,
  figure[data-chart-state="ready"] .error {
    display: none;
  }

  figure[data-chart-state="error"] .loading {
    display: none;
  }

  figure[data-chart-state="error"] .error {
    display: grid;
  }

  details {
    margin-top: var(--tk-spacing-4);
    border-top: 1px solid var(--tk-color-border);
    padding-top: var(--tk-spacing-3);
  }

  summary {
    width: fit-content;
    cursor: pointer;
    color: var(--tk-color-accent);
    font-size: var(--tk-font-size-sm);
    font-weight: var(--tk-font-weight-medium);
  }

  .table-frame {
    margin-top: var(--tk-spacing-3);
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-xs);
  }

  caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  th,
  td {
    padding: var(--tk-spacing-2) var(--tk-spacing-3);
    border-bottom: 1px solid var(--tk-color-border);
    text-align: left;
    white-space: nowrap;
  }
</style>
