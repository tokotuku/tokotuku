---
interface Props {
  labels: string[];
  primary: number[];
  secondary?: number[];
  primaryLabel?: string;
  secondaryLabel?: string;
  height?: number;
  currency?: boolean;
}

const {
  labels,
  primary,
  secondary = [],
  primaryLabel = "Sales",
  secondaryLabel = "Budget",
  height = 280,
  currency = true,
} = Astro.props;

const width = 760;
const chartHeight = 240;
const left = 58;
const right = 14;
const top = 15;
const bottom = 28;
const allValues = [...primary, ...secondary];
const max = Math.max(...allValues, 1);
const roundedMax = Math.ceil(max / 1000) * 1000 || max;
const plotWidth = width - left - right;
const plotHeight = chartHeight - top - bottom;
const points = (values: number[]) =>
  values.map((value, index) => ({
    x: left + (index * plotWidth) / Math.max(values.length - 1, 1),
    y: top + plotHeight - (value / roundedMax) * plotHeight,
  }));
const line = (values: number[]) =>
  points(values)
    .map((point, index) => `${index === 0 ? "M" : "L"}${point.x.toFixed(1)},${point.y.toFixed(1)}`)
    .join(" ");
const area = (values: number[]) =>
  `${line(values)} L${left + plotWidth},${top + plotHeight} L${left},${top + plotHeight} Z`;
const ticks = [0, 0.25, 0.5, 0.75, 1];
---

<div class="area-chart" style={`--chart-height:${height}px`}>
  <div class="chart-legend">
    <span><i></i>{primaryLabel}</span>
    {secondary.length > 0 && <span><i class="secondary"></i>{secondaryLabel}</span>}
  </div>
  <svg viewBox={`0 0 ${width} ${chartHeight}`} role="img" aria-label={`${primaryLabel} over time`} preserveAspectRatio="none">
    <defs>
      <linearGradient id="primary-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2876df" stop-opacity=".32" /><stop offset="1" stop-color="#2876df" stop-opacity=".04" /></linearGradient>
      <linearGradient id="secondary-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ed3343" stop-opacity=".28" /><stop offset="1" stop-color="#ed3343" stop-opacity=".02" /></linearGradient>
    </defs>
    {ticks.map((tick) => {
      const y = top + plotHeight - tick * plotHeight;
      return <g><line x1={left} y1={y} x2={width - right} y2={y} class="grid" /><text x={left - 12} y={y + 4} text-anchor="end">{currency ? `$${Math.round(roundedMax * tick / 1000)}k` : Math.round(roundedMax * tick)}</text></g>;
    })}
    {secondary.length > 0 && <path d={area(secondary)} fill="url(#secondary-fill)" />}
    <path d={area(primary)} fill="url(#primary-fill)" />
    {secondary.length > 0 && <path d={line(secondary)} class="line secondary-line" />}
    <path d={line(primary)} class="line primary-line" />
    {labels.map((label, index) => <text x={left + (index * plotWidth) / Math.max(labels.length - 1, 1)} y={chartHeight - 5} text-anchor="middle">{label}</text>)}
  </svg>
</div>

<style>
  .area-chart { position: relative; min-height: var(--chart-height); padding-top: 33px; }
  .chart-legend { position: absolute; top: 0; right: 0; display: flex; gap: 17px; color: var(--tk-color-fg-muted); font-size: 12px; }
  .chart-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .chart-legend i { width: 9px; height: 9px; border-radius: 50%; background: #2876df; }
  .chart-legend i.secondary { background: #ed3343; }
  svg { width: 100%; height: calc(var(--chart-height) - 33px); overflow: visible; }
  text { fill: var(--tk-color-fg-muted); font-size: 10px; }
  .grid { stroke: var(--tk-color-border); stroke-width: 1; stroke-dasharray: 4 5; vector-effect: non-scaling-stroke; }
  .line { fill: none; stroke-width: 2.3; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .primary-line { stroke: #2876df; }
  .secondary-line { stroke: #ed3343; }
</style>
