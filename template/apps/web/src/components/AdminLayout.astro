---
import Layout from "../layouts/Layout.astro";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  active: "dashboard" | "orders" | "products" | "customers" | "reports";
  user: { name?: string | null; email: string; role?: string | null };
  orderCount?: number;
}

const { title, active, user, orderCount = 0 } = Astro.props;
const displayName = user.name?.trim() || user.email.split("@")[0] || "Admin";
const initials = displayName
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join("")
  .toUpperCase();

const nav: Array<{
  id: Props["active"];
  label: string;
  href: string;
  icon: string;
  badge?: string;
}> = [
  { id: "dashboard", label: "Dashboard", href: "/admin", icon: "dashboard" },
  {
    id: "orders",
    label: "Orders",
    href: "/admin/orders",
    icon: "orders",
    badge: String(orderCount),
  },
  { id: "products", label: "Products", href: "/admin/products", icon: "products" },
  { id: "customers", label: "Customers", href: "/admin/customers", icon: "customers" },
];
---

<Layout title={`${title} — Tokotuku`}>
  <div class="admin-shell" data-admin-shell>
    <aside class="admin-sidebar" data-sidebar>
      <div class="sidebar-top">
        <a class="admin-brand" href="/admin" aria-label="Tokotuku dashboard">
          <span class="brand-mark"><Icon name="logo" size={17} /></span>
          <span>Tokotuku</span>
        </a>
        <button class="icon-button sidebar-close" type="button" data-sidebar-close aria-label="Close menu">
          <Icon name="arrowLeft" />
        </button>
      </div>

      <p class="nav-label">Store</p>
      <nav class="admin-nav" aria-label="Store navigation">
        {nav.map((item) => (
          <a href={item.href} aria-current={active === item.id ? "page" : undefined}>
            <Icon name={item.icon} size={17} />
            <span>{item.label}</span>
            {item.badge && <span class="nav-badge">{item.badge}</span>}
          </a>
        ))}
      </nav>

      <p class="nav-label nav-label--spaced">Insights</p>
      <nav class="admin-nav" aria-label="Insights navigation">
        <a href="/admin/reports" aria-current={active === "reports" ? "page" : undefined}>
          <Icon name="reports" size={17} />
          <span>Reports</span>
          <Icon name="chevronDown" size={15} />
        </a>
      </nav>

      <p class="nav-label nav-label--spaced">Pages</p>
      <nav class="admin-nav admin-nav--muted" aria-label="Example pages">
        <a href="/login"><Icon name="lock" size={17} /><span>Authentication</span><Icon name="chevronDown" size={15} /></a>
        <a href="/not-found"><Icon name="alert" size={17} /><span>Errors</span><Icon name="chevronDown" size={15} /></a>
        <a href="/admin"><Icon name="user" size={17} /><span>Profile</span></a>
        <a href="/admin"><Icon name="file" size={17} /><span>Blank</span></a>
      </nav>

      <div class="sidebar-footer">
        <a href="/admin"><Icon name="settings" size={17} /><span>Settings</span></a>
        <button type="button" data-sign-out><Icon name="logout" size={17} /><span>Log out</span></button>
        <p>Built with <a href="https://tokotuku.dev">Tokotuku UI</a></p>
      </div>
    </aside>

    <div class="sidebar-scrim" data-sidebar-scrim></div>

    <div class="admin-workspace">
      <header class="admin-topbar">
        <button class="icon-button menu-button" type="button" data-sidebar-open aria-label="Open menu"><Icon name="menu" /></button>
        <label class="global-search">
          <Icon name="search" size={17} />
          <span class="sr-only">Search orders, products, customers</span>
          <input type="search" placeholder="Search orders, products, customers…" />
        </label>
        <div class="topbar-actions">
          <button class="icon-button notification" type="button" aria-label="Notifications"><Icon name="bell" size={17} /><span></span></button>
          <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle color theme"><Icon name="moon" size={17} /></button>
          <div class="profile-chip">
            <span class="profile-name">{displayName}</span>
            <span class="profile-avatar">{initials}</span>
            <Icon name="chevronDown" size={14} />
          </div>
        </div>
      </header>

      <main class="admin-canvas">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script>
  import { authClient } from "../lib/auth-client";

  const shell = document.querySelector("[data-admin-shell]");
  const openSidebar = () => shell?.setAttribute("data-sidebar-visible", "true");
  const closeSidebar = () => shell?.removeAttribute("data-sidebar-visible");

  document.querySelector("[data-sidebar-open]")?.addEventListener("click", openSidebar);
  document.querySelector("[data-sidebar-close]")?.addEventListener("click", closeSidebar);
  document.querySelector("[data-sidebar-scrim]")?.addEventListener("click", closeSidebar);

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("tokotuku-theme", next);
  });

  document.querySelector("[data-sign-out]")?.addEventListener("click", async () => {
    await authClient.signOut();
    location.href = "/login";
  });
</script>

<style is:global>
  :root {
    --admin-rail: #e8edf5;
    --admin-surface: #ffffff;
    --admin-soft: #f7f8fa;
    --admin-line: #e4e7eb;
    --admin-blue: #2876df;
    --admin-blue-soft: #e5f0ff;
    --admin-green: #11883a;
    --admin-green-soft: #dcf2e3;
    --admin-orange: #b85c00;
    --admin-orange-soft: #fff0d8;
    --admin-red: #dc2533;
    --admin-red-soft: #ffe1e3;
  }

  [data-theme="dark"] {
    --admin-rail: #121a28;
    --admin-surface: #171f2d;
    --admin-soft: #202a3b;
    --admin-line: #303c50;
    --admin-blue: #74aaf7;
    --admin-blue-soft: #213b61;
    --admin-green: #63d487;
    --admin-green-soft: #1d422c;
    --admin-orange: #ffbc69;
    --admin-orange-soft: #50351e;
    --admin-red: #ff818a;
    --admin-red-soft: #51262b;
  }

  *, *::before, *::after { box-sizing: border-box; }
  button, input, select { font: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }

  .admin-shell { min-height: 100vh; background: var(--admin-rail); }
  .admin-sidebar { position: fixed; inset: 0 auto 0 0; z-index: 40; display: flex; width: 264px; flex-direction: column; padding: 18px 16px 20px; overflow-y: auto; color: var(--tk-color-fg); }
  .sidebar-top { display: flex; align-items: center; justify-content: space-between; min-height: 45px; margin-bottom: 16px; padding: 0 12px; }
  .admin-brand { display: inline-flex; align-items: center; gap: 10px; color: var(--tk-color-fg); font-size: 15px; font-weight: 750; text-decoration: none; }
  .brand-mark { display: grid; width: 22px; height: 22px; place-items: center; color: #5c6675; }
  .nav-label { margin: 0 12px 7px; color: var(--tk-color-fg-muted); font-size: 12px; }
  .nav-label--spaced { margin-top: 23px; }
  .admin-nav { display: grid; gap: 2px; }
  .admin-nav a, .sidebar-footer > a, .sidebar-footer > button { display: grid; grid-template-columns: 20px minmax(0, 1fr) auto; align-items: center; min-height: 41px; gap: 11px; padding: 0 12px; border: 0; border-radius: 11px; background: transparent; color: var(--tk-color-fg); font-size: 14px; text-align: left; text-decoration: none; cursor: pointer; }
  .admin-nav a > svg, .sidebar-footer svg { color: #8a929c; }
  .admin-nav a:hover, .sidebar-footer > a:hover, .sidebar-footer > button:hover { background: color-mix(in srgb, var(--admin-surface) 70%, transparent); }
  .admin-nav a[aria-current="page"] { background: var(--admin-surface); color: var(--admin-blue); font-weight: 600; box-shadow: 0 1px 2px rgb(15 23 42 / 5%); }
  .admin-nav a[aria-current="page"] > svg { color: var(--admin-blue); }
  .nav-badge { min-width: 24px; padding: 3px 6px; border-radius: 999px; background: var(--admin-blue); color: white; font-size: 12px; line-height: 18px; text-align: center; }
  .admin-nav--muted a { color: color-mix(in srgb, var(--tk-color-fg) 86%, transparent); }
  .sidebar-footer { display: grid; gap: 2px; margin-top: auto; padding-top: 30px; }
  .sidebar-footer > button { width: 100%; }
  .sidebar-footer p { margin: 18px 0 0; padding: 14px 0 0; border-top: 1px solid color-mix(in srgb, var(--tk-color-fg) 10%, transparent); color: var(--tk-color-fg-muted); font-size: 11px; }
  .sidebar-footer p a { color: inherit; }

  .admin-workspace { min-width: 0; margin-left: 264px; }
  .admin-topbar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; height: 80px; gap: 18px; padding: 0 32px; background: color-mix(in srgb, var(--admin-rail) 92%, transparent); backdrop-filter: blur(12px); }
  .global-search { display: flex; width: min(352px, 34vw); height: 43px; align-items: center; gap: 10px; padding: 0 15px; border: 1px solid color-mix(in srgb, var(--tk-color-fg) 7%, transparent); border-radius: 999px; background: var(--admin-surface); box-shadow: 0 1px 3px rgb(15 23 42 / 7%); color: var(--tk-color-fg-muted); }
  .global-search input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--tk-color-fg); font-size: 14px; }
  .global-search input::placeholder { color: var(--tk-color-fg-muted); }
  .topbar-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  .icon-button { position: relative; display: inline-grid; width: 36px; height: 36px; place-items: center; border: 0; border-radius: 9px; background: transparent; color: var(--tk-color-fg); cursor: pointer; }
  .icon-button:hover { background: color-mix(in srgb, var(--admin-surface) 75%, transparent); }
  .notification span { position: absolute; top: 4px; right: 5px; width: 7px; height: 7px; border: 2px solid var(--admin-rail); border-radius: 50%; background: #f5a000; }
  .profile-chip { display: flex; align-items: center; gap: 9px; margin-left: 12px; font-size: 13px; font-weight: 600; }
  .profile-avatar { display: grid; width: 32px; height: 32px; place-items: center; border: 2px solid color-mix(in srgb, var(--admin-surface) 70%, transparent); border-radius: 50%; background: linear-gradient(135deg, #e9a765, #8c5535); color: white; font-size: 11px; }
  .menu-button, .sidebar-close { display: none; }
  .sidebar-scrim { display: none; }

  .admin-canvas { min-height: calc(100vh - 80px); padding: 32px; border-radius: 31px 0 0; background: var(--admin-surface); }
  .page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 25px; }
  .page-heading h1 { margin: 0; color: var(--tk-color-fg); font-size: clamp(26px, 2.4vw, 32px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.15; }
  .page-heading p { margin: 8px 0 0; color: var(--tk-color-fg-muted); font-size: 14px; }
  .page-actions { display: flex; flex-wrap: wrap; gap: 9px; }
  .admin-button { display: inline-flex; min-height: 37px; align-items: center; justify-content: center; gap: 8px; padding: 0 14px; border: 1px solid var(--admin-line); border-radius: 10px; background: var(--admin-soft); color: var(--tk-color-fg); font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer; }
  .admin-button:hover { filter: brightness(.98); }
  .admin-button--primary { border-color: #1765c8; background: linear-gradient(#4189e9, #2876df); color: white; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 20%); }
  .admin-button--ghost { border-color: transparent; background: transparent; }
  .panel { border: 1px solid var(--admin-line); border-radius: 17px; background: var(--admin-surface); }
  .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 19px 20px; }
  .panel-heading h2 { margin: 0; font-size: 16px; font-weight: 650; }
  .panel-heading p { margin: 4px 0 0; color: var(--tk-color-fg-muted); font-size: 12px; }
  .status { display: inline-flex; width: fit-content; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 999px; font-size: 12px; font-weight: 550; line-height: 1.2; white-space: nowrap; }
  .status::before { content: ""; width: 5px; height: 5px; border: 1px solid currentColor; border-radius: 50%; }
  .status--success { background: var(--admin-green-soft); color: var(--admin-green); }
  .status--warning { background: var(--admin-orange-soft); color: var(--admin-orange); }
  .status--danger { background: var(--admin-red-soft); color: var(--admin-red); }
  .status--info { background: var(--admin-blue-soft); color: var(--admin-blue); }
  .status--neutral { background: var(--admin-soft); color: var(--tk-color-fg-muted); }
  .table-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 11px 20px; border-bottom: 1px solid var(--admin-line); }
  .filter-tabs { display: flex; align-items: center; gap: 3px; padding: 3px; border: 1px solid var(--admin-line); border-radius: 12px; background: var(--admin-soft); overflow-x: auto; }
  .filter-tabs button, .filter-tabs a { min-height: 32px; padding: 0 12px; border: 0; border-radius: 9px; background: transparent; color: var(--tk-color-fg); font-size: 13px; font-weight: 550; text-decoration: none; white-space: nowrap; cursor: pointer; }
  .filter-tabs [aria-selected="true"], .filter-tabs [aria-current="page"] { background: var(--admin-surface); color: var(--admin-blue); box-shadow: 0 1px 4px rgb(15 23 42 / 8%); }
  .table-search { display: flex; width: 240px; height: 36px; align-items: center; gap: 9px; padding: 0 11px; border: 1px solid var(--admin-line); border-radius: 11px; color: var(--tk-color-fg-muted); }
  .table-search input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--tk-color-fg); font-size: 13px; }
  .table-wrap { overflow-x: auto; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .admin-table th { height: 41px; padding: 0 12px; background: var(--admin-soft); color: var(--tk-color-fg-muted); font-size: 11px; font-weight: 550; text-align: left; white-space: nowrap; }
  .admin-table td { height: 63px; padding: 8px 12px; border-top: 1px solid var(--admin-line); color: var(--tk-color-fg); white-space: nowrap; }
  .admin-table tbody tr:hover { background: color-mix(in srgb, var(--admin-blue) 2.5%, var(--admin-surface)); }
  .admin-table .money { font-weight: 650; text-align: right; }
  .admin-table .numeric { text-align: right; }
  .check { width: 15px; height: 15px; accent-color: var(--admin-blue); }
  .entity { display: flex; align-items: center; gap: 11px; }
  .entity img, .entity-avatar { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; background: var(--admin-soft); }
  .entity-avatar { display: grid; width: 33px; height: 33px; place-items: center; border-radius: 50%; color: white; font-size: 10px; font-weight: 700; }
  .entity strong, .entity span { display: block; }
  .entity strong { font-size: 13px; font-weight: 650; }
  .entity span { margin-top: 2px; color: var(--tk-color-fg-muted); font-size: 11px; }
  .row-actions { display: flex; justify-content: flex-end; gap: 7px; }
  .row-actions button { display: grid; width: 28px; height: 28px; place-items: center; border: 0; border-radius: 7px; background: transparent; color: var(--tk-color-fg); cursor: pointer; }
  .row-actions button:hover { background: var(--admin-soft); }
  .row-actions .danger { color: var(--admin-red); }
  .table-footer { display: flex; align-items: center; justify-content: space-between; min-height: 60px; padding: 10px 20px; border-top: 1px solid var(--admin-line); color: var(--tk-color-fg-muted); font-size: 12px; }
  .pagination { display: flex; align-items: center; gap: 5px; }
  .pagination a, .pagination span { display: grid; min-width: 34px; height: 34px; place-items: center; border-radius: 10px; color: var(--tk-color-fg); text-decoration: none; }
  .pagination .active { border: 1px solid color-mix(in srgb, var(--admin-blue) 20%, var(--admin-line)); background: var(--admin-blue-soft); color: var(--admin-blue); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 900px) {
    .admin-sidebar { transform: translateX(-100%); transition: transform .2s ease; background: var(--admin-rail); }
    .admin-workspace { margin-left: 0; }
    .admin-shell[data-sidebar-visible="true"] .admin-sidebar { transform: translateX(0); }
    .admin-shell[data-sidebar-visible="true"] .sidebar-scrim { position: fixed; inset: 0; z-index: 35; display: block; background: rgb(10 18 30 / 38%); backdrop-filter: blur(2px); }
    .menu-button, .sidebar-close { display: inline-grid; }
    .admin-topbar { height: 68px; padding: 0 18px; }
    .admin-canvas { min-height: calc(100vh - 68px); padding: 24px; border-radius: 24px 24px 0 0; }
  }

  @media (max-width: 640px) {
    .admin-canvas { padding: 20px 15px; }
    .global-search { width: auto; min-width: 0; flex: 1; }
    .global-search input::placeholder { color: transparent; }
    .profile-name, .topbar-actions > .notification { display: none; }
    .profile-chip { margin-left: 2px; }
    .page-heading { align-items: stretch; flex-direction: column; margin-bottom: 20px; }
    .page-actions .admin-button { flex: 1; }
    .table-toolbar { align-items: stretch; flex-direction: column; }
    .table-search { width: 100%; }
    .table-footer { align-items: flex-start; flex-direction: column; gap: 12px; }
  }
</style>
