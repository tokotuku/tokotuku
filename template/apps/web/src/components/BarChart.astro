---
interface Props {
  labels: string[];
  primary: number[];
  secondary?: number[];
  horizontal?: boolean;
}
const { labels, primary, secondary = [], horizontal = false } = Astro.props;
const max = Math.max(...primary, ...secondary, 1);
---

{horizontal ? (
  <div class="horizontal-bars">
    {labels.map((label, index) => <div class="horizontal-row"><span>{label}</span><div><i style={`width:${(primary[index] / max) * 100}%`}></i></div></div>)}
  </div>
) : (
  <div class="bar-chart" role="img" aria-label="Bar chart">
    {labels.map((label, index) => (
      <div class="bar-group">
        <div class="bars">
          <i class="primary" style={`height:${(primary[index] / max) * 100}%`}></i>
          {secondary.length > 0 && <i class="secondary" style={`height:${(secondary[index] / max) * 100}%`}></i>}
        </div>
        <span>{label}</span>
      </div>
    ))}
  </div>
)}

<style>
  .bar-chart { display: flex; height: 258px; align-items: stretch; justify-content: space-around; gap: 10px; padding: 15px 10px 0 42px; border-bottom: 1px solid var(--tk-color-border); background: repeating-linear-gradient(to bottom, transparent 0, transparent 50px, var(--tk-color-border) 51px); }
  .bar-group { display: flex; min-width: 28px; flex: 1; flex-direction: column; justify-content: flex-end; }
  .bars { display: flex; height: 222px; align-items: flex-end; justify-content: center; gap: 7px; }
  .bars i { display: block; width: min(19px, 36%); min-height: 3px; border-radius: 4px 4px 0 0; background: #2876df; }
  .bars i.secondary { background: #0881bf; }
  .bar-group > span { height: 28px; padding-top: 8px; color: var(--tk-color-fg-muted); font-size: 10px; text-align: center; }
  .horizontal-bars { display: grid; gap: 15px; padding: 18px 8px 5px; }
  .horizontal-row { display: grid; grid-template-columns: 94px 1fr; align-items: center; gap: 12px; }
  .horizontal-row span { overflow: hidden; color: var(--tk-color-fg-muted); font-size: 11px; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
  .horizontal-row div { height: 28px; background: repeating-linear-gradient(to right, var(--tk-color-border) 0 1px, transparent 1px 25%); }
  .horizontal-row i { display: block; height: 100%; border-radius: 5px; background: #2876df; }
</style>
