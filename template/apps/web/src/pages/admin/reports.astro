---
import { env } from "cloudflare:workers";
import AdminLayout from "../../components/AdminLayout.astro";
import BarChart from "../../components/BarChart.astro";
import DonutChart from "../../components/DonutChart.astro";
import Icon from "../../components/Icon.astro";
import { createAuth } from "../../lib/auth";
import { canAccessBackoffice } from "../../lib/roles";

const auth = createAuth(env, Astro.url.origin);
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) return Astro.redirect("/login?next=/admin/reports");
if (!canAccessBackoffice(session.user.role)) return Astro.redirect("/403");

const categorySales = [
  { label: "Coffee", value: 44, color: "#2876df" },
  { label: "Equipment", value: 30, color: "#0881bf" },
  { label: "Supplies", value: 16, color: "#078a32" },
  { label: "Gifts", value: 10, color: "#f39a00" },
];
const channelSales = [
  { label: "Online", value: 62, color: "#2876df" },
  { label: "Retail", value: 24, color: "#0881bf" },
  { label: "Wholesale", value: 14, color: "#078a32" },
];
---

<AdminLayout title="Reports" active="reports" user={session.user}>
  <div class="breadcrumbs"><a href="/admin">Dashboard</a><span>›</span><span>Reports</span></div>
  <header class="page-heading report-heading">
    <div><h1>Reports</h1><p>Revenue, orders, and product performance for Tokotuku.</p></div>
    <div class="page-actions"><div class="range-tabs"><button>7d</button><button class="active">30d</button><button>90d</button></div><button class="admin-button"><Icon name="download" size={16} /> Export</button></div>
  </header>

  <section class="report-stats">
    <article class="panel"><div><span>Revenue</span><i><Icon name="reports" size={18} /></i></div><strong>$48,210</strong><p><span class="status status--success">12%</span> vs last period</p></article>
    <article class="panel"><div><span>Orders</span><i><Icon name="orders" size={18} /></i></div><strong>1,284</strong><p><span class="status status--success">8%</span> vs last period</p></article>
    <article class="panel"><div><span>Avg. order value</span><i><Icon name="file" size={18} /></i></div><strong>$37.55</strong><p><span class="status status--success">3%</span> vs last period</p></article>
    <article class="panel"><div><span>Refund rate</span><i><Icon name="refresh" size={18} /></i></div><strong>2.4%</strong><p><span class="status status--danger">0.6%</span> vs last period</p></article>
  </section>

  <section class="reports-grid">
    <article class="panel revenue-panel"><div class="panel-heading"><h2>Revenue over time</h2><span class="status status--success">12%</span></div><div class="chart-keys"><span><i></i>This period</span><span><i></i>Last period</span></div><div class="report-chart"><BarChart labels={["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug"]} primary={[27,30,28,36,44,42,49,51]} secondary={[23,25,29,31,36,39,43,45]} /></div></article>
    <article class="panel donut-panel"><div class="panel-heading"><h2>Sales by category</h2></div><DonutChart items={categorySales} /></article>
    <article class="panel products-panel"><div class="panel-heading"><h2>Top products</h2></div><BarChart horizontal labels={["Gizmo Pro","Creator Kit","Widget Plus","Studio Stand","Gadget Mini"]} primary={[96,84,65,52,40]} /></article>
    <article class="panel donut-panel"><div class="panel-heading"><h2>Sales by channel</h2></div><DonutChart items={channelSales} /></article>
  </section>
</AdminLayout>

<style>
  .breadcrumbs { display: flex; gap: 9px; margin: 1px 0 25px; color: var(--tk-color-fg-muted); font-size: 12px; }.breadcrumbs a { color: inherit; text-decoration: none; }.report-heading { margin-bottom: 25px; }
  .range-tabs { display: flex; height: 37px; padding: 3px; border: 1px solid var(--admin-line); border-radius: 11px; background: var(--admin-soft); }.range-tabs button { min-width: 46px; border: 0; border-radius: 8px; background: transparent; color: var(--tk-color-fg); font-size: 12px; font-weight: 600; cursor: pointer; }.range-tabs .active { background: var(--admin-surface); color: var(--admin-blue); box-shadow: 0 1px 3px rgb(15 23 42 / 8%); }
  .report-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }.report-stats article { min-height: 132px; padding: 20px; }.report-stats article > div { display: flex; align-items: center; justify-content: space-between; color: var(--tk-color-fg-muted); font-size: 12px; }.report-stats article i { display: grid; width: 37px; height: 37px; place-items: center; border-radius: 10px; background: var(--admin-blue-soft); color: var(--admin-blue); font-style: normal; }.report-stats strong { display: block; margin-top: -4px; font-size: 26px; }.report-stats p { display: flex; align-items: center; gap: 8px; margin: 7px 0 0; color: var(--tk-color-fg-muted); font-size: 10px; }
  .reports-grid { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(290px, .9fr); gap: 18px; margin-top: 24px; }.revenue-panel { min-height: 400px; }.chart-keys { display: flex; justify-content: flex-end; gap: 16px; padding: 0 20px; color: var(--tk-color-fg-muted); font-size: 10px; }.chart-keys span { display: inline-flex; align-items: center; gap: 5px; }.chart-keys i { width: 9px; height: 9px; background: #2876df; }.chart-keys span:last-child i { background: #0881bf; }.report-chart { padding: 0 16px 17px; }.donut-panel { min-height: 400px; }.products-panel { min-height: 300px; }
  @media (max-width: 1100px) { .report-stats { grid-template-columns: repeat(2,1fr); }.reports-grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .report-stats { grid-template-columns: 1fr; }.report-heading .page-actions { flex-direction: column; }.range-tabs { width: 100%; }.range-tabs button { flex: 1; }.report-chart { padding-inline: 2px; } }
</style>
