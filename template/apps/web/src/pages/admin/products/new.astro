---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../components/AdminLayout.astro";
import ProductForm from "../../../components/ProductForm.astro";
import { createAuth } from "../../../lib/auth";
import { productInputFromForm } from "../../../lib/product-form";
import { createProduct } from "../../../lib/products";
import { canAccessBackoffice } from "../../../lib/roles";

const auth = createAuth(env, Astro.url.origin);
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) return Astro.redirect("/login?next=/admin/products/new");
if (!canAccessBackoffice(session.user.role)) return Astro.redirect("/403");

let error = "";
if (Astro.request.method === "POST") {
  try {
    const input = await productInputFromForm(await Astro.request.formData(), env.PRODUCT_IMAGES);
    return Astro.redirect(`/admin/products/${await createProduct(env.DB, input)}/edit?saved=1`);
  } catch (caught) {
    error = caught instanceof Error ? caught.message : "Produk gagal disimpan.";
  }
}
---

<AdminLayout title="Add product" active="products" user={session.user}>
  <header class="page-heading"><div><h1>Add product</h1><p>Buat produk, atur stok, dan tambahkan field yang dibutuhkan.</p></div></header>
  <ProductForm error={error} />
</AdminLayout>
