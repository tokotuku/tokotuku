---
import { env } from "cloudflare:workers";
import AdminLayout from "../../components/AdminLayout.astro";
import Icon from "../../components/Icon.astro";
import { createAuth } from "../../lib/auth";
import { listProducts } from "../../lib/products";
import { canAccessBackoffice } from "../../lib/roles";

const auth = createAuth(env, Astro.url.origin);
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) return Astro.redirect("/login?next=/admin/products");
if (!canAccessBackoffice(session.user.role)) return Astro.redirect("/403");

const products = await listProducts(env.DB, { activeOnly: false });
const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
const categories = [...new Set(products.map((product) => product.category))];
const statusFor = (stock: number, active: boolean) =>
  !active ? "Inactive" : stock === 0 ? "Out of stock" : stock < 10 ? "Low stock" : "In stock";
---

<AdminLayout title="Products" active="products" user={session.user}>
  <header class="page-heading">
    <div><h1>Products</h1><p>Your catalog of {products.length} products across {categories.length} categories.</p></div>
    <div class="page-actions"><a class="admin-button admin-button--primary" href="/admin/products/new"><Icon name="plus" size={16} /> Add product</a></div>
  </header>

  <section class="panel data-panel" data-product-table>
    <div class="table-toolbar">
      <div class="filter-tabs" role="tablist" aria-label="Product category"><button type="button" aria-selected="true" data-filter="All">All</button>{categories.map((category) => <button type="button" aria-selected="false" data-filter={category}>{category}</button>)}</div>
      <label class="table-search"><Icon name="search" size={16} /><span class="sr-only">Search products</span><input type="search" placeholder="Search products…" data-table-search /></label>
    </div>
    <div class="table-wrap">
      <table class="admin-table">
        <thead><tr><th><input class="check" type="checkbox" aria-label="Select all products" /></th><th>Product ↕</th><th>Category ↕</th><th class="numeric">Price ↕</th><th class="numeric">Stock ↕</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
          {products.map((product) => (
            <tr data-row data-category={product.category} data-search={`${product.name} ${product.description} ${product.category}`.toLowerCase()}>
              <td><input class="check" type="checkbox" aria-label={`Select ${product.name}`} /></td>
              <td><div class="entity"><img src={`/api/images/${product.imageKey}`} alt="" /><div><strong>{product.name}</strong><span>SKU {product.sku}</span></div></div></td>
              <td>{product.category}</td><td class="money">{currency.format(product.priceCents / 100)}</td><td class="numeric">{product.stock}</td><td><span class:list={["status", statusFor(product.stock, product.isActive) === "In stock" ? "status--success" : statusFor(product.stock, product.isActive) === "Low stock" ? "status--warning" : "status--danger"]}>{statusFor(product.stock, product.isActive)}</span></td>
              <td><div class="row-actions"><a aria-label={`Edit ${product.name}`} href={`/admin/products/${product.id}/edit`}><Icon name="edit" size={16} /></a></div></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="table-footer"><span data-result-count>{products.length ? `Showing 1–${products.length} of ${products.length}` : "No products yet"}</span><nav class="pagination" aria-label="Product pages"><span>‹</span><span class="active">1</span><span>›</span></nav></div>
  </section>
</AdminLayout>

<script>
  const container = document.querySelector("[data-product-table]");
  const rows = Array.from(container?.querySelectorAll<HTMLElement>("[data-row]") ?? []);
  const count = container?.querySelector("[data-result-count]");
  let filter = "All";
  let query = "";
  const update = () => { let visible = 0; for (const row of rows) { const match = (filter === "All" || row.dataset.category === filter) && (row.dataset.search?.includes(query) ?? false); row.hidden = !match; if (match) visible += 1; } if (count) count.textContent = visible ? `Showing 1–${visible} of ${visible}` : "No matching products"; };
  for (const button of container?.querySelectorAll<HTMLButtonElement>("[data-filter]") ?? []) button.addEventListener("click", () => { filter = button.dataset.filter ?? "All"; container?.querySelectorAll("[data-filter]").forEach((item) => item.setAttribute("aria-selected", String(item === button))); update(); });
  container?.querySelector<HTMLInputElement>("[data-table-search]")?.addEventListener("input", (event) => { query = (event.currentTarget as HTMLInputElement).value.trim().toLowerCase(); update(); });
</script>

<style>
  .data-panel { overflow: hidden; }.admin-table th:first-child,.admin-table td:first-child { width: 48px; padding-left: 20px; }.admin-table th:last-child,.admin-table td:last-child { padding-right: 20px; }.admin-table tr[hidden] { display: none; }.row-actions a{display:grid;width:28px;height:28px;place-items:center;border-radius:7px;color:var(--tk-color-fg);text-decoration:none}
</style>
