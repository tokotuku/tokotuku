---
import { env } from "cloudflare:workers";
import StoreHeader from "@tokotuku-starter/ui/StoreHeader.astro";
import Layout from "../layouts/Layout.astro";
import { createAuth } from "../lib/auth";
import {
  type CartLineInput,
  createOrder,
  findCustomerOrder,
  type PaymentMethod,
  paymentMethods,
} from "../lib/orders";
import { listProducts } from "../lib/products";

const bankAccount = { bank: "BCA", accountNumber: "1234567890", accountName: "Tokotuku" };

const auth = createAuth(env, Astro.url.origin);
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) return Astro.redirect("/login?next=/checkout");

const products = await listProducts(env.DB);
const productData = Object.fromEntries(
  products.map((product) => [
    product.id,
    { name: product.name, priceCents: product.priceCents, stock: product.stock },
  ]),
);
const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
let error = "";

if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const required = (name: string, label: string) => {
      const value = String(form.get(name) ?? "").trim();
      if (!value) throw new Error(`${label} wajib diisi.`);
      return value;
    };
    let cart: CartLineInput[] = [];
    try {
      cart = JSON.parse(String(form.get("cart") ?? "[]"));
    } catch {
      throw new Error("Data keranjang tidak valid.");
    }
    if (!Array.isArray(cart)) throw new Error("Data keranjang tidak valid.");
    const paymentMethod = String(form.get("paymentMethod") ?? "cash") as PaymentMethod;
    if (!paymentMethods.includes(paymentMethod)) throw new Error("Metode pembayaran tidak valid.");
    return Astro.redirect(
      `/checkout?order=${encodeURIComponent(
        (
          await createOrder(
            env.DB,
            session.user.id,
            {
              customerName: required("customerName", "Nama lengkap"),
              customerEmail: session.user.email,
              customerPhone: required("customerPhone", "Nomor telepon"),
              address: required("address", "Alamat"),
              city: required("city", "Kota"),
              postalCode: required("postalCode", "Kode pos"),
              note: String(form.get("note") ?? "").trim(),
            },
            cart,
            paymentMethod,
          )
        ).orderNumber,
      )}`,
    );
  } catch (caught) {
    error = caught instanceof Error ? caught.message : "Checkout gagal diproses.";
  }
}

const requestedOrder = Astro.url.searchParams.get("order");
const completedOrder = requestedOrder
  ? await findCustomerOrder(env.DB, requestedOrder, session.user.id)
  : null;
const proofError = Astro.url.searchParams.get("proofError");
---

<Layout title="Checkout — Tokotuku">
  <StoreHeader />
  <main>
    {completedOrder ? (
      <section class="success-card">
        <span class="success-icon">✓</span><p class="eyebrow">Order berhasil dibuat</p><h1>Terima kasih.</h1>
        <p>Order <strong>#{completedOrder.orderNumber}</strong> sudah kami terima.</p>
        {completedOrder.paymentMethod === "cash" ? (
          <div class="cash-note"><strong>Bayar tunai saat pesanan tiba</strong><span>Siapkan uang sebesar {currency.format(completedOrder.totalCents / 100)}. Status pembayaran saat ini: belum dibayar.</span></div>
        ) : completedOrder.paymentStatus === "paid" ? (
          <div class="cash-note"><strong>Pembayaran terverifikasi</strong><span>Terima kasih, transfer kamu sudah kami konfirmasi.</span></div>
        ) : completedOrder.paymentProofKey ? (
          <div class="cash-note"><strong>Bukti transfer terkirim</strong><span>Menunggu verifikasi dari admin/CS kami, biasanya diproses dalam 1x24 jam.</span></div>
        ) : (
          <div class="cash-note">
            <strong>Transfer ke rekening berikut</strong>
            <span>{bankAccount.bank} {bankAccount.accountNumber} a.n. {bankAccount.accountName} — total {currency.format(completedOrder.totalCents / 100)}</span>
            {proofError && <p class="checkout-error" role="alert">{proofError}</p>}
            <form method="post" action="/api/orders/proof" enctype="multipart/form-data" class="proof-form">
              <input type="hidden" name="orderNumber" value={completedOrder.orderNumber} />
              <label>Unggah bukti transfer<input type="file" name="proof" accept="image/*,application/pdf" required /></label>
              <button type="submit">Kirim bukti transfer</button>
            </form>
          </div>
        )}
        <a class="primary-link" href="/products">Lanjut belanja</a>
      </section>
    ) : (
      <>
        <p class="eyebrow">Cash on Delivery</p><h1>Checkout.</h1>
        {error && <p class="checkout-error" role="alert">{error}</p>}
        <form method="post" data-checkout-form>
          <input type="hidden" name="cart" data-cart-payload />
          <div class="checkout-grid">
            <section>
              <h2>Kontak</h2>
              <div class="fields"><label>Email<input type="email" value={session.user.email} readonly /></label><label>Nomor telepon<input name="customerPhone" type="tel" required autocomplete="tel" /></label></div>
              <h2>Alamat pengiriman</h2>
              <div class="fields">
                <label>Nama lengkap<input name="customerName" required value={session.user.name} autocomplete="name" /></label>
                <label>Kota<input name="city" required autocomplete="address-level2" /></label>
                <label class="wide">Alamat lengkap<textarea name="address" required rows="3" autocomplete="street-address"></textarea></label>
                <label>Kode pos<input name="postalCode" required autocomplete="postal-code" /></label>
                <label>Catatan<input name="note" placeholder="Opsional" /></label>
              </div>
            </section>
            <aside>
              <h2>Ringkasan pesanan</h2><div class="order-lines" data-order-lines></div>
              <div class="total"><span>Total</span><strong data-order-total>$0.00</strong></div>
              <fieldset class="payment-methods">
                <legend>Metode pembayaran</legend>
                <label class="payment-option"><input type="radio" name="paymentMethod" value="cash" checked />💵 Bayar tunai <span>Dibayar ke kurir saat pesanan tiba.</span></label>
                <label class="payment-option"><input type="radio" name="paymentMethod" value="transfer" />🏦 Transfer bank <span>Transfer manual, diverifikasi admin/CS.</span></label>
              </fieldset>
              <button type="submit" data-place-order disabled>Buat pesanan</button>
              <a href="/cart">← Kembali ke keranjang</a>
            </aside>
          </div>
        </form>
      </>
    )}
  </main>
</Layout>

{completedOrder && <script is:inline>localStorage.removeItem("tokotuku-cart"); window.dispatchEvent(new Event("tokotuku:cart-changed"));</script>}
{!completedOrder && <script is:inline define:vars={{ productData }}>
  const cartKey = "tokotuku-cart";
  let cart = [];
  try { cart = JSON.parse(localStorage.getItem(cartKey) ?? "[]"); } catch { cart = []; }
  cart = cart.filter((item) => productData[item.id] && Number(item.quantity) > 0).map((item) => ({ id: Number(item.id), quantity: Math.min(99, Math.max(1, Math.trunc(Number(item.quantity)))) }));
  const payload = document.querySelector("[data-cart-payload]");
  const lines = document.querySelector("[data-order-lines]");
  const total = document.querySelector("[data-order-total]");
  const button = document.querySelector("[data-place-order]");
  const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
  payload.value = JSON.stringify(cart);
  let totalCents = 0;
  for (const item of cart) {
    const product = productData[item.id];
    totalCents += product.priceCents * item.quantity;
    const row = document.createElement("div"); row.className = "order-line";
    const name = document.createElement("span"); name.textContent = `${product.name} × ${item.quantity}`;
    const price = document.createElement("strong"); price.textContent = currency.format(product.priceCents * item.quantity / 100);
    row.append(name, price); lines.append(row);
  }
  if (!cart.length) { lines.textContent = "Keranjang kosong."; }
  total.textContent = currency.format(totalCents / 100); button.disabled = cart.length === 0;
</script>}

<style>
  main { width:min(100% - calc(var(--tk-spacing-4) * 2),68rem);margin-inline:auto;padding-block:var(--tk-spacing-10) var(--tk-spacing-12) }.eyebrow{margin:0;color:var(--tk-color-accent);font-size:var(--tk-font-size-xs);font-weight:var(--tk-font-weight-bold);letter-spacing:.1em;text-transform:uppercase}h1{margin:var(--tk-spacing-2) 0 var(--tk-spacing-8);font-size:clamp(2.5rem,6vw,5rem);letter-spacing:-.05em}.checkout-grid{display:grid;grid-template-columns:minmax(0,1fr) 22rem;gap:var(--tk-spacing-8);align-items:start}.checkout-grid section,.checkout-grid aside,.success-card{padding:var(--tk-spacing-6);border:1px solid var(--tk-color-border);border-radius:var(--tk-radius-xl)}section h2:first-child,aside h2{margin-top:0}section h2:not(:first-child){margin-top:var(--tk-spacing-7)}label{display:grid;gap:var(--tk-spacing-2);color:var(--tk-color-fg-muted);font-size:var(--tk-font-size-sm)}input,textarea{box-sizing:border-box;width:100%;min-height:2.75rem;padding:var(--tk-spacing-3);border:1px solid var(--tk-color-border);border-radius:var(--tk-radius-md);background:var(--tk-color-bg);color:var(--tk-color-fg);font:inherit}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--tk-spacing-4)}.wide{grid-column:1/-1}aside{background:var(--tk-color-bg-subtle)}.order-lines{display:grid;gap:10px}.order-lines :global(.order-line){display:flex;justify-content:space-between;gap:12px;font-size:var(--tk-font-size-sm)}.total{display:flex;justify-content:space-between;margin-top:18px;padding:16px 0;border-block:1px solid var(--tk-color-border)}.payment,.cash-note{display:grid;gap:5px;margin:16px 0;padding:13px;border-radius:10px;background:color-mix(in srgb,var(--tk-color-accent) 9%,var(--tk-color-bg))}.payment span,.cash-note span{color:var(--tk-color-fg-muted);font-size:var(--tk-font-size-xs);line-height:1.5}button,.primary-link{display:flex;width:100%;min-height:2.9rem;box-sizing:border-box;align-items:center;justify-content:center;border:0;border-radius:var(--tk-radius-md);background:var(--tk-color-accent);color:var(--tk-color-accent-fg);font:inherit;font-weight:var(--tk-font-weight-semibold);text-decoration:none;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}aside>a{display:block;margin-top:var(--tk-spacing-4);color:var(--tk-color-accent);font-size:var(--tk-font-size-sm)}.checkout-error{padding:12px 14px;border-radius:10px;background:color-mix(in srgb,var(--tk-color-danger) 9%,var(--tk-color-bg));color:var(--tk-color-danger)}.success-card{max-width:38rem;margin:auto;text-align:center}.success-card h1{margin-bottom:20px}.success-icon{display:grid;width:60px;height:60px;margin:0 auto 20px;place-items:center;border-radius:50%;background:#def4e6;color:#087b34;font-size:28px}.success-card .cash-note{text-align:left;margin:25px 0}.primary-link{width:fit-content;margin:auto;padding-inline:22px}@media(max-width:48rem){.checkout-grid,.fields{grid-template-columns:1fr}.wide{grid-column:auto}}
  .payment-methods { display: grid; gap: var(--tk-spacing-2); margin: 16px 0; padding: 0; border: 0; }
  .payment-methods legend { padding: 0 0 8px; color: var(--tk-color-fg); font-size: var(--tk-font-size-sm); font-weight: var(--tk-font-weight-semibold); }
  .payment-option { display: flex; flex-direction: row; align-items: center; gap: 8px; padding: 12px; border: 1px solid var(--tk-color-border); border-radius: var(--tk-radius-md); font-size: var(--tk-font-size-sm); color: var(--tk-color-fg); cursor: pointer; }
  .payment-option input { width: auto; min-height: auto; }
  .payment-option span { color: var(--tk-color-fg-muted); font-size: var(--tk-font-size-xs); }
  .proof-form { display: grid; gap: 10px; margin-top: 8px; }
  .proof-form input[type="file"] { padding: 8px; }
  .proof-form button { min-height: 2.5rem; }
</style>
