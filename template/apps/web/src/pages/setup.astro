---
import { env } from "cloudflare:workers";
import AuthFrame from "../components/AuthFrame.astro";
import Icon from "../components/Icon.astro";
import { createAuth } from "../lib/auth";
import { claimSetup, completeSetup, isSetupComplete, releaseSetupClaim } from "../lib/setup";

let errorMessage = "";
let values = { name: "", email: "" };

if (await isSetupComplete(env.DB)) return Astro.redirect("/login", 302);

if (Astro.request.method === "POST") {
  const origin = Astro.request.headers.get("origin");
  if (origin !== Astro.url.origin) {
    errorMessage = "The setup request did not come from this site.";
  } else {
    const form = await Astro.request.formData();
    const name = String(form.get("name") ?? "").trim();
    const email = String(form.get("email") ?? "")
      .trim()
      .toLowerCase();
    const password = String(form.get("password") ?? "");
    const confirmPassword = String(form.get("confirmPassword") ?? "");
    values = { name, email };

    if (name.length < 2) errorMessage = "Enter the administrator's full name.";
    else if (!email?.includes("@")) errorMessage = "Enter a valid email address.";
    else if (password.length < 8) errorMessage = "Password must contain at least 8 characters.";
    else if (password !== confirmPassword) errorMessage = "Passwords do not match.";
    else if (await isSetupComplete(env.DB)) return Astro.redirect("/login", 302);
    else if (!(await claimSetup(env.DB))) {
      errorMessage = "Setup is already running in another window. Try again in a moment.";
    } else {
      let createdUserId: string | undefined;
      try {
        const auth = createAuth(env, Astro.url.origin);
        const result = await auth.api.signUpEmail({ body: { name, email, password } });
        createdUserId = result.user.id;
        await completeSetup(env.DB, createdUserId);
        return Astro.redirect("/login?setup=complete", 303);
      } catch (error) {
        await releaseSetupClaim(env.DB, createdUserId);
        errorMessage =
          error instanceof Error && error.message
            ? error.message
            : "Could not create the administrator account.";
      }
    }
  }
}
---

<AuthFrame title="Set up your store">
  <form class="auth-card setup-card" method="post" action="/setup" novalidate>
    <span class="setup-step">One-time setup</span>
    <h1>Create the store administrator</h1>
    <p>This account gets full back-office access. Setup closes permanently when it is created.</p>

    <div class="field">
      <label for="name">Full name</label>
      <div class="input-wrap">
        <Icon name="user" size={16} />
        <input id="name" name="name" autocomplete="name" value={values.name} required />
      </div>
    </div>
    <div class="field">
      <label for="email">Email</label>
      <div class="input-wrap">
        <Icon name="mail" size={16} />
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          value={values.email}
          required
        />
      </div>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <div class="input-wrap">
        <Icon name="lock" size={16} />
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
        <button class="password-toggle" type="button" data-password-toggle aria-label="Show password">
          <Icon name="eye" size={16} />
        </button>
      </div>
    </div>
    <div class="field">
      <label for="confirm-password">Confirm password</label>
      <div class="input-wrap">
        <Icon name="lock" size={16} />
        <input
          id="confirm-password"
          name="confirmPassword"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </div>
    </div>

    {errorMessage && <p class="auth-message" role="alert">{errorMessage}</p>}
    <button class="auth-submit" type="submit">
      Create administrator <Icon name="arrowRight" size={16} />
    </button>
    <p class="setup-note"><Icon name="lock" size={13} /> This page cannot create another admin later.</p>
  </form>
</AuthFrame>

<script>
  const password = document.querySelector<HTMLInputElement>("#password");
  const confirmation = document.querySelector<HTMLInputElement>("#confirm-password");
  document.querySelector("[data-password-toggle]")?.addEventListener("click", () => {
    const nextType = password?.type === "password" ? "text" : "password";
    if (password) password.type = nextType;
    if (confirmation) confirmation.type = nextType;
  });
</script>

<style>
  .setup-card { width: min(100%, 410px); }
  .setup-step { display: inline-flex; margin-bottom: 14px; padding: 6px 9px; border-radius: 999px; background: color-mix(in srgb, var(--tk-color-accent) 11%, var(--tk-color-bg)); color: var(--tk-color-accent); font-size: 10px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .setup-card .auth-submit { margin-top: 20px; }
  .setup-note { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 14px 0 0 !important; font-size: 10px !important; }
</style>
