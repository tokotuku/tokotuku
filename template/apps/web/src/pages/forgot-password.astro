---
import AuthFrame from "../components/AuthFrame.astro";
import Icon from "../components/Icon.astro";
---

<AuthFrame title="Reset password">
  <form class="auth-card" id="forgot-form" novalidate>
    <h1>Reset password</h1>
    <p>Enter your email and we'll send a reset link.</p>
    <div class="field"><label for="email">Email</label><div class="input-wrap"><Icon name="mail" size={16}/><input id="email" name="email" type="email" autocomplete="email" placeholder="you@tokotuku.com" required /></div></div>
    <p class="auth-message success" id="forgot-success" hidden></p>
    <button class="auth-submit reset-submit" type="submit">Send reset link <Icon name="arrowRight" size={16}/></button>
    <a class="auth-back" href="/login"><Icon name="arrowLeft" size={16}/> Back to sign in</a>
  </form>
</AuthFrame>

<script>
  const form = document.querySelector<HTMLFormElement>("#forgot-form");
  const message = form?.querySelector<HTMLElement>("#forgot-success");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if (message) { message.textContent = "If an account exists for that email, a reset link will be sent shortly."; message.removeAttribute("hidden"); }
  });
</script>

<style>.reset-submit { margin-top: 16px; }.auth-back { justify-content:center; }</style>
