---
interface Props {
  tone?: "info" | "success" | "warning" | "danger";
  title?: string;
}

const { tone = "info", title } = Astro.props;
const toneClass = {
  info: "alert--info",
  success: "alert--success",
  warning: "alert--warning",
  danger: "alert--danger",
}[tone];

import "./Alert.css";
---

<div class:list={["alert", toneClass]} role={tone === "danger" ? "alert" : "status"}>
  <div>
    {title && <p class="title">{title}</p>}
    <div class="body"><slot /></div>
  </div>
</div>
