---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<div class="empty-state">
  <div class="icon" aria-hidden="true"><slot name="icon">·</slot></div>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
  <div class="actions"><slot name="actions" /></div>
</div>

<style>
  .empty-state {
    display: grid;
    justify-items: center;
    padding: var(--tk-spacing-8);
    border: 1px dashed var(--tk-color-border);
    border-radius: var(--tk-radius-xl);
    background: var(--tk-color-bg);
    text-align: center;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--tk-spacing-3);
    border-radius: var(--tk-radius-full);
    background: var(--tk-color-bg-subtle);
    color: var(--tk-color-accent);
    font-size: var(--tk-font-size-xl);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-lg);
  }

  p {
    max-width: 30rem;
    margin-top: var(--tk-spacing-2);
    color: var(--tk-color-fg-muted);
    line-height: var(--tk-line-height-relaxed);
  }

  .actions {
    display: flex;
    gap: var(--tk-spacing-2);
    margin-top: var(--tk-spacing-4);
  }
</style>
