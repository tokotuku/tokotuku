---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

import "./EmptyState.css";
---

<div class="empty-state">
  <div class="icon" aria-hidden="true"><slot name="icon">·</slot></div>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
  <div class="actions"><slot name="actions" /></div>
</div>
