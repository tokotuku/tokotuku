---
export interface DataTableColumn {
  key: string;
  label: string;
  align?: "start" | "center" | "end";
}

interface Props {
  caption: string;
  columns: DataTableColumn[];
  rows: Record<string, string | number | null | undefined>[];
  emptyMessage?: string;
}

const { caption, columns, rows, emptyMessage = "No data available." } = Astro.props;
---

<div class="table-frame">
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        {columns.map((column) => <th class={`align-${column.align ?? "start"}`}>{column.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.length > 0 ? (
          rows.map((row) => (
            <tr>
              {columns.map((column) => (
                <td class={`align-${column.align ?? "start"}`}>{row[column.key] ?? "—"}</td>
              ))}
            </tr>
          ))
        ) : (
          <tr>
            <td class="empty" colspan={columns.length}>{emptyMessage}</td>
          </tr>
        )
      }
    </tbody>
  </table>
</div>

<style>
  .table-frame {
    overflow-x: auto;
    border: 1px solid var(--tk-color-border);
    border-radius: var(--tk-radius-xl);
    background: var(--tk-color-bg);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-sm);
  }

  th,
  td {
    padding: var(--tk-spacing-3) var(--tk-spacing-4);
    border-bottom: 1px solid var(--tk-color-border);
    white-space: nowrap;
  }

  th {
    background: var(--tk-color-bg-subtle);
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-xs);
    font-weight: var(--tk-font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody tr:hover {
    background: color-mix(in srgb, var(--tk-color-accent) 4%, var(--tk-color-bg));
  }

  .align-start {
    text-align: left;
  }

  .align-center {
    text-align: center;
  }

  .align-end {
    text-align: right;
  }

  .empty {
    padding: var(--tk-spacing-8);
    color: var(--tk-color-fg-muted);
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
