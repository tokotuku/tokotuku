---
export interface DataTableColumn {
  key: string;
  label: string;
  align?: "start" | "center" | "end";
}

interface Props {
  caption: string;
  columns: DataTableColumn[];
  rows: Record<string, string | number | null | undefined>[];
  emptyMessage?: string;
}

const { caption, columns, rows, emptyMessage = "No data available." } = Astro.props;
const alignClass = {
  start: "align-start",
  center: "align-center",
  end: "align-end",
};

import "./DataTable.css";
---

<div class="table-frame">
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        {columns.map((column) => <th class={alignClass[column.align ?? "start"]}>{column.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.length > 0 && rows.map((row) => (
        <tr>
          {columns.map((column) => (
            <td class={alignClass[column.align ?? "start"]}>{row[column.key] ?? "—"}</td>
          ))}
        </tr>
      ))}
      {rows.length === 0 && (
        <tr>
          <td class="empty" colspan={columns.length}>{emptyMessage}</td>
        </tr>
      )}
    </tbody>
  </table>
</div>
