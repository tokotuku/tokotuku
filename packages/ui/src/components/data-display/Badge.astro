---
interface Props {
  tone?: "neutral" | "accent" | "success" | "warning" | "danger";
}

const { tone = "neutral" } = Astro.props;
const toneClass = {
  neutral: "badge--neutral",
  accent: "badge--accent",
  success: "badge--success",
  warning: "badge--warning",
  danger: "badge--danger",
}[tone];

import "./Badge.css";
---

<span class:list={["badge", toneClass]}><slot /></span>
