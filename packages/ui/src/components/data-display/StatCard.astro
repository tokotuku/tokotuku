---
interface Props {
  label: string;
  value: string;
  change?: string;
  trend?: "up" | "down" | "neutral";
  hint?: string;
}

const { label, value, change, trend = "neutral", hint } = Astro.props;
const trendClass = {
  up: "change--up",
  down: "change--down",
  neutral: "change--neutral",
}[trend];

import "./StatCard.css";
---

<article class="stat-card">
  <div class="heading">
    <p class="label">{label}</p>
    <slot name="icon" />
  </div>
  <p class="value">{value}</p>
  {(change || hint) && (
    <div class="meta">
      {change && <span class:list={["change", trendClass]}>{change}</span>}
      {hint && <span class="hint">{hint}</span>}
    </div>
  )}
</article>
