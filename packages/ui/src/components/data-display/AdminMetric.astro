---
interface Props {
  label: string;
  value: string;
  hint?: string;
  tone?: "default" | "positive" | "warning";
}

const { label, value, hint, tone = "default" } = Astro.props;
---

<div class:list={["admin-metric", tone !== "default" && `admin-metric--${tone}`]}>
  <p>{label}</p>
  <strong>{value}</strong>
  {hint && <span>{hint}</span>}
</div>
