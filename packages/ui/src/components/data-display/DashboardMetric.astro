---
interface Props {
  label: string;
  value: string;
  hint?: string;
  tone?: "default" | "positive" | "warning";
}
const { label, value, hint, tone = "default" } = Astro.props;
const toneClass = {
  default: "",
  positive: "dashboard-metric--positive",
  warning: "dashboard-metric--warning",
}[tone];

import "./DashboardMetric.css";
---
<article class:list={["dashboard-metric", toneClass]}>
  <p>{label}</p>
  <strong>{value}</strong>
  {hint && <span>{hint}</span>}
</article>
