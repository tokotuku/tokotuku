---
interface Props {
  page: number;
  totalPages: number;
  baseUrl?: string;
}

const { page, totalPages, baseUrl = "?page=" } = Astro.props;
const previous = page > 1 ? `${baseUrl}${page - 1}` : undefined;
const next = page < totalPages ? `${baseUrl}${page + 1}` : undefined;

import "./Pagination.css";
---

<nav class="pagination" aria-label="Pagination">
  <a href={previous} aria-disabled={!previous}>Previous</a>
  <span>Page {page} of {totalPages}</span>
  <a href={next} aria-disabled={!next}>Next</a>
</nav>
