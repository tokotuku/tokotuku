---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultHero from "../../assets/hero-still-life.webp";

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryHref?: string | undefined;
  primaryLabel?: string | undefined;
  image?: string | ImageMetadata | undefined;
  imagePosition?: string | undefined;
}

const {
  eyebrow = "Takontuku · objects for everyday rituals",
  title,
  description,
  primaryHref,
  primaryLabel = "Jelajahi koleksi",
  image = defaultHero,
  imagePosition = "center",
} = Astro.props;
const imageSrc = image;
const safeImagePosition = /^[a-z0-9% .,-]+$/i.test(imagePosition) ? imagePosition : "center";

import "./StorefrontHero.css";
---

<section class="storefront-hero" data-storefront-hero>
  <div class="hero-copy">
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <span class="hero-rule" aria-hidden="true"></span>
    <p class="hero-description">{description}</p>
    {primaryHref && <a class="hero-cta" href={primaryHref}>{primaryLabel}<span aria-hidden="true">↗</span></a>}
  </div>
  <div class="hero-media">
    {typeof imageSrc === "string" ? (
      <img src={imageSrc} alt="" style={`object-position:${safeImagePosition}`} fetchpriority="high" />
    ) : (
      <Image src={imageSrc} alt="" style={`object-position:${safeImagePosition}`} widths={[640, 960, 1400]} sizes="(max-width: 720px) 100vw, 55vw" loading="eager" />
    )}
  </div>
</section>
