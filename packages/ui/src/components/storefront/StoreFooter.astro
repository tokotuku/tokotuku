---
interface FooterLink {
  label: string;
  href: string;
}
interface Props {
  brandName: string;
  tagline?: string;
  links?: FooterLink[] | undefined;
  newsletterAction?: string | undefined;
  newsletterLabel?: string | undefined;
  newsletterHint?: string | undefined;
  newsletterEmailLabel?: string | undefined;
  newsletterSubmit?: string | undefined;
  navigationLabel?: string | undefined;
  madeWith?: string | undefined;
  copyright?: string | undefined;
}

const {
  brandName,
  tagline = "Objects for everyday rituals.",
  links = [],
  newsletterAction,
  newsletterLabel = "Stay in the loop",
  newsletterHint = "Cerita baru dan koleksi pilihan, sesekali.",
  newsletterEmailLabel = "Email address",
  newsletterSubmit = "Subscribe",
  navigationLabel = "Footer navigation",
  madeWith = "Made with intention.",
  copyright = `© ${new Date().getFullYear()} ${brandName}.`,
} = Astro.props;
---

{newsletterAction && (
  <section class="footer-newsletter" aria-labelledby="newsletter-title">
    <div><p id="newsletter-title" class="newsletter-title">{newsletterLabel}</p><p>{newsletterHint}</p></div>
    <form action={newsletterAction} method="post"><label class="sr-only" for="footer-email">{newsletterEmailLabel}</label><input id="footer-email" type="email" name="email" placeholder={newsletterEmailLabel} required /><button type="submit">{newsletterSubmit}</button></form>
  </section>
)}
<footer class="store-footer">
  <div class="footer-brand"><a href="/" class="wordmark">{brandName}</a><p>{tagline}</p></div>
  {links.length > 0 && <nav aria-label={navigationLabel}>{links.map((link) => <a href={link.href}>{link.label}</a>)}</nav>}
  <div class="footer-bottom"><span>{copyright}</span><span>{madeWith}</span></div>
</footer>

<style>
  .footer-newsletter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2.5rem, 5vw, 4rem) max(1.5rem, calc((100% - 84rem) / 2));
    border-block: 1px solid var(--tk-color-border);
    background: color-mix(in srgb, var(--tk-color-bg-subtle) 52%, var(--tk-color-bg));
  }
  .newsletter-title,
  .footer-newsletter p {
    margin: 0;
  }
  .newsletter-title {
    font-family: var(--tk-font-family-display);
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.15;
  }
  .footer-newsletter p + p {
    margin-top: 0.5rem;
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-sm);
    line-height: var(--tk-line-height-relaxed);
  }
  form {
    display: flex;
    width: min(100%, 25rem);
    gap: 0.5rem;
  }
  input {
    min-width: 0;
    flex: 1;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--tk-color-border);
    border-radius: var(--tk-radius-sm);
    background: var(--tk-color-surface);
    color: var(--tk-color-fg);
  }
  button {
    min-height: 3rem;
    padding-inline: 1.1rem;
    border: 0;
    border-radius: var(--tk-radius-sm);
    background: var(--tk-color-accent);
    color: var(--tk-color-accent-fg);
    font-size: var(--tk-font-size-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .store-footer {
    display: grid;
    grid-template-columns: minmax(14rem, 1.2fr) minmax(0, 2fr);
    gap: clamp(2rem, 4vw, 4rem);
    max-width: 84rem;
    margin: auto;
    padding: clamp(4rem, 8vw, 6rem) max(1.5rem, 4vw) 2rem;
  }
  .wordmark {
    max-width: 100%;
    font-family: var(--tk-font-family-display);
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .footer-brand p {
    max-width: 28rem;
    margin: 0.9rem 0 0;
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-base);
    line-height: var(--tk-line-height-relaxed);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    justify-content: flex-end;
    gap: 1rem 1.75rem;
  }
  nav a {
    min-height: 2.5rem;
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-sm);
    line-height: 1.5;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--tk-color-fg);
  }
  .footer-bottom {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--tk-color-border);
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-xs);
    line-height: var(--tk-line-height-normal);
  }
  @media (max-width: 650px) {
    .footer-newsletter {
      display: block;
      padding-block: 2.5rem;
    }
    .footer-newsletter form {
      width: 100%;
      margin-top: 1.25rem;
    }
    .store-footer {
      grid-template-columns: 1fr;
      gap: 2.75rem;
      padding: 3.5rem 1.5rem 1.75rem;
    }
    .store-footer nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: stretch;
      gap: 0.5rem 1.25rem;
    }
    .store-footer nav a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      font-size: var(--tk-font-size-base);
    }
    .footer-bottom {
      display: grid;
      gap: 0.45rem;
      margin-top: 0;
      font-size: var(--tk-font-size-sm);
    }
  }
</style>
