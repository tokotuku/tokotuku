---
/// <reference types="../../virtual.d.ts" />
import "@tokotuku/ui/styles.css";
import ambientScripts from "virtual:tokotuku/ambient-scripts";
import SEO from "@tokotuku/ui/SEO.astro";

interface Props {
  title: string;
  description?: string | undefined;
  image?: string | undefined;
  type?: "website" | "product" | "article" | undefined;
  lang?: string | undefined;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
  noindex?: boolean | undefined;
  siteName?: string | undefined;
  palette?:
    | {
        light?: { accent?: string; accentForeground?: string };
        dark?: { accent?: string; accentForeground?: string };
      }
    | undefined;
}

const {
  title,
  description = "Straightforward products, fair prices, and no unnecessary noise.",
  image,
  type = "website",
  jsonLd,
  noindex = false,
  siteName = "Tokotuku",
  lang = "en",
  palette,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const absoluteImage = image ? new URL(image, Astro.url.origin).toString() : undefined;
const locale = lang.toLowerCase().startsWith("id") ? "id" : "en";
const paletteVars = [
  palette?.light?.accent ? `--tk-color-accent:${palette.light.accent}` : "",
  palette?.light?.accentForeground ? `--tk-color-accent-fg:${palette.light.accentForeground}` : "",
  palette?.dark?.accent ? `--tk-dark-accent:${palette.dark.accent}` : "",
  palette?.dark?.accentForeground ? `--tk-dark-accent-fg:${palette.dark.accentForeground}` : "",
]
  .filter(Boolean)
  .join(";");
---

<html lang={locale} style={paletteVars || undefined}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <SEO
      title={title}
      description={description}
      url={canonicalUrl}
      image={absoluteImage}
      type={type}
      siteName={siteName}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("tokotuku-theme");
        const theme = saved === "light" || saved === "dark" ? saved : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
    {ambientScripts.map((AmbientScript) => (
      <AmbientScript />
    ))}
  </body>
</html>
