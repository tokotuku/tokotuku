---
/// <reference types="../../virtual.d.ts" />
import "@karsa/theme/styles.css";
import ambientScripts from "virtual:karsa/ambient-scripts";
import { type PaletteColors, paletteStyle } from "@karsa/theme/palette";
import ThemeScript from "@karsa/theme/ThemeScript.astro";
import SEO from "@karsa/ui/SEO.astro";

interface Props {
  title: string;
  description?: string | undefined;
  image?: string | undefined;
  type?: "website" | "product" | "article" | undefined;
  lang?: string | undefined;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
  noindex?: boolean | undefined;
  siteName?: string | undefined;
  palette?: { light?: PaletteColors; dark?: PaletteColors } | undefined;
}

const {
  title,
  description = "A clear, accessible site for purposeful work.",
  image,
  type = "website",
  jsonLd,
  noindex = false,
  siteName = "Karsa",
  lang = "en",
  palette,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const absoluteImage = image ? new URL(image, Astro.url.origin).toString() : undefined;
const locale = lang.toLowerCase().startsWith("id") ? "id" : "en";
const paletteVars = paletteStyle({ palette });
---

<html lang={locale} style={paletteVars || undefined}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <SEO
      title={title}
      description={description}
      url={canonicalUrl}
      image={absoluteImage}
      type={type}
      siteName={siteName}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <ThemeScript />
  </head>
  <body>
    <slot />
    {ambientScripts.map((AmbientScript) => (
      <AmbientScript />
    ))}
  </body>
</html>
