---
import Icon from "../core/Icon.astro";

interface Props {
  title?: string;
  themeLabel?: string;
}
const { title = "Workspace", themeLabel = "Toggle color theme" } = Astro.props;
---

<div class="topbar-inner">
  <span class="title">{title}</span>
  <div class="actions">
    <button class="theme-toggle" type="button" data-app-theme-toggle aria-label={themeLabel}><Icon name="moon" size={17} /></button>
    <slot />
  </div>
</div>

<script>
  document.querySelector<HTMLButtonElement>("[data-app-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("takontuku-theme", next);
  });
</script>

<style>
  .topbar-inner { display:flex; align-items:center; justify-content:space-between; min-height:4rem; padding-inline:var(--tk-spacing-5); }.title { color:var(--tk-color-fg); font-size:var(--tk-font-size-sm); font-weight:var(--tk-font-weight-semibold); }.actions { display:flex; align-items:center; gap:var(--tk-spacing-3); }.theme-toggle { display:grid; width:2.75rem; height:2.75rem; place-items:center; border:1px solid var(--tk-color-border); border-radius:50%; background:var(--tk-color-surface); color:var(--tk-color-fg); cursor:pointer; }
</style>
