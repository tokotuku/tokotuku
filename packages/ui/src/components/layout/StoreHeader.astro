---
import Icon from "../core/Icon.astro";

interface HeaderBrand {
  name?: string;
  logo?: { src: string; alt?: string };
}
interface HeaderLabels {
  home?: string;
  shop?: string;
  account?: string;
  search?: string;
  theme?: string;
  cart?: string;
  admin?: string;
  openMenu?: string;
  closeMenu?: string;
  navigation?: string;
}
interface Props {
  current?: "home" | "products" | "cart" | "account" | undefined;
  brand?: HeaderBrand | undefined;
  labels?: HeaderLabels | undefined;
  showShop?: boolean | undefined;
  showCart?: boolean | undefined;
  showAccount?: boolean | undefined;
  showSearch?: boolean | undefined;
  showAdmin?: boolean | undefined;
  announcement?: string | false | undefined;
  links?: Array<{ label: string; href: string }> | undefined;
}

const {
  current,
  brand = { name: "Takontuku" },
  labels = {},
  showShop = true,
  showCart = false,
  showAccount = true,
  showSearch = true,
  showAdmin = false,
  announcement = "Objects for everyday rituals.",
  links = [],
} = Astro.props;
const name = brand.name ?? "Takontuku";
const l = {
  home: labels.home ?? "Home",
  shop: labels.shop ?? "Shop",
  account: labels.account ?? "Account",
  search: labels.search ?? "Search",
  theme: labels.theme ?? "Toggle theme",
  cart: labels.cart ?? "Cart",
  admin: labels.admin ?? "Admin",
  openMenu: labels.openMenu ?? "Open menu",
  closeMenu: labels.closeMenu ?? "Close menu",
  navigation: labels.navigation ?? "Store navigation",
};

import "./StoreHeader.css";
---

<header class="store-header" data-store-header>
  {announcement !== false && <div class="announcement"><Icon name="logo" size={11} /> {announcement}</div>}
  <div class="header-inner">
    <button class="menu-toggle" type="button" data-menu-toggle data-open-label={l.openMenu} data-close-label={l.closeMenu} aria-expanded="false" aria-controls="store-nav" aria-label={l.openMenu}><Icon name="menu" size={19} /></button>
    <a class="brand" href="/" aria-label={name + " " + l.home.toLowerCase()}>
      {brand.logo?.src ? <img src={brand.logo.src} alt={brand.logo.alt ?? name} /> : <span class="brand-wordmark">{name}</span>}
    </a>
    <nav id="store-nav" aria-label={l.navigation} data-store-nav>
      <div class="drawer-head">
        <strong>{name}</strong>
        <button class="drawer-close" type="button" data-menu-close aria-label={l.closeMenu}>
          <Icon paths={["M6 6l12 12", "M18 6 6 18"]} size={20} />
        </button>
      </div>
      <a href="/" aria-current={current === "home" ? "page" : undefined}>{l.home}</a>
      {showShop && <a href="/products" aria-current={current === "products" ? "page" : undefined}>{l.shop}</a>}
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      {showAdmin && <a href="/admin">{l.admin}</a>}
    </nav>
    <div class="actions">
      {showSearch && <button class="icon-button" type="button" data-search-toggle aria-label={l.search}><Icon name="search" size={18} /></button>}
      {showAccount && <a class="icon-button" href="/login" aria-label={l.account}><Icon name="user" size={18} /></a>}
      <button class="icon-button" type="button" data-theme-toggle aria-label={l.theme}><Icon name="moon" size={18} /></button>
      {showCart && <a class="cart-link" href="/cart" aria-current={current === "cart" ? "page" : undefined} aria-label={l.cart}><Icon name="cart" size={18} /><span data-cart-count>0</span></a>}
    </div>
  </div>
  <button class="nav-scrim" type="button" data-menu-scrim aria-label={l.closeMenu} hidden></button>
  <div class="search-drawer" data-search-drawer hidden>
    <form action="/products" method="get"><label class="sr-only" for="store-search">{l.search}</label><input id="store-search" name="q" placeholder={l.search + "…"} /><button type="submit">{l.search}</button></form>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-store-header]");
  const menu = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = header?.querySelector<HTMLElement>("[data-store-nav]");
  const closeMenu = header?.querySelector<HTMLButtonElement>("[data-menu-close]");
  const scrim = header?.querySelector<HTMLButtonElement>("[data-menu-scrim]");
  const drawer = header?.querySelector<HTMLElement>("[data-search-drawer]");
  const mobileQuery = window.matchMedia("(max-width: 720px)");
  let previouslyFocused: HTMLElement | null = null;
  let previousBodyOverflow = "";

  function syncNavAccessibility(open: boolean): void {
    if (!nav) return;
    if (mobileQuery.matches) nav.setAttribute("aria-hidden", String(!open));
    else nav.removeAttribute("aria-hidden");
  }

  function setMenuOpen(open: boolean): void {
    if (!header || !menu || !nav || !scrim) return;
    if (open && !mobileQuery.matches) return;
    const currentlyOpen = header.getAttribute("data-menu-open") === "true";
    if (currentlyOpen === open) return;

    if (open) {
      previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : menu;
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      header.setAttribute("data-menu-open", "true");
      menu.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-label", menu.dataset["closeLabel"] ?? "Close menu");
      syncNavAccessibility(true);
      scrim.hidden = false;
      closeMenu?.focus();
      return;
    }

    header.removeAttribute("data-menu-open");
    menu.setAttribute("aria-expanded", "false");
    menu.setAttribute("aria-label", menu.dataset["openLabel"] ?? "Open menu");
    syncNavAccessibility(false);
    scrim.hidden = true;
    document.body.style.overflow = previousBodyOverflow;
    const focusTarget = previouslyFocused ?? menu;
    previouslyFocused = null;
    if (document.activeElement instanceof HTMLElement && nav.contains(document.activeElement)) focusTarget.focus();
  }

  menu?.addEventListener("click", () => setMenuOpen(header?.getAttribute("data-menu-open") !== "true"));
  closeMenu?.addEventListener("click", () => setMenuOpen(false));
  scrim?.addEventListener("click", () => setMenuOpen(false));
  nav?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header?.getAttribute("data-menu-open") === "true") setMenuOpen(false);
    if (event.key !== "Tab" || header?.getAttribute("data-menu-open") !== "true" || !nav) return;
    const focusable = Array.from(
      nav.querySelectorAll<HTMLElement>("a, button, input, select, textarea, [tabindex]:not([tabindex='-1'])"),
    ).filter((element) => !element.hasAttribute("disabled"));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  mobileQuery.addEventListener("change", (event) => {
    if (!event.matches && header?.getAttribute("data-menu-open") === "true") setMenuOpen(false);
    else syncNavAccessibility(header?.getAttribute("data-menu-open") === "true");
  });
  syncNavAccessibility(header?.getAttribute("data-menu-open") === "true");
  header?.querySelector("[data-search-toggle]")?.addEventListener("click", () => {
    if (header?.getAttribute("data-menu-open") === "true") setMenuOpen(false);
    if (!drawer) return;
    drawer.hidden = !drawer.hidden;
    if (!drawer.hidden) drawer.querySelector("input")?.focus();
  });
  header?.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("takontuku-theme", next);
  });
</script>
