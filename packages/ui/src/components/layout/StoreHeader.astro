---
interface Props {
  current?: "home" | "products" | "cart";
}

const { current } = Astro.props;
---

<header
  class="store-header"
  x-data="{ theme: localStorage.getItem('tokotuku-theme') ?? 'light' }"
  x-init="document.documentElement.dataset.theme = theme"
>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Tokotuku home">
      <span class="brand-mark">T</span>
      <span>Tokotuku</span>
    </a>

    <nav aria-label="Store navigation">
      <a href="/" aria-current={current === "home" ? "page" : undefined}>Home</a>
      <a href="/products" aria-current={current === "products" ? "page" : undefined}>Shop</a>
      <a href="/admin">Admin</a>
    </nav>

    <div class="actions">
      <label>
        <span class="sr-only">Color theme</span>
        <select
          x-model="theme"
          @change="document.documentElement.dataset.theme = theme; localStorage.setItem('tokotuku-theme', theme)"
          aria-label="Color theme"
        >
          <option value="light">Light</option>
          <option value="dark">Dark</option>
          <option value="high-contrast">Contrast</option>
        </select>
      </label>
      <a class="cart-link" href="/cart" aria-current={current === "cart" ? "page" : undefined}>
        Cart <span data-cart-count>0</span>
      </a>
    </div>
  </div>
</header>

<style>
  .store-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--tk-color-border);
    background: color-mix(in srgb, var(--tk-color-bg) 92%, transparent);
    backdrop-filter: blur(0.75rem);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tk-spacing-5);
    width: min(100% - calc(var(--tk-spacing-4) * 2), 76rem);
    min-height: 4.5rem;
    margin-inline: auto;
  }

  .brand,
  nav,
  .actions {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: var(--tk-spacing-2);
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-lg);
    font-weight: var(--tk-font-weight-bold);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: var(--tk-radius-md);
    background: var(--tk-color-accent);
    color: var(--tk-color-accent-fg);
  }

  nav {
    gap: var(--tk-spacing-5);
  }

  nav a,
  .cart-link {
    color: var(--tk-color-fg-muted);
    font-size: var(--tk-font-size-sm);
    font-weight: var(--tk-font-weight-medium);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"],
  .cart-link:hover,
  .cart-link[aria-current="page"] {
    color: var(--tk-color-accent);
  }

  .actions {
    gap: var(--tk-spacing-3);
  }

  select {
    min-height: 2.25rem;
    padding-inline: var(--tk-spacing-2);
    border: 1px solid var(--tk-color-border);
    border-radius: var(--tk-radius-md);
    background: var(--tk-color-bg);
    color: var(--tk-color-fg);
  }

  .cart-link {
    padding: var(--tk-spacing-2) var(--tk-spacing-3);
    border: 1px solid var(--tk-color-border);
    border-radius: var(--tk-radius-full);
  }

  [data-cart-count] {
    display: inline-grid;
    min-width: 1.25rem;
    min-height: 1.25rem;
    margin-left: var(--tk-spacing-1);
    place-items: center;
    border-radius: var(--tk-radius-full);
    background: var(--tk-color-accent);
    color: var(--tk-color-accent-fg);
    font-size: var(--tk-font-size-xs);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 42rem) {
    .header-inner {
      flex-wrap: wrap;
      padding-block: var(--tk-spacing-3);
    }

    nav {
      order: 3;
      width: 100%;
      justify-content: center;
    }

    select {
      max-width: 5.5rem;
    }
  }
</style>
