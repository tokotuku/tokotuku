---
import Icon from "../core/Icon.astro";

interface HeaderBrand {
  name?: string;
  logo?: { src: string; alt?: string };
}
interface HeaderLabels {
  home?: string;
  shop?: string;
  account?: string;
  search?: string;
  theme?: string;
  cart?: string;
  admin?: string;
  openMenu?: string;
  closeMenu?: string;
  navigation?: string;
}
interface Props {
  current?: "home" | "products" | "cart" | "account" | undefined;
  brand?: HeaderBrand | undefined;
  labels?: HeaderLabels | undefined;
  showShop?: boolean | undefined;
  showCart?: boolean | undefined;
  showAccount?: boolean | undefined;
  showSearch?: boolean | undefined;
  showAdmin?: boolean | undefined;
  announcement?: string | false | undefined;
  links?: Array<{ label: string; href: string }> | undefined;
}

const {
  current,
  brand = { name: "Takontuku" },
  labels = {},
  showShop = true,
  showCart = false,
  showAccount = true,
  showSearch = true,
  showAdmin = false,
  announcement = "Objects for everyday rituals.",
  links = [],
} = Astro.props;
const name = brand.name ?? "Takontuku";
const l = {
  home: labels.home ?? "Home",
  shop: labels.shop ?? "Shop",
  account: labels.account ?? "Account",
  search: labels.search ?? "Search",
  theme: labels.theme ?? "Toggle theme",
  cart: labels.cart ?? "Cart",
  admin: labels.admin ?? "Admin",
  openMenu: labels.openMenu ?? "Open menu",
  closeMenu: labels.closeMenu ?? "Close menu",
  navigation: labels.navigation ?? "Store navigation",
};
---

<header class="store-header" data-store-header>
  {announcement !== false && <div class="announcement"><Icon name="logo" size={11} /> {announcement}</div>}
  <div class="header-inner">
    <button class="menu-toggle" type="button" data-menu-toggle data-open-label={l.openMenu} data-close-label={l.closeMenu} aria-expanded="false" aria-controls="store-nav" aria-label={l.openMenu}><Icon name="menu" size={19} /></button>
    <a class="brand" href="/" aria-label={name + " " + l.home.toLowerCase()}>
      {brand.logo?.src ? <img src={brand.logo.src} alt={brand.logo.alt ?? name} /> : <span class="brand-wordmark">{name}</span>}
    </a>
    <nav id="store-nav" aria-label={l.navigation} data-store-nav>
      <div class="drawer-head">
        <strong>{name}</strong>
        <button class="drawer-close" type="button" data-menu-close aria-label={l.closeMenu}>
          <Icon paths={["M6 6l12 12", "M18 6 6 18"]} size={20} />
        </button>
      </div>
      <a href="/" aria-current={current === "home" ? "page" : undefined}>{l.home}</a>
      {showShop && <a href="/products" aria-current={current === "products" ? "page" : undefined}>{l.shop}</a>}
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      {showAdmin && <a href="/admin">{l.admin}</a>}
    </nav>
    <div class="actions">
      {showSearch && <button class="icon-button" type="button" data-search-toggle aria-label={l.search}><Icon name="search" size={18} /></button>}
      {showAccount && <a class="icon-button" href="/login" aria-label={l.account}><Icon name="user" size={18} /></a>}
      <button class="icon-button" type="button" data-theme-toggle aria-label={l.theme}><Icon name="moon" size={18} /></button>
      {showCart && <a class="cart-link" href="/cart" aria-current={current === "cart" ? "page" : undefined} aria-label={l.cart}><Icon name="cart" size={18} /><span data-cart-count>0</span></a>}
    </div>
  </div>
  <button class="nav-scrim" type="button" data-menu-scrim aria-label={l.closeMenu} hidden></button>
  <div class="search-drawer" data-search-drawer hidden>
    <form action="/products" method="get"><label class="sr-only" for="store-search">{l.search}</label><input id="store-search" name="q" placeholder={l.search + "…"} /><button type="submit">{l.search}</button></form>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-store-header]");
  const menu = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = header?.querySelector<HTMLElement>("[data-store-nav]");
  const closeMenu = header?.querySelector<HTMLButtonElement>("[data-menu-close]");
  const scrim = header?.querySelector<HTMLButtonElement>("[data-menu-scrim]");
  const drawer = header?.querySelector<HTMLElement>("[data-search-drawer]");
  const mobileQuery = window.matchMedia("(max-width: 720px)");
  let previouslyFocused: HTMLElement | null = null;
  let previousBodyOverflow = "";

  function syncNavAccessibility(open: boolean): void {
    if (!nav) return;
    if (mobileQuery.matches) nav.setAttribute("aria-hidden", String(!open));
    else nav.removeAttribute("aria-hidden");
  }

  function setMenuOpen(open: boolean): void {
    if (!header || !menu || !nav || !scrim) return;
    if (open && !mobileQuery.matches) return;
    const currentlyOpen = header.getAttribute("data-menu-open") === "true";
    if (currentlyOpen === open) return;

    if (open) {
      previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : menu;
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      header.setAttribute("data-menu-open", "true");
      menu.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-label", menu.dataset["closeLabel"] ?? "Close menu");
      syncNavAccessibility(true);
      scrim.hidden = false;
      closeMenu?.focus();
      return;
    }

    header.removeAttribute("data-menu-open");
    menu.setAttribute("aria-expanded", "false");
    menu.setAttribute("aria-label", menu.dataset["openLabel"] ?? "Open menu");
    syncNavAccessibility(false);
    scrim.hidden = true;
    document.body.style.overflow = previousBodyOverflow;
    const focusTarget = previouslyFocused ?? menu;
    previouslyFocused = null;
    if (document.activeElement instanceof HTMLElement && nav.contains(document.activeElement)) focusTarget.focus();
  }

  menu?.addEventListener("click", () => setMenuOpen(header?.getAttribute("data-menu-open") !== "true"));
  closeMenu?.addEventListener("click", () => setMenuOpen(false));
  scrim?.addEventListener("click", () => setMenuOpen(false));
  nav?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header?.getAttribute("data-menu-open") === "true") setMenuOpen(false);
    if (event.key !== "Tab" || header?.getAttribute("data-menu-open") !== "true" || !nav) return;
    const focusable = Array.from(
      nav.querySelectorAll<HTMLElement>("a, button, input, select, textarea, [tabindex]:not([tabindex='-1'])"),
    ).filter((element) => !element.hasAttribute("disabled"));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  mobileQuery.addEventListener("change", (event) => {
    if (!event.matches && header?.getAttribute("data-menu-open") === "true") setMenuOpen(false);
    else syncNavAccessibility(header?.getAttribute("data-menu-open") === "true");
  });
  syncNavAccessibility(header?.getAttribute("data-menu-open") === "true");
  header?.querySelector("[data-search-toggle]")?.addEventListener("click", () => {
    if (header?.getAttribute("data-menu-open") === "true") setMenuOpen(false);
    if (!drawer) return;
    drawer.hidden = !drawer.hidden;
    if (!drawer.hidden) drawer.querySelector("input")?.focus();
  });
  header?.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("takontuku-theme", next);
  });
</script>

<style>
  .store-header { position:relative; z-index:20; border-bottom:1px solid var(--tk-color-border); background:var(--tk-color-surface); }
  .announcement { display:flex; align-items:center; justify-content:center; gap:.45rem; min-height:1.9rem; background:var(--tk-color-fg); color:var(--tk-color-surface); font-size:.65rem; letter-spacing:.05em; }
  .announcement span { color:var(--tk-color-accent); }
  .header-inner { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:1.5rem; width:min(100% - 2.5rem,78rem); min-height:4.5rem; margin:auto; }
  .brand { justify-self:start; color:var(--tk-color-fg); text-decoration:none; }.brand-wordmark { font-family:var(--tk-font-family-display); font-size:1.35rem; letter-spacing:.18em; text-transform:uppercase; }.brand img { display:block; max-width:9rem; max-height:2.1rem; }
  nav { display:flex; align-items:center; justify-content:center; gap:1.9rem; } nav a { color:var(--tk-color-fg); font-size:.76rem; text-decoration:none; } nav a:hover,nav a[aria-current="page"] { color:var(--tk-color-accent); }
  .actions { display:flex; align-items:center; justify-content:flex-end; gap:.45rem; }.icon-button,.menu-toggle { display:grid; width:2.75rem; height:2.75rem; place-items:center; border:0; border-radius:50%; background:transparent; color:var(--tk-color-fg); text-decoration:none; cursor:pointer; }.icon-button:hover,.menu-toggle:hover { background:var(--tk-color-bg-subtle); }
  .cart-link { position:relative; display:grid; width:2.75rem; height:2.75rem; place-items:center; color:var(--tk-color-fg); text-decoration:none; }.cart-link span { position:absolute; top:.15rem; right:.1rem; display:grid; min-width:1rem; height:1rem; padding-inline:.15rem; place-items:center; border-radius:50%; background:var(--tk-color-accent); color:var(--tk-color-accent-fg); font-size:.58rem; }
  .menu-toggle { display:none; }
  .drawer-head { display:none; }
  .drawer-close { display:grid; width:2.75rem; height:2.75rem; place-items:center; border:1px solid var(--tk-color-border); border-radius:var(--tk-radius-full); background:transparent; color:var(--tk-color-fg); cursor:pointer; }
  .nav-scrim { display:none; }
  .search-drawer { padding:.75rem max(1.25rem,calc((100% - 78rem)/2)); border-top:1px solid var(--tk-color-border); background:var(--tk-color-bg); }.search-drawer form { display:flex; gap:.5rem; max-width:34rem; margin:auto; }.search-drawer input { flex:1; min-height:2.7rem; padding:.6rem .8rem; border:1px solid var(--tk-color-border); border-radius:var(--tk-radius-sm); background:var(--tk-color-surface); color:var(--tk-color-fg); }.search-drawer button { padding-inline:1rem; border:0; border-radius:var(--tk-radius-sm); background:var(--tk-color-accent); color:var(--tk-color-accent-fg); font-size:.8rem; font-weight:700; }
  @media (max-width:720px) {
    .header-inner { grid-template-columns:auto 1fr auto; width:calc(100% - 1.5rem); min-height:4rem; }
    .menu-toggle { display:grid; z-index:1; }
    .brand { justify-self:center; }
    .brand-wordmark { font-size:1.1rem; }
    .header-inner nav {
      position:fixed;
      inset:0 0 0 auto;
      z-index:61;
      display:flex;
      width:min(88vw,22rem);
      max-width:calc(100vw - 1rem);
      flex-direction:column;
      align-items:stretch;
      gap:0;
      padding: max(1rem, env(safe-area-inset-top, 0px)) 1.25rem max(1rem, env(safe-area-inset-bottom, 0px));
      overflow-y:auto;
      overscroll-behavior:contain;
      border-left:1px solid var(--tk-color-border);
      background:var(--tk-color-surface);
      box-shadow:-1rem 0 3rem rgb(36 28 18 / 18%);
      visibility:hidden;
      opacity:0;
      transform:translateX(105%);
      transition:transform var(--tk-duration-normal) var(--tk-easing-standard), opacity var(--tk-duration-fast) var(--tk-easing-standard), visibility 0s linear var(--tk-duration-normal);
    }
    .store-header[data-menu-open="true"] nav {
      visibility:visible;
      opacity:1;
      transform:translateX(0);
      transition-delay:0s;
    }
    .drawer-head {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:1rem;
      min-height:3.5rem;
      margin-bottom:.75rem;
      padding-bottom:.75rem;
      border-bottom:1px solid var(--tk-color-border);
      color:var(--tk-color-fg);
      font-size:var(--tk-font-size-lg);
    }
    .header-inner nav a {
      display:flex;
      min-height:3.25rem;
      align-items:center;
      padding:.75rem .25rem;
      border-bottom:1px solid var(--tk-color-border);
      color:var(--tk-color-fg);
      font-size:var(--tk-font-size-base);
    }
    .header-inner nav a:last-child { border-bottom:0; }
    .header-inner nav a:hover,.header-inner nav a[aria-current="page"] { color:var(--tk-color-accent); }
    .nav-scrim:not([hidden]) {
      position:fixed;
      inset:0;
      z-index:60;
      display:block;
      width:100%;
      height:100%;
      padding:0;
      border:0;
      background:rgb(23 23 20 / 48%);
      cursor:pointer;
      backdrop-filter:blur(2px);
    }
    .actions .icon-button:first-child { display:none; }
    .announcement { font-size:.58rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-inner nav { transition:none; }
  }
</style>
