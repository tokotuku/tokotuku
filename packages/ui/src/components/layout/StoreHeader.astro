---
import Icon from "../core/Icon.astro";

interface HeaderBrand {
  name?: string;
  logo?: { src: string; alt?: string };
}
interface HeaderLabels {
  home?: string;
  shop?: string;
  account?: string;
  search?: string;
  theme?: string;
  cart?: string;
  admin?: string;
  openMenu?: string;
  closeMenu?: string;
  navigation?: string;
}
interface Props {
  current?: "home" | "products" | "cart" | "account" | undefined;
  brand?: HeaderBrand | undefined;
  labels?: HeaderLabels | undefined;
  showShop?: boolean | undefined;
  showCart?: boolean | undefined;
  showAccount?: boolean | undefined;
  showSearch?: boolean | undefined;
  showAdmin?: boolean | undefined;
  announcement?: string | false | undefined;
  links?: Array<{ label: string; href: string }> | undefined;
}

const {
  current,
  brand = { name: "Tokotuku" },
  labels = {},
  showShop = true,
  showCart = false,
  showAccount = true,
  showSearch = true,
  showAdmin = false,
  announcement = "Objects for everyday rituals.",
  links = [],
} = Astro.props;
const name = brand.name ?? "Tokotuku";
const l = {
  home: labels.home ?? "Home",
  shop: labels.shop ?? "Shop",
  account: labels.account ?? "Account",
  search: labels.search ?? "Search",
  theme: labels.theme ?? "Toggle theme",
  cart: labels.cart ?? "Cart",
  admin: labels.admin ?? "Admin",
  openMenu: labels.openMenu ?? "Open menu",
  closeMenu: labels.closeMenu ?? "Close menu",
  navigation: labels.navigation ?? "Store navigation",
};
---

<header class="store-header" data-store-header>
  {announcement !== false && <div class="announcement"><Icon name="logo" size={11} /> {announcement}</div>}
  <div class="header-inner">
    <button class="menu-toggle" type="button" data-menu-toggle data-open-label={l.openMenu} data-close-label={l.closeMenu} aria-expanded="false" aria-controls="store-nav" aria-label={l.openMenu}><Icon name="menu" size={19} /></button>
    <a class="brand" href="/" aria-label={name + " " + l.home.toLowerCase()}>
      {brand.logo?.src ? <img src={brand.logo.src} alt={brand.logo.alt ?? name} /> : <span class="brand-wordmark">{name}</span>}
    </a>
    <nav id="store-nav" aria-label={l.navigation} data-store-nav>
      <a href="/" aria-current={current === "home" ? "page" : undefined}>{l.home}</a>
      {showShop && <a href="/products" aria-current={current === "products" ? "page" : undefined}>{l.shop}</a>}
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      {showAdmin && <a href="/admin">{l.admin}</a>}
    </nav>
    <div class="actions">
      {showSearch && <button class="icon-button" type="button" data-search-toggle aria-label={l.search}><Icon name="search" size={18} /></button>}
      {showAccount && <a class="icon-button" href="/login" aria-label={l.account}><Icon name="user" size={18} /></a>}
      <button class="icon-button" type="button" data-theme-toggle aria-label={l.theme}><Icon name="moon" size={18} /></button>
      {showCart && <a class="cart-link" href="/cart" aria-current={current === "cart" ? "page" : undefined} aria-label={l.cart}><Icon name="cart" size={18} /><span data-cart-count>0</span></a>}
    </div>
  </div>
  <div class="search-drawer" data-search-drawer hidden>
    <form action="/products" method="get"><label class="sr-only" for="store-search">{l.search}</label><input id="store-search" name="q" placeholder={l.search + "…"} /><button type="submit">{l.search}</button></form>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-store-header]");
  const menu = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const drawer = header?.querySelector<HTMLElement>("[data-search-drawer]");
  menu?.addEventListener("click", () => {
    const open = header?.getAttribute("data-menu-open") === "true";
    if (open) { header?.removeAttribute("data-menu-open"); menu.setAttribute("aria-expanded", "false"); menu.setAttribute("aria-label", menu.dataset["openLabel"] ?? "Open menu"); }
    else { header?.setAttribute("data-menu-open", "true"); menu.setAttribute("aria-expanded", "true"); menu.setAttribute("aria-label", menu.dataset["closeLabel"] ?? "Close menu"); }
  });
  header?.querySelector("[data-search-toggle]")?.addEventListener("click", () => {
    if (!drawer) return;
    drawer.hidden = !drawer.hidden;
    if (!drawer.hidden) drawer.querySelector("input")?.focus();
  });
  header?.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("tokotuku-theme", next);
  });
</script>

<style>
  .store-header { position:relative; z-index:20; border-bottom:1px solid var(--tk-color-border); background:var(--tk-color-surface); }
  .announcement { display:flex; align-items:center; justify-content:center; gap:.45rem; min-height:1.9rem; background:var(--tk-color-fg); color:var(--tk-color-surface); font-size:.65rem; letter-spacing:.05em; }
  .announcement span { color:var(--tk-color-accent); }
  .header-inner { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:1.5rem; width:min(100% - 2.5rem,78rem); min-height:4.5rem; margin:auto; }
  .brand { justify-self:start; color:var(--tk-color-fg); text-decoration:none; }.brand-wordmark { font-family:var(--tk-font-family-display); font-size:1.35rem; letter-spacing:.18em; text-transform:uppercase; }.brand img { display:block; max-width:9rem; max-height:2.1rem; }
  nav { display:flex; align-items:center; justify-content:center; gap:1.9rem; } nav a { color:var(--tk-color-fg); font-size:.76rem; text-decoration:none; } nav a:hover,nav a[aria-current="page"] { color:var(--tk-color-accent); }
  .actions { display:flex; align-items:center; justify-content:flex-end; gap:.45rem; }.icon-button,.menu-toggle { display:grid; width:2.75rem; height:2.75rem; place-items:center; border:0; border-radius:50%; background:transparent; color:var(--tk-color-fg); text-decoration:none; cursor:pointer; }.icon-button:hover,.menu-toggle:hover { background:var(--tk-color-bg-subtle); }
  .cart-link { position:relative; display:grid; width:2.75rem; height:2.75rem; place-items:center; color:var(--tk-color-fg); text-decoration:none; }.cart-link span { position:absolute; top:.15rem; right:.1rem; display:grid; min-width:1rem; height:1rem; padding-inline:.15rem; place-items:center; border-radius:50%; background:var(--tk-color-accent); color:var(--tk-color-accent-fg); font-size:.58rem; }
  .menu-toggle { display:none; }.search-drawer { padding:.75rem max(1.25rem,calc((100% - 78rem)/2)); border-top:1px solid var(--tk-color-border); background:var(--tk-color-bg); }.search-drawer form { display:flex; gap:.5rem; max-width:34rem; margin:auto; }.search-drawer input { flex:1; min-height:2.7rem; padding:.6rem .8rem; border:1px solid var(--tk-color-border); border-radius:var(--tk-radius-sm); background:var(--tk-color-surface); color:var(--tk-color-fg); }.search-drawer button { padding-inline:1rem; border:0; border-radius:var(--tk-radius-sm); background:var(--tk-color-accent); color:var(--tk-color-accent-fg); font-size:.8rem; font-weight:700; }
  @media (max-width:720px) { .header-inner { grid-template-columns:auto 1fr auto; width:calc(100% - 1.5rem); min-height:4rem; }.menu-toggle { display:grid; }.brand { justify-self:center; }.brand-wordmark { font-size:1.1rem; }.header-inner nav { position:absolute; top:100%; left:0; right:0; display:none; flex-direction:column; align-items:stretch; gap:0; padding:.75rem 1.25rem 1rem; border-bottom:1px solid var(--tk-color-border); background:var(--tk-color-surface); box-shadow:var(--tk-shadow-md); }.store-header[data-menu-open="true"] nav { display:flex; }.header-inner nav a { min-height:2.8rem; padding:.7rem 0; border-bottom:1px solid var(--tk-color-border); }.header-inner nav a:last-child { border-bottom:0; }.actions .icon-button:first-child { display:none; }.announcement { font-size:.58rem; } }
</style>
