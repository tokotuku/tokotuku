---
interface Props {
  title: string;
  description: string;
  actionHref?: string | undefined;
  actionLabel?: string | undefined;
  eyebrow?: string | undefined;
}
const { title, description, actionHref, actionLabel, eyebrow = "Koleksi" } = Astro.props;

import "./CatalogEmptyState.css";
---

<section class="empty-collection" data-empty-collection aria-labelledby="empty-collection-title">
  <div class="empty-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
  <p class="eyebrow">{eyebrow}</p>
  <h1 id="empty-collection-title">{title}</h1>
  <p class="description">{description}</p>
  {actionHref && actionLabel && <a class="empty-action" href={actionHref}>{actionLabel}<span aria-hidden="true">↗</span></a>}
</section>
