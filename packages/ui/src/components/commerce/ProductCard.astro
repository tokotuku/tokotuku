---
import Icon from "../core/Icon.astro";

interface Props {
  id: number;
  href?: string;
  name: string;
  description: string;
  price: string;
  priceCents: number | null;
  imageUrl: string;
  stock?: number;
  /**
   * A scheduled (booking) item has no stock at all — not zero, meaningless.
   * Set to false so the card never renders "Sold out"/"Few left" for it,
   * and never disables its action button on a stock reading that isn't real.
   */
  showStock?: boolean;
  showAddToCart?: boolean;
  category?: string;
  labels?: { view?: string; add?: string; soldOut?: string; lowStock?: string };
  imageAlt?: string;
}

const {
  id,
  href = `/products/${id}`,
  name,
  description,
  price,
  priceCents,
  imageUrl,
  stock = 1,
  showStock = true,
  showAddToCart = false,
  category = "Everyday objects",
  labels = {},
  imageAlt = name,
} = Astro.props;
const serialized = JSON.stringify({ id, name, priceCents, imageUrl });
const available = !showStock || stock > 0;
let stockLabel: string | undefined;
if (showStock) {
  if (!available) stockLabel = labels.soldOut ?? "Sold out";
  else if (stock <= 5) stockLabel = labels.lowStock ?? "Few left";
}

import "./ProductCard.css";
---

<article class="product-card" data-product-card>
  <a class="media" href={href} aria-label={(labels.view ?? "View") + " " + name}>
    <img src={imageUrl} alt={imageAlt} loading="lazy" />
    {stockLabel && <span class:list={["stock-pill", !available && "stock-pill--out"]}>{stockLabel}</span>}
  </a>
  <div class="body">
    <div class="copy"><p class="category">{category}</p><h2><a href={href}>{name}</a></h2><p class="description">{description}</p></div>
    <div class="footer"><strong>{price}</strong>{showAddToCart && <button type="button" data-add-to-cart data-product={serialized} disabled={!available} aria-label={available ? (labels.add ?? "Add to cart") + " " + name : (labels.soldOut ?? "Sold out")}>{available ? <Icon name="plus" size={16} /> : <span>{labels.soldOut ?? "Sold out"}</span>}</button>}</div>
  </div>
</article>
