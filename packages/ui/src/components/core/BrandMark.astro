---
import defaultMark from "../../assets/takontuku-default-mark.png";

interface Props {
  alt?: string;
  class?: string;
  size?: number;
}

const { alt = "", class: className, size = 40 } = Astro.props;
---

<img
  class:list={["tk-brand-mark", className]}
  src={defaultMark.src}
  width={size}
  height={size}
  alt={alt}
  loading="eager"
  decoding="async"
  style={`width:${size}px;height:${size}px`}
/>

<style>
  .tk-brand-mark { display: block; flex: none; object-fit: contain; }
</style>
