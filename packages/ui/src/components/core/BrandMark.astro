---
import defaultMark from "../../assets/takontuku-default-mark.svg";

interface Props {
  alt?: string;
  class?: string;
  size?: number;
}

const { alt = "", class: className, size = 40 } = Astro.props;

import "./BrandMark.css";
---

<img
  class:list={["tk-brand-mark", className]}
  src={defaultMark.src}
  width={size}
  height={size}
  alt={alt}
  loading="eager"
  decoding="async"
  style={`width:${size}px;height:${size}px`}
/>
