{
  "name": "@karsa/auth",
  "version": "0.3.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./src/auth-client.ts",
      "import": "./src/auth-client.ts"
    },
    "./components/*": "./src/components/*",
    "./register": "./src/register.ts",
    "./routes/*": "./src/routes/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@karsa/core": "workspace:*",
    "@karsa/theme": "workspace:*",
    "@karsa/ui": "workspace:*",
    "better-auth": ">=1.6.23 <1.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260710.1",
    "@karsa/config": "workspace:*",
    "astro": "^7.0.9"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "astro": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "astro check"
  }
}
