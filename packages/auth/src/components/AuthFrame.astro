---
/// <reference types="@karsa/core/virtual.d.ts" />
import "@karsa/theme/styles.css";
import authPanelWidgets from "virtual:karsa/auth-panel-widgets";
import brand from "virtual:karsa/config";
import { createTranslator } from "@karsa/core";
import { paletteStyle } from "@karsa/theme/palette";
import ThemeScript from "@karsa/theme/ThemeScript.astro";
import BrandMark from "@karsa/ui/BrandMark.astro";
import Icon from "@karsa/ui/Icon.astro";
import defaultAuthImage480Avif from "../auth-login-background-default-v2-480.avif";
import defaultAuthImage480 from "../auth-login-background-default-v2-480.webp";
import defaultAuthImage768Avif from "../auth-login-background-default-v2-768.avif";
import defaultAuthImage768 from "../auth-login-background-default-v2-768.webp";
import defaultAuthImage1024Avif from "../auth-login-background-default-v2-1024.avif";
import defaultAuthImage1024 from "../auth-login-background-default-v2-1024.webp";
import { authMessages } from "../messages";

interface Props {
  title: string;
}

const { title } = Astro.props;
const t = createTranslator(brand, authMessages);
const customAuthImage =
  typeof brand.auth?.backgroundImage === "string" ? brand.auth.backgroundImage.trim() : "";
const hasCustomAuthImage = customAuthImage.length > 0;
const authImageSrc = hasCustomAuthImage ? customAuthImage : defaultAuthImage1024.src;
const requestedPosition = brand.auth?.backgroundPosition ?? "center";
const authImagePosition = /^[a-z0-9% .,-]+$/i.test(requestedPosition)
  ? requestedPosition
  : "center";

import "./AuthFrame.css";
---

<html lang={brand.locale.toLowerCase().startsWith("id") ? "id" : "en"} style={paletteStyle(brand) || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — {brand.name}</title>
    <ThemeScript />
  </head>
  <body>
    <main class="auth-shell">
      <button class="auth-theme" type="button" data-auth-theme aria-label={t("auth.theme")}>
        <Icon name="moon" size={17} />
      </button>

      <picture class="auth-backdrop" aria-hidden="true">
        {!hasCustomAuthImage && <>
          <source type="image/avif" media="(max-width: 480px)" srcset={defaultAuthImage480Avif.src} />
          <source type="image/avif" media="(max-width: 768px)" srcset={defaultAuthImage768Avif.src} />
          <source type="image/avif" srcset={defaultAuthImage1024Avif.src} />
          <source type="image/webp" media="(max-width: 480px)" srcset={defaultAuthImage480.src} />
          <source type="image/webp" media="(max-width: 768px)" srcset={defaultAuthImage768.src} />
          <source type="image/webp" srcset={defaultAuthImage1024.src} />
        </>}
        <img data-auth-image src={authImageSrc} alt="" loading="eager" fetchpriority="high" decoding="async" style={`object-position:${authImagePosition}`} />
      </picture>
      <aside class="auth-story">
        <a class="auth-brand" href="/" aria-label={t("auth.mobile.brandAria", { brand: brand.name })}>
          {brand.logo?.src ? <img src={brand.logo.src} alt={brand.logo.alt ?? brand.name} /> : <span><BrandMark size={40} /></span>} {brand.name}
        </a>
        {authPanelWidgets.length > 0 && <div class="auth-panel-widgets">{authPanelWidgets.map(({ component: Widget }) => <Widget />)}</div>}
      </aside>

      <section class="auth-form-side">
        <a class="auth-form-brand" href="/" aria-label={t("auth.mobile.brandAria", { brand: brand.name })}>
          {brand.logo?.src ? <img src={brand.logo.src} alt={brand.logo.alt ?? brand.name} /> : <span><BrandMark size={32} /></span>}
          {brand.name}
        </a>
        <div class="auth-form-surface"><slot /></div>
      </section>
    </main>
  </body>
</html>

<script>
  const themeButton = document.querySelector<HTMLButtonElement>("[data-auth-theme]");
  const authImageElement = document.querySelector<HTMLImageElement>("[data-auth-image]");
  const removeBrokenImage = (event: Event) => (event.currentTarget as HTMLImageElement).remove();
  authImageElement?.addEventListener("error", removeBrokenImage, { once: true });
  if (authImageElement?.complete && authImageElement.naturalWidth === 0) authImageElement.remove();
  themeButton?.addEventListener("click", () => {
    const next = document.documentElement.dataset["theme"] === "dark" ? "light" : "dark";
    document.documentElement.dataset["theme"] = next;
    localStorage.setItem("karsa-theme", next);
  });
</script>
