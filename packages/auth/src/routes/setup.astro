---
import { env } from "cloudflare:workers";
import brand from "virtual:karsa/config";
import { createTranslator } from "@karsa/core";
import Icon from "@karsa/ui/Icon.astro";
import { createAuth } from "../auth";
import AuthFrame from "../components/AuthFrame.astro";
import { authMessages } from "../messages";
import { claimSetup, completeSetup, isSetupComplete, releaseSetupClaim } from "../setup";

const t = createTranslator(brand, authMessages);
let errorMessage = "";
let values = { name: "", email: "" };

if (await isSetupComplete(env.DB)) return Astro.redirect("/login", 302);

if (Astro.request.method === "POST") {
  const origin = Astro.request.headers.get("origin");
  if (origin !== Astro.url.origin) {
    errorMessage = t("auth.setup.error.origin");
  } else {
    const form = await Astro.request.formData();
    const name = String(form.get("name") ?? "").trim();
    const email = String(form.get("email") ?? "")
      .trim()
      .toLowerCase();
    const password = String(form.get("password") ?? "");
    const confirmPassword = String(form.get("confirmPassword") ?? "");
    values = { name, email };

    if (name.length < 2) errorMessage = t("auth.setup.error.name");
    else if (!email?.includes("@")) errorMessage = t("auth.setup.error.email");
    else if (password.length < 8) errorMessage = t("auth.setup.error.password");
    else if (password !== confirmPassword) errorMessage = t("auth.setup.error.confirm");
    else if (await isSetupComplete(env.DB)) return Astro.redirect("/login", 302);
    else if (!(await claimSetup(env.DB))) {
      errorMessage = t("auth.setup.error.running");
    } else {
      let createdUserId: string | undefined;
      try {
        // Setup is the only closed-registration bypass and is protected by the one-time claim.
        const auth = createAuth(env, Astro.url.origin, { disableSignUp: false });
        const result = await auth.api.signUpEmail({ body: { name, email, password } });
        createdUserId = result.user.id;
        await completeSetup(env.DB, createdUserId);
        return Astro.redirect("/login?setup=complete", 303);
      } catch (error) {
        await releaseSetupClaim(env.DB, createdUserId);
        errorMessage =
          error instanceof Error && error.message ? error.message : t("auth.setup.error.generic");
      }
    }
  }
}

import "../styles/routes/auth-setup.css";
---

<AuthFrame title={t("auth.setup.title")}>
  <form class="auth-card setup-card" method="post" action="/setup" novalidate data-auth-form>
    <span class="setup-step">{t("auth.setup.step")}</span>
    <h1>{t("auth.setup.title")}</h1>
    <p>{t("auth.setup.description")}</p>

    <div class="field">
      <label for="name">{t("auth.setup.nameLabel")}</label>
      <div class="input-wrap">
        <Icon name="user" size={16} />
        <input id="name" name="name" autocomplete="name" value={values.name} required />
      </div>
    </div>
    <div class="field">
      <label for="email">{t("auth.setup.emailLabel")}</label>
      <div class="input-wrap">
        <Icon name="mail" size={16} />
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          value={values.email}
          required
        />
      </div>
    </div>
    <div class="field">
      <label for="password">{t("auth.setup.passwordLabel")}</label>
      <div class="input-wrap">
        <Icon name="lock" size={16} />
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
          <button class="password-toggle" type="button" tabindex="-1" data-password-toggle data-show-label={t("auth.common.showPassword")} data-hide-label={t("auth.common.hidePassword")} aria-label={t("auth.common.showPassword")}>
          <Icon name="eye" size={16} />
        </button>
      </div>
    </div>
    <div class="field">
      <label for="confirm-password">{t("auth.setup.confirmPasswordLabel")}</label>
      <div class="input-wrap">
        <Icon name="lock" size={16} />
        <input
          id="confirm-password"
          name="confirmPassword"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </div>
    </div>

    {errorMessage && <p class="auth-message" role="alert">{errorMessage}</p>}
    <button class="auth-submit" type="submit" data-auth-submit data-loading-label={t("auth.setup.loading")}>
      {t("auth.setup.submit")} <Icon name="arrowRight" size={16} />
    </button>
    <p class="setup-note"><Icon name="lock" size={13} /> {t("auth.setup.note")}</p>
  </form>
</AuthFrame>

<script>
  const password = document.querySelector<HTMLInputElement>("#password");
  const confirmation = document.querySelector<HTMLInputElement>("#confirm-password");
  document.querySelector<HTMLElement>("[data-password-toggle]")?.addEventListener("click", (event) => {
    const nextType = password?.type === "password" ? "text" : "password";
    if (password) password.type = nextType;
    if (confirmation) confirmation.type = nextType;
    const button = event.currentTarget as HTMLElement;
    button.setAttribute("aria-label", nextType === "password" ? (button.dataset["showLabel"] ?? "") : (button.dataset["hideLabel"] ?? ""));
  });
  document.querySelector<HTMLFormElement>("[data-auth-form]")?.addEventListener("submit", () => {
    const form = document.querySelector<HTMLFormElement>("[data-auth-form]");
    const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!button) return;
    button.disabled = true;
    button.setAttribute("aria-busy", "true");
    button.textContent = button.dataset["loadingLabel"] ?? button.textContent;
  });
</script>
