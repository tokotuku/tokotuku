---
import brand from "virtual:karsa/config";
import { createTranslator } from "@karsa/core";
import Icon from "@karsa/ui/Icon.astro";
import AuthFrame from "../components/AuthFrame.astro";
import { authMessages } from "../messages";

const t = createTranslator(brand, authMessages);

import "../styles/routes/auth-forgot-password.css";
---

<AuthFrame title={t("auth.forgot.title")}>
  <form class="auth-card" id="forgot-form" method="post" action="/forgot-password" novalidate>
    <h1>{t("auth.forgot.title")}</h1>
    <p>{t("auth.forgot.description")}</p>
    <div class="field"><label for="email">{t("auth.login.emailLabel")}</label><div class="input-wrap"><Icon name="mail" size={16}/><input id="email" name="email" type="email" autocomplete="email" placeholder={t("auth.login.emailPlaceholder")} required /></div></div>
    <p class="auth-message success" id="forgot-success" data-success={t("auth.forgot.success")} hidden></p>
    <button class="auth-submit reset-submit" type="submit">{t("auth.forgot.submit")} <Icon name="arrowRight" size={16}/></button>
    <a class="auth-back" href="/login"><Icon name="arrowLeft" size={16}/> {t("auth.forgot.back")}</a>
  </form>
</AuthFrame>

<script>
  const form = document.querySelector<HTMLFormElement>("#forgot-form");
  const message = form?.querySelector<HTMLElement>("#forgot-success");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if (message) { message.textContent = ""; message.textContent = message.dataset["success"] ?? ""; message.removeAttribute("hidden"); }
  });
</script>
