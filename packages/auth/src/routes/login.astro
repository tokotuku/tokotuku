---
import brand from "virtual:karsa/config";
import { createTranslator } from "@karsa/core";
import Icon from "@karsa/ui/Icon.astro";
import AuthFrame from "../components/AuthFrame.astro";
import { authMessages } from "../messages";
import { safeInternalPath } from "../redirects";

const next = safeInternalPath(Astro.url.searchParams.get("next"), Astro.url.origin);
const t = createTranslator(brand, authMessages);
const setupComplete = Astro.url.searchParams.get("setup") === "complete";

import "../styles/routes/auth-login.css";
import registry from "virtual:karsa/registry";

const registrationIsPublic = registry.clientConfig["auth"]?.["registration"] === "public";
---

<AuthFrame title={t("auth.login.title")}>
  <form class="auth-card" id="login-form" method="post" action="/login" data-next={next} data-error-fallback={t("auth.common.error")} novalidate>
    <h1>{t("auth.login.title")}</h1>
    <p>{t("auth.login.description", { brand: brand.name })}</p>
    {setupComplete && <p class="auth-message success">{t("auth.login.setupComplete")}</p>}
    <p class="auth-message" id="login-error" aria-live="polite" hidden></p>

    <div class="field"><label for="email">{t("auth.login.emailLabel")}</label><div class="input-wrap"><Icon name="mail" size={16}/><input id="email" name="email" type="email" autocomplete="email" placeholder={t("auth.login.emailPlaceholder")} required /></div></div>
    <div class="field password-field"><label for="password">{t("auth.login.passwordLabel")}</label><div class="input-wrap"><Icon name="lock" size={16}/><input id="password" name="password" type="password" autocomplete="current-password" placeholder={t("auth.login.passwordPlaceholder")} required /><button class="password-toggle" type="button" tabindex="-1" data-password-toggle data-show-label={t("auth.common.showPassword")} data-hide-label={t("auth.common.hidePassword")} aria-label={t("auth.common.showPassword")}><Icon name="eye" size={16}/></button></div><a class="password-forgot" href="/forgot-password">{t("auth.login.forgot")}</a></div>
    <label class="check-row"><input type="checkbox" name="remember" /> {t("auth.login.remember")}</label>
    <button class="auth-submit" type="submit">{t("auth.login.submit")} <Icon name="arrowRight" size={16}/></button>
    {registrationIsPublic && <p class="auth-switch">{t("auth.login.newAccount", { brand: brand.name })} <a href="/register">{t("auth.login.createAccount")}</a></p>}

  </form>
</AuthFrame>

<script>
  import { authClient } from "../auth-client";
  const form = document.querySelector<HTMLFormElement>("#login-form");
  const email = form?.querySelector<HTMLInputElement>("#email");
  const password = form?.querySelector<HTMLInputElement>("#password");
  const error = form?.querySelector<HTMLElement>("#login-error");
  const submit = form?.querySelector<HTMLButtonElement>("[type=submit]");

  form?.querySelector<HTMLElement>("[data-password-toggle]")?.addEventListener("click", (event) => { if (password) { password.type = password.type === "password" ? "text" : "password"; const button = event.currentTarget as HTMLElement; button.setAttribute("aria-label", password.type === "password" ? (button.dataset["showLabel"] ?? "") : (button.dataset["hideLabel"] ?? "")); } });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    error?.setAttribute("hidden", "");
    if (!form.reportValidity() || !email || !password) return;
    if (submit) submit.disabled = true;
    try {
      const result = await authClient.signIn.email({ email: email.value, password: password.value });
      if (result.error) {
        if (error) {
          error.textContent = result.error.message ?? form.dataset["errorFallback"] ?? "";
          error.removeAttribute("hidden");
        }
        return;
      }
      location.href = form.dataset["next"] ?? "/admin";
    } catch (caught) {
      if (error) {
        error.textContent = caught instanceof Error && caught.message
          ? caught.message
          : form.dataset["errorFallback"] ?? "";
        error.removeAttribute("hidden");
      }
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
