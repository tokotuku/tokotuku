{
  "name": "@tokotuku/elements",
  "version": "0.0.0",
  "description": "Tokotuku UI Web Components: tk-* custom elements built with Lit, Shadow DOM, and full accessibility support.",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@tokotuku/core": "workspace:*",
    "@tokotuku/theme": "workspace:*",
    "@tokotuku/tokens": "workspace:*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@tokotuku/config": "workspace:*",
    "@tokotuku/testing": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
