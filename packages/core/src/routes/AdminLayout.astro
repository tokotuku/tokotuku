---
import "@tokotuku/ui/admin.css";
import adminNav from "virtual:tokotuku/admin-nav";
import Icon from "@tokotuku/ui/Icon.astro";
import Layout from "@tokotuku/ui/Layout.astro";
import { brand } from "../brand";

interface Props {
  title: string;
  /** Live count for the Orders badge — the registry's nav is static, so this is merged in at render time. */
  orderCount?: number;
}

const { title, orderCount = 0 } = Astro.props;
const { user } = Astro.locals;
if (!user) throw new Error("Unreachable: middleware guards /admin/*.");

const displayName = user.name?.trim() || user.email.split("@")[0] || "Admin";
const initials = displayName
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join("")
  .toUpperCase();

function isActive(pathname: string, href: string): boolean {
  if (href === "/admin") return pathname === "/admin";
  return pathname === href || pathname.startsWith(`${href}/`);
}

const activePathname = Astro.url.pathname;
const nav = adminNav.map((item) =>
  item.href === "/admin/orders" && orderCount ? { ...item, badge: String(orderCount) } : item,
);
---

<Layout title={`${title} — ${brand.name}`} siteName={brand.name}>
  <div class="admin-shell" data-admin-shell>
    <aside class="admin-sidebar" data-sidebar>
      <div class="sidebar-top">
        <a class="admin-brand" href="/admin" aria-label={`${brand.name} dashboard`}>
          <span class="brand-mark"><Icon name="logo" size={17} /></span>
          <span>{brand.name}</span>
        </a>
        <button class="icon-button sidebar-close" type="button" data-sidebar-close aria-label="Close menu">
          <Icon name="arrowLeft" />
        </button>
      </div>

      <p class="nav-label">Store</p>
      <nav class="admin-nav" aria-label="Store navigation">
        {nav.map((item) => (
          <a href={item.href} aria-current={isActive(activePathname, item.href) ? "page" : undefined}>
            {Array.isArray(item.icon) ? <Icon paths={item.icon} size={17} /> : <Icon name={item.icon} size={17} />}
            <span>{item.label}</span>
            {item.badge && <span class="nav-badge">{item.badge}</span>}
          </a>
        ))}
      </nav>

      <p class="nav-label nav-label--spaced">Pages</p>
      <nav class="admin-nav admin-nav--muted" aria-label="Example pages">
        <a href="/login"><Icon name="lock" size={17} /><span>Authentication</span><Icon name="chevronDown" size={15} /></a>
        <a href="/404"><Icon name="alert" size={17} /><span>Errors</span><Icon name="chevronDown" size={15} /></a>
        <a href="/admin"><Icon name="user" size={17} /><span>Profile</span></a>
        <a href="/admin"><Icon name="file" size={17} /><span>Blank</span></a>
      </nav>

      <div class="sidebar-footer">
        <a href="/admin"><Icon name="settings" size={17} /><span>Settings</span></a>
        <button type="button" data-sign-out><Icon name="logout" size={17} /><span>Log out</span></button>
        <p>Built with <a href="https://tokotuku.dev">Tokotuku UI</a></p>
      </div>
    </aside>

    <div class="sidebar-scrim" data-sidebar-scrim></div>

    <div class="admin-workspace">
      <header class="admin-topbar">
        <button class="icon-button menu-button" type="button" data-sidebar-open aria-label="Open menu"><Icon name="menu" /></button>
        <label class="global-search">
          <Icon name="search" size={17} />
          <span class="sr-only">Search orders, products, customers</span>
          <input type="search" placeholder="Search orders, products, customers…" />
        </label>
        <div class="topbar-actions">
          <button class="icon-button notification" type="button" aria-label="Notifications"><Icon name="bell" size={17} /><span></span></button>
          <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle color theme"><Icon name="moon" size={17} /></button>
          <div class="profile-chip">
            <span class="profile-name">{displayName}</span>
            <span class="profile-avatar">{initials}</span>
            <Icon name="chevronDown" size={14} />
          </div>
        </div>
      </header>

      <main class="admin-canvas">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script>
  const shell = document.querySelector("[data-admin-shell]");
  const openSidebar = () => shell?.setAttribute("data-sidebar-visible", "true");
  const closeSidebar = () => shell?.removeAttribute("data-sidebar-visible");

  document.querySelector("[data-sidebar-open]")?.addEventListener("click", openSidebar);
  document.querySelector("[data-sidebar-close]")?.addEventListener("click", closeSidebar);
  document.querySelector("[data-sidebar-scrim]")?.addEventListener("click", closeSidebar);

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset["theme"] === "dark" ? "light" : "dark";
    document.documentElement.dataset["theme"] = next;
    localStorage.setItem("tokotuku-theme", next);
  });

  document.querySelector("[data-sign-out]")?.addEventListener("click", async () => {
    // A plain POST rather than importing @tokotuku/auth's client SDK — the
    // admin shell is core, and core doesn't depend on auth (a client could
    // in principle ship its own auth). Better Auth's sign-out is just this
    // one request under the hood, but it needs an actual (even empty) JSON
    // body — a bare content-type header with no body 400s.
    await fetch("/api/auth/sign-out", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: "{}",
    });
    location.href = "/login";
  });
</script>
