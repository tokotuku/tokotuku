---
import "@takontuku/ui/admin.css";
import adminNav from "virtual:takontuku/admin-nav";
import Icon from "@takontuku/ui/Icon.astro";
import Layout from "@takontuku/ui/Layout.astro";
import { brand } from "../brand";
import { coreMessages, createTranslator } from "../messages";

interface Props {
  title: string;
  /** Live count for the Orders badge — the registry's nav is static, so this is merged in at render time. */
  orderCount?: number;
}

const { title, orderCount = 0 } = Astro.props;
const { user } = Astro.locals;
if (!user) throw new Error("Unreachable: middleware guards /admin/*.");

const t = createTranslator(brand, coreMessages);
const displayName = user.name?.trim() || user.email.split("@")[0] || t("admin.nav.defaultUser");
const initials = displayName
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join("")
  .toUpperCase();

function isActive(pathname: string, href: string): boolean {
  if (href === "/admin") return pathname === "/admin";
  return pathname === href || pathname.startsWith(`${href}/`);
}

const activePathname = Astro.url.pathname;
const messageLocale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const nav = adminNav.map((item) =>
  item.href === "/admin/orders" && orderCount ? { ...item, badge: String(orderCount) } : item,
);
const navLabel = (item: (typeof adminNav)[number]) =>
  brand.messages?.[`admin.nav.${item.href}`] ?? item.labelByLocale?.[messageLocale] ?? item.label;
const roleLabel = user.role?.[0] ? user.role[0].toUpperCase() + user.role.slice(1) : "";
---

<Layout title={`${title} — ${brand.name}`} siteName={brand.name} lang={brand.locale.toLowerCase().startsWith("id") ? "id" : "en"}>
  <div class="admin-shell" data-admin-shell>
    <aside class="admin-sidebar" id="admin-sidebar" data-sidebar>
      <div class="sidebar-top">
        <a class="admin-brand" href="/admin" aria-label={t("admin.nav.brandDashboard", { brand: brand.name })}>
          {brand.logo?.src ? <img class="brand-logo" src={brand.logo.src} alt={brand.logo.alt ?? brand.name} /> : <span class="brand-mark"><Icon name="logo" size={17} /></span>}
          <span>{brand.name}</span>
        </a>
        <button class="icon-button sidebar-close" type="button" data-sidebar-close aria-label={t("admin.nav.closeMenu")}>
          <Icon name="arrowLeft" />
        </button>
      </div>

      <p class="nav-label">{t("admin.nav.section.store")}</p>
      <nav class="admin-nav" aria-label={t("admin.nav.dashboardAria")}>
        {nav.map((item) => (
          <a href={item.href} aria-current={isActive(activePathname, item.href) ? "page" : undefined}>
            {Array.isArray(item.icon) ? <Icon paths={item.icon} size={17} /> : <Icon name={item.icon} size={17} />}
            <span>{navLabel(item)}</span>
            {item.badge && <span class="nav-badge">{item.badge}</span>}
          </a>
        ))}
      </nav>

      <div class="sidebar-footer">
        <button type="button" data-sign-out><Icon name="logout" size={17} /><span>{t("admin.nav.signOut")}</span></button>
        <p>{t("admin.nav.attribution")}</p>
      </div>
    </aside>

    <div class="sidebar-scrim" data-sidebar-scrim></div>

    <div class="admin-workspace">
      <header class="admin-topbar">
        <button class="icon-button menu-button" type="button" data-sidebar-open aria-controls="admin-sidebar" aria-expanded="false" aria-label={t("admin.nav.openMenu")}><Icon name="menu" /></button>
        <div class="topbar-spacer" aria-hidden="true"></div>
        <div class="topbar-actions">
          <a class="topbar-link" href="/">{brand.locale.toLowerCase().startsWith("id") ? "Lihat toko" : "View store"} ↗</a>
          <button class="icon-button" type="button" data-theme-toggle aria-label={t("admin.nav.theme")}><Icon name="moon" size={17} /></button>
          <div class="profile-chip">
            <span class="profile-copy"><span class="profile-name">{displayName}</span>{roleLabel && <span class="profile-role">{roleLabel}</span>}</span>
            <span class="profile-avatar">{initials}</span>
          </div>
        </div>
      </header>

      <main class="admin-canvas">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script>
  const shell = document.querySelector("[data-admin-shell]");
  const menuButton = document.querySelector<HTMLButtonElement>("[data-sidebar-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
  const openSidebar = () => { shell?.setAttribute("data-sidebar-visible", "true"); menuButton?.setAttribute("aria-expanded", "true"); closeButton?.focus(); };
  const closeSidebar = () => {
    shell?.removeAttribute("data-sidebar-visible");
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.focus();
  };

  document.querySelector("[data-sidebar-open]")?.addEventListener("click", openSidebar);
  document.querySelector("[data-sidebar-close]")?.addEventListener("click", closeSidebar);
  document.querySelector("[data-sidebar-scrim]")?.addEventListener("click", closeSidebar);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && shell?.getAttribute("data-sidebar-visible") === "true") closeSidebar();
  });

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset["theme"] === "dark" ? "light" : "dark";
    document.documentElement.dataset["theme"] = next;
    localStorage.setItem("takontuku-theme", next);
  });

  document.querySelector("[data-sign-out]")?.addEventListener("click", async () => {
    // A plain POST rather than importing @takontuku/auth's client SDK — the
    // admin shell is core, and core doesn't depend on auth (a client could
    // in principle ship its own auth). Better Auth's sign-out is just this
    // one request under the hood, but it needs an actual (even empty) JSON
    // body — a bare content-type header with no body 400s.
    await fetch("/api/auth/sign-out", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: "{}",
    });
    location.href = "/login";
  });
</script>
