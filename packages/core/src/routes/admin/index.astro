---
/// <reference path="../../virtual.d.ts" />
import widgets from "virtual:takontuku/admin-dashboard-widgets";
import StorefrontEmptyCollection from "@takontuku/ui/StorefrontEmptyCollection.astro";
import { brand } from "../../brand";
import { coreMessages, createTranslator } from "../../messages";
import AdminLayout from "../AdminLayout.astro";

const { user } = Astro.locals;
if (!user) throw new Error("Unreachable: middleware guards /admin/*.");
const t = createTranslator(brand, coreMessages);
const displayName =
  user.name?.split(" ")[0] || user.email.split("@")[0] || t("admin.nav.defaultUser");
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const summaryWidgets = widgets.filter((widget) => widget.area === "summary");
const mainWidgets = widgets.filter((widget) => widget.area === "main");
const asideWidgets = widgets.filter((widget) => widget.area === "aside");
---

<AdminLayout title={t("admin.dashboard.title", { brand: brand.name })}>
  <header class="dashboard-heading">
    <div><p class="eyebrow">{brand.name}</p><h1>{t("admin.dashboard.greeting", { name: displayName })}</h1><p>{locale === "id" ? "Ringkasan operasional toko, berdasarkan data yang benar-benar terjadi." : "A clear operational view of what is happening in your store."}</p></div>
    <div class="page-actions"><a class="admin-button admin-button--quiet" href="/">{locale === "id" ? "Lihat toko" : "View store"} ↗</a></div>
  </header>
  {widgets.length > 0 ? (
    <div class="dashboard-layout">
      {summaryWidgets.length > 0 && <div class="dashboard-widgets dashboard-widgets--summary" data-dashboard-area="summary">{summaryWidgets.map(({ component: Widget }) => <Widget />)}</div>}
      {mainWidgets.length > 0 && <div class="dashboard-widgets dashboard-widgets--main" data-dashboard-area="main">{mainWidgets.map(({ component: Widget }) => <Widget />)}</div>}
      {asideWidgets.length > 0 && <aside class="dashboard-widgets dashboard-widgets--aside" data-dashboard-area="aside">{asideWidgets.map(({ component: Widget }) => <Widget />)}</aside>}
    </div>
  ) : (
    <section class="empty-dashboard panel"><StorefrontEmptyCollection eyebrow={locale === "id" ? "Workspace siap" : "Workspace ready"} title={locale === "id" ? "Tambahkan modul untuk mulai bekerja." : "Add a module to start working."} description={locale === "id" ? "Takontuku akan menampilkan area operasional di sini saat Catalog atau Orders dipasang." : "Takontuku will place operational workspaces here when Catalog or Orders is installed."} /></section>
  )}
</AdminLayout>

<style>
  .dashboard-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:1.5rem; margin-bottom:2rem; }.eyebrow { margin:0 0 .5rem; color:var(--tk-color-accent); font-size:.68rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }.dashboard-heading h1 { margin:0; font-family:var(--tk-font-family-display); font-size:clamp(2.5rem,4.2vw,4.3rem); font-weight:400; letter-spacing:-.045em; line-height:.95; }.dashboard-heading p:last-child { max-width:38rem; margin:.7rem 0 0; color:var(--tk-color-fg-muted); font-size:.8rem; }.page-actions { display:flex; gap:.5rem; }.admin-button { display:inline-flex; min-height:2.75rem; align-items:center; padding-inline:1rem; border-radius:var(--tk-radius-sm); font-size:.75rem; font-weight:700; text-decoration:none; }.admin-button--quiet { border:1px solid var(--admin-line); background:var(--admin-surface); }.dashboard-layout { display:grid; gap:1rem; }.dashboard-widgets { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }.dashboard-widgets--summary,.dashboard-widgets--aside { grid-template-columns:1fr; }.dashboard-widgets--aside { align-content:start; }.dashboard-widgets :global([data-dashboard-widget="orders"]) { grid-column:span 2; }.panel { border:1px solid var(--admin-line); border-radius:var(--tk-radius-md); background:var(--admin-surface); }.empty-dashboard { overflow:hidden; }.empty-dashboard :global(.empty-collection) { min-height:28rem; }
  @media (min-width:1000px) { .dashboard-layout:has(.dashboard-widgets--aside) { grid-template-columns:minmax(0,1fr) 20rem; align-items:start; }.dashboard-layout:has(.dashboard-widgets--aside) .dashboard-widgets--summary,.dashboard-layout:has(.dashboard-widgets--aside) .dashboard-widgets--main { grid-column:1; }.dashboard-layout:has(.dashboard-widgets--aside) .dashboard-widgets--aside { grid-column:2; grid-row:1 / span 2; } }
  @media (max-width:800px) { .dashboard-heading { align-items:flex-start; flex-direction:column; }.dashboard-widgets { grid-template-columns:1fr; }.dashboard-widgets :global([data-dashboard-widget="orders"]) { grid-column:auto; } }
</style>
