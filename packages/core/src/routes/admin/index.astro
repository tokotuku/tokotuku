---
import registry from "virtual:tokotuku/registry";
import Icon from "@tokotuku/ui/Icon.astro";
import { topCustomers } from "../../admin-demo";
import { money } from "../../brand";
import AdminLayout from "../AdminLayout.astro";
import AreaChart from "../AreaChart.astro";

const { user } = Astro.locals;
if (!user) throw new Error("Unreachable: middleware guards /admin/*.");

const displayName = user.name?.split(" ")[0] || "there";
---

<AdminLayout title="Dashboard">
  <header class="page-heading dashboard-heading">
    <div><h1>Welcome back, {displayName} <span aria-hidden="true">👋</span></h1></div>
  </header>

  <section class="overview-grid" aria-label="Store overview">
    <article class="panel order-stat">
      <h2>Order Statistics</h2>
      <div class="order-total"><strong>59</strong><span class="status status--success">11%</span></div>
      <p>Total orders · this month</p>
      <div class="order-progress"><i></i><i></i><i></i></div>
      <div class="order-breakdown">
        <div><span class="dot pending"></span><small>Pending</small><strong>24</strong><em>41%</em></div>
        <div><span class="dot shipping"></span><small>Shipping</small><strong>12</strong><em>20%</em></div>
        <div><span class="dot completed"></span><small>Completed</small><strong>23</strong><em>39%</em></div>
      </div>
    </article>

    <article class="panel metric-card">
      <div class="metric-top"><span class="metric-icon blue"><Icon name="reports" size={20} /></span><span class="status status--success">8.2%</span></div>
      <strong>$18,713</strong><p>Available balance</p>
      <svg viewBox="0 0 320 76" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="balance" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2876df" stop-opacity=".28"/><stop offset="1" stop-color="#2876df" stop-opacity="0"/></linearGradient></defs><path d="M0 64 C30 61 34 48 66 50 S95 63 122 43 S157 43 181 46 S208 27 234 25 S271 21 320 7 L320 76 L0 76Z" fill="url(#balance)"/><path d="M0 64 C30 61 34 48 66 50 S95 63 122 43 S157 43 181 46 S208 27 234 25 S271 21 320 7" fill="none" stroke="#2876df" stroke-width="2.2"/></svg>
    </article>

    <article class="panel metric-card">
      <div class="metric-top"><span class="metric-icon green"><Icon name="orders" size={20} /></span><span class="status status--success">23%</span></div>
      <strong>4,732</strong><p>Units sold · MTD</p>
      <svg viewBox="0 0 320 76" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="units" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#11883a" stop-opacity=".25"/><stop offset="1" stop-color="#11883a" stop-opacity="0"/></linearGradient></defs><path d="M0 56 C28 52 39 36 63 47 S88 75 113 44 S143 34 165 45 S190 54 214 25 S250 34 274 25 S299 15 320 10 L320 76 L0 76Z" fill="url(#units)"/><path d="M0 56 C28 52 39 36 63 47 S88 75 113 44 S143 34 165 45 S190 54 214 25 S250 34 274 25 S299 15 320 10" fill="none" stroke="#11883a" stroke-width="2.2"/></svg>
    </article>
  </section>

  <section class="dashboard-main">
    <article class="panel sales-panel">
      <div class="panel-heading"><h2>Sales Performance</h2></div>
      <div class="chart-padding"><AreaChart labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug"]} primary={[3000,1800,3200,4500,3000,6000,5500,5800]} secondary={[2400,1400,2600,3600,2400,4800,4600,4900]} height={390} /></div>
    </article>

    <aside class="panel customer-panel">
      <div class="panel-heading"><h2>Top Customers</h2></div>
      <div class="customer-list">
        {topCustomers.map((customer) => (
          <article>
            <span class="customer-mark" style={`--customer-color:${customer.color}`}>{customer.name.split(" ").map((part) => part[0]).join("").slice(0, 2)}</span>
            <div><strong>{customer.name}</strong><span>{customer.orders} orders</span></div>
            <div class="customer-value"><strong>{money(customer.total)}</strong><span class:list={["status", customer.change >= 0 ? "status--success" : "status--danger"]}>{Math.abs(customer.change)}%</span></div>
          </article>
        ))}
      </div>
    </aside>
  </section>

  <section class="quick-grid">
    <article class="panel quick-card"><span class="metric-icon blue"><Icon name="products" /></span><div><span>Installed modules</span><strong>{registry.moduleNames.length}</strong></div></article>
    <article class="panel quick-card"><span class="metric-icon green"><Icon name="customers" /></span><div><span>Returning customers</span><strong>38%</strong></div></article>
    <article class="panel quick-card"><span class="metric-icon orange"><Icon name="refresh" /></span><div><span>Refund rate</span><strong>2.4%</strong></div></article>
  </section>
</AdminLayout>

<style>
  .dashboard-heading { margin-bottom: 26px; }
  .dashboard-heading h1 { font-size: clamp(29px, 3vw, 34px); font-weight: 520; }
  .overview-grid { display: grid; grid-template-columns: 1fr 1.08fr 1.08fr; gap: 16px; }
  .order-stat, .metric-card { min-height: 280px; padding: 21px; }
  .order-stat h2 { margin: 0; font-size: 16px; }
  .order-total { display: flex; align-items: center; justify-content: space-between; margin-top: 13px; }
  .order-total > strong { font-size: 52px; font-weight: 500; letter-spacing: -.05em; line-height: 1; }
  .order-stat > p, .metric-card > p { margin: 8px 0 0; color: var(--tk-color-fg-muted); font-size: 10px; letter-spacing: .09em; text-transform: uppercase; }
  .order-progress { display: grid; grid-template-columns: 41fr 20fr 39fr; gap: 7px; margin-top: 20px; }
  .order-progress i { height: 16px; border-radius: 6px; background: #f6a006; }
  .order-progress i:nth-child(2) { background: #2876df; }
  .order-progress i:nth-child(3) { background: #059337; }
  .order-breakdown { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 16px; }
  .order-breakdown > div { position: relative; display: flex; flex-direction: column; gap: 3px; padding: 0 12px 0 0; border-right: 1px solid var(--admin-line); }
  .order-breakdown > div:not(:first-child) { padding-left: 14px; }
  .order-breakdown > div:last-child { border-right: 0; }
  .order-breakdown small { padding-left: 12px; color: var(--tk-color-fg-muted); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  .order-breakdown strong { font-size: 26px; font-weight: 500; }
  .order-breakdown em { color: var(--tk-color-fg-muted); font-size: 11px; font-style: normal; }
  .dot { position: absolute; top: 3px; width: 7px; height: 7px; border-radius: 50%; background: #f6a006; }
  .dot.shipping { background: #2876df; }.dot.completed { background: #059337; }
  .metric-card { position: relative; overflow: hidden; }
  .metric-top { display: flex; align-items: center; justify-content: space-between; }
  .metric-icon { display: grid; width: 49px; height: 49px; place-items: center; border-radius: 12px; }
  .metric-icon.blue { background: #deebfd; color: #0873e7; }.metric-icon.green { background: #dcefe2; color: #078a32; }.metric-icon.orange { background: #fff0dc; color: #ca7000; }
  :global([data-theme="dark"]) .metric-icon.blue { background: #223b5f; }:global([data-theme="dark"]) .metric-icon.green { background: #1d422c; }
  .metric-card > strong { display: block; margin-top: 15px; font-size: 47px; font-weight: 500; letter-spacing: -.055em; }
  .metric-card svg { position: absolute; right: 20px; bottom: 20px; left: 20px; width: calc(100% - 40px); height: 76px; }
  .dashboard-main { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(275px, .82fr); gap: 16px; margin-top: 22px; }
  .sales-panel, .customer-panel { min-height: 480px; }
  .chart-padding { padding: 2px 20px 18px; }
  .customer-list { display: grid; padding: 0 16px 9px; }
  .customer-list article { display: grid; grid-template-columns: 42px minmax(0,1fr) auto; align-items: center; gap: 11px; min-height: 63px; }
  .customer-mark { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 11px; background: color-mix(in srgb, var(--customer-color) 22%, var(--admin-surface)); color: var(--customer-color); font-size: 10px; font-weight: 800; }
  .customer-list article strong, .customer-list article span { display: block; }
  .customer-list article strong { font-size: 12px; }.customer-list article > div > span { margin-top: 3px; color: var(--tk-color-fg-muted); font-size: 10px; }
  .customer-value { text-align: right; }.customer-value .status { display: inline-flex; margin-top: 4px; }
  .quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 22px; }
  .quick-card { display: flex; align-items: center; gap: 15px; padding: 18px; }
  .quick-card .metric-icon { width: 43px; height: 43px; }.quick-card span, .quick-card strong { display: block; }.quick-card div > span { color: var(--tk-color-fg-muted); font-size: 11px; }.quick-card strong { margin-top: 3px; font-size: 19px; }
  @media (max-width: 1100px) { .overview-grid { grid-template-columns: 1fr 1fr; }.order-stat { grid-column: 1 / -1; }.dashboard-main { grid-template-columns: 1fr; }.customer-panel { min-height: 0; } }
  @media (max-width: 640px) { .overview-grid, .quick-grid { grid-template-columns: 1fr; }.order-stat { grid-column: auto; }.order-stat, .metric-card { min-height: 260px; }.order-breakdown strong { font-size: 22px; }.metric-card > strong { font-size: 42px; }.chart-padding { padding-inline: 5px; } }
</style>
