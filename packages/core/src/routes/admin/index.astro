---
/// <reference path="../../virtual.d.ts" />
import widgets from "virtual:karsa/admin-dashboard-widgets";
import adminNav from "virtual:karsa/admin-nav";
import registry from "virtual:karsa/registry";
import AdminDashboardArtwork from "@karsa/ui/AdminDashboardArtwork.astro";
import AdminInspector from "@karsa/ui/AdminInspector.astro";
import Icon from "@karsa/ui/Icon.astro";
import InspectorMetric from "@karsa/ui/InspectorMetric.astro";
import { brand } from "../../brand";
import {
  calculateDashboardReadiness,
  type DashboardReadinessStepId,
} from "../../dashboard-readiness";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { coreMessages, createTranslator } from "../../messages";

const { user } = Astro.locals;
if (!user) throw new Error("Unreachable: middleware guards /admin/*.");

const t = createTranslator(brand, coreMessages);
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const displayName =
  user.name?.split(" ")[0] || user.email.split("@")[0] || t("admin.nav.defaultUser");
const summaryWidgets = widgets.filter((widget) => widget.area === "summary");
const mainWidgets = widgets.filter((widget) => widget.area === "main");
const asideWidgets = widgets.filter((widget) => widget.area === "aside");
const moduleLinks = adminNav.filter((item) => item.href !== "/admin");
const installedModules = registry.moduleNames.filter((name) => name !== "core");
const formatModuleName = (name: string) =>
  name.replace(/[-_]+/g, " ").replace(/\b\w/g, (character) => character.toUpperCase());

// The last main contribution is the primary operational surface. Earlier
// contributions stay in the supporting column, so a future widget such as
// Booking naturally stacks without core importing or naming optional modules.
const primaryWidgets = mainWidgets.length > 1 ? mainWidgets.slice(-1) : mainWidgets;
const supportingWidgets = mainWidgets.length > 1 ? mainWidgets.slice(0, -1) : [];
const readiness = calculateDashboardReadiness({
  hasAuthenticatedAdmin: Boolean(user),
  brandName: brand.name,
  hasLogo: typeof brand.logo?.src === "string" && Boolean(brand.logo.src.trim()),
  moduleNames: installedModules,
});
const readinessLabels: Record<DashboardReadinessStepId, string> = {
  admin: t("admin.dashboard.readinessAdmin"),
  brand: t("admin.dashboard.readinessBrand"),
  logo: t("admin.dashboard.readinessLogo"),
};
const nextSteps = [
  ...readiness.steps.filter((step) => !step.complete),
  ...readiness.steps.filter((step) => step.complete).reverse(),
].slice(0, 3);
const artwork = brand.admin?.dashboardArtwork ?? "abstract";

import "../../styles/routes/core-admin-dashboard.css";
---

<AdminLayout title={t("admin.dashboard.title", { brand: brand.name })}>
  {widgets.length > 0 && (
    <>
      <header class="dashboard-populated-intro">
        <div class="dashboard-populated-copy">
          <p class="eyebrow">{brand.name}</p>
          <h1>{t("admin.dashboard.greeting", { name: displayName })}</h1>
          <p>{t("admin.dashboard.description")}</p>
        </div>
        <AdminDashboardArtwork artwork={artwork} class="dashboard-populated-art" />
      </header>

      <section class="dashboard-summary dashboard-summary--compact" aria-label={t("admin.dashboard.activeModules")}>
        <article class="dashboard-summary-card dashboard-summary-card--modules">
          <span class="dashboard-summary-icon" aria-hidden="true"><Icon name="dashboard" size={20} /></span>
          <div>
            <p>{t("admin.dashboard.activeModules")}</p>
            <strong>{installedModules.length}</strong>
            <div class="dashboard-module-chips">
              {installedModules.map((moduleName) => <span>{formatModuleName(moduleName)}</span>)}
            </div>
          </div>
        </article>
      </section>

      {summaryWidgets.length > 0 && <div class="dashboard-widgets dashboard-widgets--summary" data-dashboard-area="summary">{summaryWidgets.map(({ component: Widget }) => <Widget />)}</div>}

      <div class:list={[
        "dashboard-operational-grid",
        { "dashboard-operational-grid--single": mainWidgets.length === 0 || supportingWidgets.length === 0 },
      ]} data-dashboard-area="main" data-dashboard-layout="operational-split">
        {mainWidgets.length > 0 && <section class="dashboard-primary-column" data-dashboard-column="primary">
          {primaryWidgets.map(({ component: Widget }) => <Widget />)}
        </section>}
        {supportingWidgets.length > 0 && (
          <aside class="dashboard-supporting-column" data-dashboard-column="supporting">
            {supportingWidgets.map(({ component: Widget }) => <Widget />)}
          </aside>
        )}
      </div>
    </>
  )}
  {widgets.length === 0 && (
    <div class="dashboard-empty-state">
      <section class="dashboard-empty-hero" aria-labelledby="dashboard-empty-title">
        <div class="dashboard-empty-copy">
          <header class="dashboard-empty-welcome">
            <p class="eyebrow">{t("admin.dashboard.welcomeEyebrow")}</p>
            <h1 id="dashboard-empty-title">{t("admin.dashboard.greeting", { name: displayName })}</h1>
            <p>{t("admin.dashboard.description")}</p>
          </header>
          <div class="dashboard-empty-start">
            <h2>{t("admin.dashboard.workspaceStartTitle")}</h2>
            <p>{t("admin.dashboard.workspaceStartDescription")}</p>
            <div class="dashboard-installed-modules"><span>{t("admin.dashboard.installedModules")}</span><div>{installedModules.map((moduleName) => <b>{formatModuleName(moduleName)}</b>)}</div></div>
          </div>
        </div>
        <AdminDashboardArtwork artwork={artwork} class="dashboard-empty-art" />
      </section>

      <section class="dashboard-next-steps panel" aria-labelledby="dashboard-next-steps-empty-title">
        <div class="panel-heading"><div><p class="eyebrow">{t("admin.dashboard.setup")}</p><h2 id="dashboard-next-steps-empty-title">{t("admin.dashboard.nextSteps")}</h2></div></div>
        <ol class="dashboard-readiness-list dashboard-readiness-list--horizontal">
          {nextSteps.map((step) => <li class:list={{ "is-complete": step.complete }} data-readiness-step={step.id}><span class="readiness-check" aria-hidden="true"><Icon name="check" size={13} /></span><span>{readinessLabels[step.id]}</span></li>)}
        </ol>
        {moduleLinks.length > 0 ? <div class="dashboard-module-links">{moduleLinks.map((item) => <a href={item.href}><span>{item.labelByLocale?.[locale] ?? item.label}</span><span aria-hidden="true">↗</span></a>)}</div> : <p class="dashboard-empty-hint">{t("admin.dashboard.addModuleHint")}</p>}
      </section>
    </div>
  )}

  <Fragment slot="inspector">
    <AdminInspector title="Workspace" description={t("admin.dashboard.inspectorDescription")}>
      <div class="inspector-metrics"><InspectorMetric label={t("admin.dashboard.installedModules")} value={String(installedModules.length)} /><InspectorMetric label={t("admin.dashboard.locale")} value={locale.toUpperCase()} /><InspectorMetric label={t("admin.dashboard.role")} value={user.role ?? "—"} /></div>
    </AdminInspector>
    {asideWidgets.map(({ component: Widget }) => <Widget />)}
    <AdminInspector title={t("admin.dashboard.identity")}>
      <dl class="inspector-list">{brand.currency && <div><dt>{t("admin.dashboard.currency")}</dt><dd>{brand.currency}</dd></div>}<div><dt>{t("admin.dashboard.timeZone")}</dt><dd>{brand.timeZone}</dd></div></dl>
    </AdminInspector>
  </Fragment>
</AdminLayout>
