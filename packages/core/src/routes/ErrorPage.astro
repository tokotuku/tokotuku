---
import Icon from "@takontuku/ui/Icon.astro";
import Layout from "@takontuku/ui/Layout.astro";
import { brand } from "../brand";
import { coreMessages, createTranslator } from "../messages";

interface Props {
  code: 403 | 404;
}

const { code } = Astro.props;
const forbidden = code === 403;
const t = createTranslator(brand, coreMessages);
---

<Layout title={`${code} — ${brand.name}`} siteName={brand.name} lang={brand.locale.toLowerCase().startsWith("id") ? "id" : "en"}>
  <main class="error-page">
    <button type="button" data-error-theme aria-label={t("admin.nav.theme")}><Icon name="moon" size={17} /></button>
    <section>
      <a class="error-brand" href="/"><Icon name="logo" size={18} /> {brand.name}</a>
      <div class:list={["error-icon", forbidden ? "error-icon--warning" : ""]}><Icon name={forbidden ? "lock" : "search"} size={26} /></div>
      <p class="error-code">{code}</p>
      <h1>{t(forbidden ? "admin.error.forbiddenTitle" : "admin.error.notFoundTitle")}</h1>
      <p>{t(forbidden ? "admin.error.forbiddenDescription" : "admin.error.notFoundDescription")}</p>
      <a class="error-primary" href={forbidden ? "/admin" : "/"}><Icon name="dashboard" size={16} /> {t(forbidden ? "admin.error.backDashboard" : "admin.error.backHome")}</a>
      <a class="error-secondary" href={forbidden ? "/login" : "mailto:support@takontuku.dev"}>{t(forbidden ? "admin.error.switchAccount" : "admin.error.contactSupport")}</a>
    </section>
  </main>
</Layout>

<script>
  document.querySelector("[data-error-theme]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset["theme"] === "dark" ? "light" : "dark";
    document.documentElement.dataset["theme"] = next;
    localStorage.setItem("takontuku-theme", next);
  });
</script>

<style>
  .error-page { position: relative; display: grid; min-height: 100vh; place-items: center; padding: 24px; background: var(--tk-color-bg); color: var(--tk-color-fg); text-align: center; }
  .error-page > button { position: absolute; top: 24px; right: 24px; display: grid; width: 40px; height: 40px; place-items: center; border: 0; border-radius: 9px; background: transparent; color: inherit; cursor: pointer; }
  section { display: flex; width: min(100%, 430px); flex-direction: column; align-items: center; }
  .error-brand { display: inline-flex; align-items: center; gap: 9px; margin-bottom: 67px; color: inherit; font-size: 18px; font-weight: var(--tk-font-weight-bold); text-decoration: none; }
  .error-icon { display: grid; width: 64px; height: 64px; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--tk-color-accent) 14%, var(--tk-color-bg)); color: var(--tk-color-accent); }
  .error-icon--warning { background: color-mix(in srgb, var(--tk-color-warning) 16%, var(--tk-color-bg)); color: var(--tk-color-warning); }
  .error-code { margin: 13px 0 -4px; color: var(--tk-color-fg-muted); font-size: 11px; font-weight: var(--tk-font-weight-bold); letter-spacing: .16em; }
  h1 { margin: 16px 0 0; font-size: 17px; }
  section > p:not(.error-code) { max-width: 390px; margin: 9px 0 19px; color: var(--tk-color-fg-muted); font-size: 14px; line-height: 1.45; }
  .error-primary { display: inline-flex; min-height: 40px; align-items: center; gap: 8px; padding: 0 14px; border: 1px solid var(--tk-color-accent); border-radius: var(--tk-radius-md); background: var(--tk-color-accent); color: var(--tk-color-accent-fg); font-size: 13px; font-weight: var(--tk-font-weight-semibold); text-decoration: none; }
  .error-secondary { margin-top: 14px; color: inherit; font-size: 13px; font-weight: var(--tk-font-weight-semibold); text-decoration: none; }
</style>
