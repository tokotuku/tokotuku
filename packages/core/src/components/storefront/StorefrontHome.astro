---
/// <reference path="../../virtual.d.ts" />
import registry from "virtual:takontuku/registry";
import homeSections from "virtual:takontuku/storefront-home-sections";
import Layout from "@takontuku/ui/DocumentLayout.astro";
import Icon from "@takontuku/ui/Icon.astro";
import StoreFooter from "@takontuku/ui/StoreFooter.astro";
import StorefrontHero from "@takontuku/ui/StorefrontHero.astro";
import StoreHeader from "@takontuku/ui/StoreHeader.astro";
import { brand } from "../../brand";
import { coreMessages, createTranslator } from "../../messages";

const t = createTranslator(brand, coreMessages);
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const hasCatalog = registry.moduleNames.includes("catalog");
const hasOrders = registry.moduleNames.includes("orders");
const hero = brand.storefront?.hero;
const catalogFooterLink = {
  label: locale === "id" ? "Semua produk" : "All products",
  href: "/products",
};
const footerLinks = [
  ...(hasCatalog ? [catalogFooterLink] : []),
  ...(brand.storefront?.links ?? []),
];

import "../../styles/routes/core-storefront-home.css";
---

<Layout title={brand.name} description={hero?.description ?? t("storefront.hero.description")} siteName={brand.name} lang={locale} image={hero?.image} palette={brand.palette}>
  <StoreHeader
    brand={brand}
    current="home"
    showShop={hasCatalog}
    showCart={hasOrders}
    showAdmin={false}
    announcement={brand.storefront?.announcement ?? t("storefront.announcement")}
    links={brand.storefront?.links}
    labels={{
      home: locale === "id" ? "Beranda" : "Home",
      shop: locale === "id" ? "Toko" : "Shop",
      account: locale === "id" ? "Akun" : "Account",
      search: locale === "id" ? "Cari" : "Search",
      cart: locale === "id" ? "Keranjang" : "Cart",
      theme: locale === "id" ? "Ganti tema" : "Toggle theme",
      openMenu: locale === "id" ? "Buka menu" : "Open menu",
      closeMenu: locale === "id" ? "Tutup menu" : "Close menu",
      navigation: locale === "id" ? "Navigasi toko" : "Store navigation",
    }}
  />
  <main>
    <StorefrontHero
      eyebrow={hero?.eyebrow ?? t("storefront.hero.eyebrow")}
      title={hero?.title ?? t("storefront.hero.title")}
      description={hero?.description ?? t("storefront.hero.description")}
      primaryHref={hasCatalog ? "/products" : undefined}
      primaryLabel={t("storefront.hero.cta")}
      image={hero?.image}
      imagePosition={hero?.imagePosition}
    />
    {homeSections.map(({ component: HomeSection }) => <HomeSection />)}
    <section class="value-strip" aria-label="Takontuku values">
      <article><Icon name="leaf" size={24} /><div><strong>{t("storefront.values.materials")}</strong><span>{t("storefront.values.materialsHint")}</span></div></article>
      <article><Icon name="heart" size={24} /><div><strong>{t("storefront.values.care")}</strong><span>{t("storefront.values.careHint")}</span></div></article>
      <article><Icon name="box" size={24} /><div><strong>{t("storefront.values.simple")}</strong><span>{t("storefront.values.simpleHint")}</span></div></article>
      <article><Icon name="sun" size={24} /><div><strong>{t("storefront.values.choice")}</strong><span>{t("storefront.values.choiceHint")}</span></div></article>
    </section>
  </main>
  <StoreFooter
    brandName={brand.name}
    tagline={t("storefront.footer.tagline")}
    links={footerLinks}
    newsletterAction={brand.storefront?.newsletter?.action}
    newsletterLabel={t("storefront.footer.newsletterLabel")}
    newsletterHint={t("storefront.footer.newsletterHint")}
    newsletterEmailLabel={t("storefront.footer.newsletterEmail")}
    newsletterSubmit={t("storefront.footer.newsletterSubmit")}
    navigationLabel={t("storefront.footer.navigation")}
    madeWith={t("storefront.footer.madeWith")}
  />
</Layout>
