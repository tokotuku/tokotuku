---
import BrandMark from "@takontuku/ui/BrandMark.astro";
import Layout from "@takontuku/ui/DocumentLayout.astro";
import Icon from "@takontuku/ui/Icon.astro";
import { brand } from "../../brand";
import { coreMessages, createTranslator } from "../../messages";

interface Props {
  code: 403 | 404;
}

const { code } = Astro.props;
const forbidden = code === 403;
const t = createTranslator(brand, coreMessages);

import "../../styles/routes/core-error.css";
---

<Layout title={`${code} — ${brand.name}`} siteName={brand.name} lang={brand.locale.toLowerCase().startsWith("id") ? "id" : "en"}>
  <main class="error-page">
    <button type="button" data-error-theme aria-label={t("admin.nav.theme")}><Icon name="moon" size={17} /></button>
    <section>
      <a class="error-brand" href="/"><BrandMark size={28} /> {brand.name}</a>
      <div class:list={["error-icon", forbidden ? "error-icon--warning" : ""]}><Icon name={forbidden ? "lock" : "search"} size={26} /></div>
      <p class="error-code">{code}</p>
      <h1>{t(forbidden ? "admin.error.forbiddenTitle" : "admin.error.notFoundTitle")}</h1>
      <p>{t(forbidden ? "admin.error.forbiddenDescription" : "admin.error.notFoundDescription")}</p>
      <a class="error-primary" href={forbidden ? "/admin" : "/"}><Icon name="dashboard" size={16} /> {t(forbidden ? "admin.error.backDashboard" : "admin.error.backHome")}</a>
      <a class="error-secondary" href={forbidden ? "/login" : "mailto:support@takontuku.dev"}>{t(forbidden ? "admin.error.switchAccount" : "admin.error.contactSupport")}</a>
    </section>
  </main>
</Layout>

<script>
  document.querySelector("[data-error-theme]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset["theme"] === "dark" ? "light" : "dark";
    document.documentElement.dataset["theme"] = next;
    localStorage.setItem("takontuku-theme", next);
  });
</script>
