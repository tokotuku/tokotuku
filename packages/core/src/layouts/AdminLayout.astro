---
import "@karsa/theme/admin.css";
import "./AdminLayout.css";
import adminNav from "virtual:karsa/admin-nav";
import BrandMark from "@karsa/ui/BrandMark.astro";
import DocumentLayout from "@karsa/ui/DocumentLayout.astro";
import Icon from "@karsa/ui/Icon.astro";
import { brand } from "../brand";
import { coreMessages, createTranslator } from "../messages";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { user } = Astro.locals;
if (!user) throw new Error("Unreachable: middleware guards /admin/*.");
const hasInspector = Astro.slots.has("inspector");

const t = createTranslator(brand, coreMessages);
const displayName = user.name?.trim() || user.email.split("@")[0] || t("admin.nav.defaultUser");
const initials = displayName
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join("")
  .toUpperCase();

function isActive(pathname: string, href: string): boolean {
  if (href === "/admin") return pathname === "/admin";
  return pathname === href || pathname.startsWith(`${href}/`);
}

const activePathname = Astro.url.pathname;
const messageLocale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const nav = adminNav;
const navLabel = (item: (typeof adminNav)[number]) =>
  brand.messages?.[`admin.nav.${item.href}`] ?? item.labelByLocale?.[messageLocale] ?? item.label;
const roleLabel = user.role?.[0] ? user.role[0].toUpperCase() + user.role.slice(1) : "";
---

<DocumentLayout title={`${title} — ${brand.name}`} siteName={brand.name} lang={brand.locale.toLowerCase().startsWith("id") ? "id" : "en"} palette={brand.palette}>
  <div class="admin-shell" data-admin-shell>
    <aside class="admin-sidebar" id="admin-sidebar" data-sidebar>
      <div class="sidebar-top">
        <a class="admin-brand" href="/admin" aria-label={t("admin.nav.brandDashboard", { brand: brand.name })}>
          {brand.logo?.src ? <img class="brand-logo" src={brand.logo.src} alt={brand.logo.alt ?? brand.name} /> : <span class="brand-mark"><BrandMark size={24} /></span>}
          <span>{brand.name}</span>
        </a>
        <button class="icon-button sidebar-close" type="button" data-sidebar-close aria-label={t("admin.nav.closeMenu")}>
          <Icon name="arrowLeft" />
        </button>
      </div>

      <label class="nav-search">
        <Icon name="search" size={15} />
        <span class="sr-only">{t("admin.nav.search")}</span>
        <input type="search" placeholder={t("admin.nav.searchPlaceholder")} data-nav-search />
        <kbd>⌘K</kbd>
      </label>

      <p class="nav-label">{brand.locale.toLowerCase().startsWith("id") ? "Situs" : "Site"}</p>
      <nav class="admin-nav" aria-label={t("admin.nav.dashboardAria")}>
        {nav.map((item) => (
          <a href={item.href} data-nav-item data-nav-label={navLabel(item)} aria-current={isActive(activePathname, item.href) ? "page" : undefined}>
            {Array.isArray(item.icon) ? <Icon paths={item.icon} size={17} /> : <Icon name={item.icon} size={17} />}
            <span>{navLabel(item)}</span>
            {item.badge && <span class="nav-badge">{item.badge}</span>}
          </a>
        ))}
      </nav>

      <div class="sidebar-footer">
        <div class="profile-menu" data-profile-menu>
          <button class="profile-trigger" type="button" data-profile-toggle aria-expanded="false" aria-haspopup="menu">
            <span class="profile-avatar">{initials}</span>
            <span class="profile-copy"><span class="profile-name">{displayName}</span>{roleLabel && <span class="profile-role">{roleLabel}</span>}</span>
            <Icon name="chevronDown" size={15} />
          </button>
          <div class="profile-popover" data-profile-popover hidden>
            <button type="button" data-sign-out><Icon name="logout" size={16} /><span>{t("admin.nav.signOut")}</span></button>
          </div>
        </div>
      </div>
    </aside>

    <div class="sidebar-scrim" data-sidebar-scrim></div>

    <div class="admin-workspace">
      <header class="admin-topbar">
        <button class="icon-button menu-button" type="button" data-sidebar-open aria-controls="admin-sidebar" aria-expanded="false" aria-label={t("admin.nav.openMenu")}><Icon name="menu" /></button>
        <div class="topbar-spacer" aria-hidden="true"></div>
        <div class="topbar-actions">
          <a class="topbar-link" href="/">{brand.locale.toLowerCase().startsWith("id") ? "Lihat situs" : "View site"} ↗</a>
          {hasInspector && <button class="inspector-open" type="button" data-inspector-open aria-controls="admin-inspector" aria-expanded="false" aria-label={brand.locale.toLowerCase().startsWith("id") ? "Buka ringkasan" : "Open summary"}><Icon name="reports" size={16} /></button>}
          <button class="icon-button" type="button" data-theme-toggle aria-label={t("admin.nav.theme")}><Icon name="moon" size={17} /></button>
        </div>
      </header>

      <div class:list={["admin-layout-grid", { "admin-layout-grid--inspector": hasInspector }]}>
        <main class="admin-canvas">
          <slot />
        </main>
        {hasInspector && <aside class="admin-inspector" id="admin-inspector" data-admin-inspector aria-label={brand.locale.toLowerCase().startsWith("id") ? "Ringkasan halaman" : "Page summary"}>
          <div class="inspector-heading">
            <span>{brand.locale.toLowerCase().startsWith("id") ? "Ringkasan" : "Summary"}</span>
            <button class="icon-button inspector-close" type="button" data-inspector-close aria-label={brand.locale.toLowerCase().startsWith("id") ? "Tutup ringkasan" : "Close summary"}><Icon name="arrowRight" size={16} /></button>
          </div>
          <slot name="inspector" />
        </aside>}
      </div>
    </div>
  </div>
</DocumentLayout>

<script>
  const shell = document.querySelector("[data-admin-shell]");
  const menuButton = document.querySelector<HTMLButtonElement>("[data-sidebar-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
  const openSidebar = () => { shell?.setAttribute("data-sidebar-visible", "true"); menuButton?.setAttribute("aria-expanded", "true"); closeButton?.focus(); };
  const closeSidebar = () => {
    shell?.setAttribute("data-sidebar-visible", "false");
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.focus();
  };

  document.querySelector("[data-sidebar-open]")?.addEventListener("click", openSidebar);
  document.querySelector("[data-sidebar-close]")?.addEventListener("click", closeSidebar);
  document.querySelector("[data-sidebar-scrim]")?.addEventListener("click", closeSidebar);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && shell?.getAttribute("data-sidebar-visible") === "true") closeSidebar();
  });

  const inspector = document.querySelector<HTMLElement>("[data-admin-inspector]");
  const inspectorButton = document.querySelector<HTMLButtonElement>("[data-inspector-open]");
  const closeInspector = () => {
    inspector?.removeAttribute("data-inspector-visible");
    shell?.removeAttribute("data-inspector-visible");
    inspectorButton?.setAttribute("aria-expanded", "false");
    inspectorButton?.focus();
  };
  const openInspector = () => {
    inspector?.setAttribute("data-inspector-visible", "true");
    shell?.setAttribute("data-inspector-visible", "true");
    inspectorButton?.setAttribute("aria-expanded", "true");
    inspector?.querySelector<HTMLButtonElement>("[data-inspector-close]")?.focus();
  };
  const toggleInspector = () => {
    if (inspector?.getAttribute("data-inspector-visible") === "true") closeInspector();
    else openInspector();
  };
  inspectorButton?.addEventListener("click", toggleInspector);
  inspector?.querySelector("[data-inspector-close]")?.addEventListener("click", closeInspector);

  const profileToggle = document.querySelector<HTMLButtonElement>("[data-profile-toggle]");
  const profilePopover = document.querySelector<HTMLElement>("[data-profile-popover]");
  profileToggle?.addEventListener("click", () => {
    const open = profilePopover?.hasAttribute("hidden") ?? true;
    if (open) profilePopover?.removeAttribute("hidden"); else profilePopover?.setAttribute("hidden", "");
    profileToggle.setAttribute("aria-expanded", String(open));
  });

  const navSearch = document.querySelector<HTMLInputElement>("[data-nav-search]");
  const navItems = Array.from(document.querySelectorAll<HTMLElement>("[data-nav-item]"));
  const filterNav = () => {
    const query = navSearch?.value.trim().toLocaleLowerCase() ?? "";
    navItems.forEach((item) => { item.hidden = Boolean(query) && !(item.dataset["navLabel"] ?? "").toLocaleLowerCase().includes(query); });
  };
  navSearch?.addEventListener("input", filterNav);
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") { event.preventDefault(); navSearch?.focus(); }
    if (event.key === "Escape") {
      if (inspector?.getAttribute("data-inspector-visible") === "true") closeInspector();
      if (profilePopover && !profilePopover.hasAttribute("hidden")) { profilePopover.setAttribute("hidden", ""); profileToggle?.setAttribute("aria-expanded", "false"); }
      if (navSearch?.value) { navSearch.value = ""; filterNav(); }
    }
  });

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset["theme"] === "dark" ? "light" : "dark";
    document.documentElement.dataset["theme"] = next;
    localStorage.setItem("karsa-theme", next);
  });

  document.querySelector("[data-sign-out]")?.addEventListener("click", async () => {
    // A plain POST rather than importing @karsa/auth's client SDK — the
    // admin shell is core, and core doesn't depend on auth (a client could
    // in principle ship its own auth). Better Auth's sign-out is just this
    // one request under the hood, but it needs an actual (even empty) JSON
    // body — a bare content-type header with no body 400s.
    await fetch("/api/auth/sign-out", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: "{}",
    });
    location.href = "/login";
  });
</script>
