{
  "name": "@takontuku/core",
  "version": "0.2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "takontuku": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": "./src/middleware.ts",
    "./brand": "./src/brand.ts",
    "./components/*": "./src/components/*",
    "./routes/*": "./src/routes/*",
    "./layouts/*": "./src/layouts/*",
    "./virtual.d.ts": "./src/virtual.d.ts",
    "./cloudflare-workers.d.ts": "./src/cloudflare-workers.d.ts",
    "./app-locals.d.ts": "./src/app-locals.d.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@takontuku/theme": "^0.2.0",
    "@takontuku/ui": "^0.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260710.1",
    "@takontuku/config": "^0.2.0",
    "astro": "^7.0.9",
    "vite": "^8.1.4"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "astro": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "astro check"
  }
}
