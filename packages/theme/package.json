{
  "name": "@tokotuku/theme",
  "version": "0.0.0",
  "description": "Light, dark, and high-contrast themes for Tokotuku UI, expressed as CSS custom properties built from @tokotuku/tokens.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@tokotuku/tokens": "workspace:*"
  },
  "devDependencies": {
    "@tokotuku/config": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
