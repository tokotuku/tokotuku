---
import { env } from "cloudflare:workers";
import registry from "virtual:takontuku/registry";
import { createTranslator, mediaUrl } from "@takontuku/core";
import { brand, money } from "@takontuku/core/brand";
import Layout from "@takontuku/ui/DocumentLayout.astro";
import StoreHeader from "@takontuku/ui/StoreHeader.astro";
import { catalogMessages } from "../../messages";
import { findProductById } from "../../products";

const id = Number(Astro.params["id"]);
const product = await findProductById(env.DB, id);
if (!product) return new Response("Product not found", { status: 404 });
const t = createTranslator(brand, catalogMessages);
const hasOrders = registry.moduleNames.includes("orders");
// A scheduled item is booked, not carted or stocked — capability-checked by
// name only, same as hasOrders above, so catalog never imports
// @takontuku/booking and stays installable without it.
const isPhysical = product.fulfillmentType === "physical";
const hasBooking = registry.moduleNames.includes("booking");
const imageUrl = mediaUrl(product.imageKey);
const serialized = JSON.stringify({
  id: product.id,
  name: product.name,
  priceCents: product.priceCents,
  imageUrl,
});
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  sku: product.sku,
  category: product.category,
  image: new URL(imageUrl, Astro.url.origin).toString(),
  offers: {
    "@type": "Offer",
    url: new URL(Astro.url.pathname, Astro.url.origin).toString(),
    priceCurrency: brand.currency,
    price: (product.priceCents / 100).toFixed(2),
    availability:
      !isPhysical || product.stock > 0
        ? "https://schema.org/InStock"
        : "https://schema.org/OutOfStock",
  },
};

import "../../styles/routes/catalog-product-detail.css";
---

<Layout title={product.name + " — " + brand.name} description={product.description} image={imageUrl} type="product" jsonLd={productJsonLd} siteName={brand.name} lang={locale}>
  <StoreHeader current="products" brand={brand} showCart={hasOrders} announcement={brand.storefront?.announcement ?? (locale === "id" ? "Objek untuk ritual sehari-hari." : "Objects for everyday rituals.")} labels={{ home: t("catalog.detail.home"), shop: t("catalog.detail.shop"), cart: locale === "id" ? "Keranjang" : "Cart" }} />
  <main>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">{t("catalog.detail.home")}</a><span>/</span><a href="/products">{t("catalog.detail.shop")}</a><span>/</span><span>{product.name}</span></nav>
    <div class="product-detail">
      <div class="media"><img src={imageUrl} alt={product.name} /></div>
      <section class="product-copy"><p class="eyebrow">{product.category}</p><h1>{product.name}</h1><p class="price">{money(product.priceCents / 100)}</p><p class="description">{product.description}</p>{isPhysical ? <><p class:list={["stock", product.stock <= 5 && "stock--low"]}>{product.stock > 0 ? t("catalog.detail.inStock", { count: product.stock }) : t("catalog.detail.outOfStock")}</p>{hasOrders && <button type="button" data-add-to-cart data-product={serialized} disabled={product.stock <= 0}>{product.stock > 0 ? t("catalog.detail.add") : t("catalog.detail.soldOut")}</button>}</> : hasBooking && <a class="book-now" href={`/booking/${product.id}`}>{t("catalog.detail.bookNow")}</a>}{Object.keys(product.customFields).length > 0 && <dl>{Object.entries(product.customFields).map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}</dl>}{isPhysical && hasOrders && <ul><li>{t("catalog.detail.cash")}</li><li>{t("catalog.detail.reassurance")}</li></ul>}</section>
    </div>
  </main>
</Layout>
