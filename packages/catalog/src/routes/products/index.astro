---
import { env } from "cloudflare:workers";
import registry from "virtual:karsa/registry";
import { mediaUrl } from "@karsa/core";
import { brand, money } from "@karsa/core/brand";
import CatalogEmptyState from "@karsa/ui/CatalogEmptyState.astro";
import Layout from "@karsa/ui/DocumentLayout.astro";
import Pagination from "@karsa/ui/Pagination.astro";
import ProductCard from "@karsa/ui/ProductCard.astro";
import SiteHeader from "@karsa/ui/SiteHeader.astro";
import Tabs from "@karsa/ui/Tabs.astro";
import { countItems, listCategories, listItems } from "../../catalog-items";
import { createCatalogTranslator } from "../../messages";

const presentation =
  registry.clientConfig["catalog"]?.["presentation"] === "services" ? "services" : "products";
const services = presentation === "services";
const t = createCatalogTranslator(brand, presentation);
const publicBase = services ? "/services" : "/products";
const adminBase = services ? "/admin/services" : "/admin/products";
const hasOrders = registry.clientConfig["orders"]?.["presentation"] === "orders";
const category = Astro.url.searchParams.get("category") || undefined;
const search = Astro.url.searchParams.get("q") || undefined;
const page = Math.max(1, Math.trunc(Number(Astro.url.searchParams.get("page"))) || 1);
const PAGE_SIZE = 12;
const [productPage, totalCount, catalogCount, categories] = await Promise.all([
  listItems(env.DB, {
    category,
    search,
    pageSize: PAGE_SIZE,
    offset: (page - 1) * PAGE_SIZE,
    presentation,
  }),
  countItems(env.DB, { category, search, presentation }),
  countItems(env.DB, { presentation }),
  listCategories(env.DB, presentation),
]);
const products = productPage.items;
const emptyCatalog = catalogCount === 0;
const noMatch = !emptyCatalog && totalCount === 0;
const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const localized = (idText: string, enText: string) => (locale === "id" ? idText : enText);
const pageTitle = services ? localized("Layanan", "Services") : t("catalog.products.title");
const canManage = Astro.locals.canAccessBackoffice;
const searchLabel = t("catalog.products.search");
const navigationLinks = [{ label: pageTitle, href: publicBase, current: true }];
const headerActions = [
  { label: localized("Akun", "Account"), href: "/login", icon: "user" },
  ...(hasOrders
    ? [{ label: localized("Keranjang", "Cart"), href: "/cart", icon: "cart", badge: true }]
    : []),
];
const emptyEyebrow = services ? pageTitle : t("catalog.storefront.eyebrow");
const emptyTitle = services
  ? localized("Layanan segera hadir", "Services are coming")
  : t("catalog.storefront.emptyTitle");
const defaultEmptyDescription = canManage
  ? t("catalog.storefront.emptyStaffDescription")
  : t("catalog.storefront.emptyDescription");
const emptyDescription = services
  ? localized(
      "Tim sedang menyiapkan layanan yang dapat kamu ajukan.",
      "The team is preparing services you can request.",
    )
  : defaultEmptyDescription;
let emptyActionLabel: string | undefined;
if (canManage)
  emptyActionLabel = services
    ? localized("Tambah layanan", "Add service")
    : t("catalog.storefront.addFirst");
const listingHeading = services
  ? localized("Temukan layanan yang tepat", "Find the right service")
  : t("catalog.storefront.title");
const itemViewLabel = services
  ? localized("Lihat layanan", "View service")
  : t("catalog.products.view");
const categoryHref = (target?: string) => {
  const params = new URLSearchParams();
  if (target) params.set("category", target);
  if (search) params.set("q", search);
  return params.toString() ? `${publicBase}?${params.toString()}` : publicBase;
};
const tabItems = [
  { label: t("catalog.products.all"), href: categoryHref(), active: !category },
  ...categories.map((item) => ({
    label: item,
    href: categoryHref(item),
    active: category === item,
  })),
];
const paginationParams = new URLSearchParams();
if (category) paginationParams.set("category", category);
if (search) paginationParams.set("q", search);
const paginationBase = `${publicBase}?${paginationParams.toString()}${paginationParams.toString() ? "&" : ""}page=`;
const pageDescription = services
  ? localized(
      "Pilih layanan dan ajukan jadwal yang sesuai.",
      "Choose a service and request a suitable schedule.",
    )
  : t("catalog.storefront.description");

import "../../styles/routes/catalog-products.css";
---

<Layout title={pageTitle + " — " + brand.name} description={pageDescription} siteName={brand.name} lang={locale}>
  <SiteHeader current={presentation} brand={brand} links={navigationLinks} actions={headerActions} searchAction={publicBase} showSearch={true} announcement={brand.site?.announcement ?? false} labels={{ home: localized("Beranda", "Home"), search: searchLabel, navigation: localized("Navigasi situs", "Site navigation") }} />
  {emptyCatalog && (
    <main data-catalog-empty="true"><CatalogEmptyState eyebrow={emptyEyebrow} title={emptyTitle} description={emptyDescription} actionHref={canManage ? `${adminBase}/new` : undefined} actionLabel={emptyActionLabel} /></main>
  )}
  {!emptyCatalog && (
    <main data-catalog-listing="true">
      <header class="listing-heading"><div><p class="eyebrow">{pageTitle}</p><h1>{listingHeading}</h1><p>{services ? pageDescription : t("catalog.products.description", { count: catalogCount, categories: categories.length })}</p></div></header>
      <Tabs items={tabItems} label={t("catalog.products.categoryFilter")} />
      <form method="get" class="search-form"><label for="catalog-search">{t("catalog.products.search")}</label><div><input id="catalog-search" type="search" name="q" value={search ?? ""} placeholder={t("catalog.products.searchPlaceholder")} />{category && <input type="hidden" name="category" value={category} />}<button type="submit">{t("catalog.products.searchSubmit")}</button></div></form>
      {noMatch && (
        <section class="no-match" data-catalog-no-match><p class="eyebrow">{t("catalog.products.noSearchResult")}</p><h2>{t("catalog.products.noMatch")}</h2><p>{t("catalog.products.noMatchDescription")}</p><a href={publicBase}>{t("catalog.products.reset")} ↗</a></section>
      )}
      {!noMatch && (
        <div class="product-grid">{products.map((product) => { const isPhysical = product.fulfillmentType === "physical"; const itemPrice = product.priceCents === null ? localized("Hubungi kami", "Request a quote") : money(product.priceCents / 100); return <ProductCard id={product.id} href={`${publicBase}/${product.id}`} name={product.name} description={product.description} price={itemPrice} priceCents={product.priceCents} imageUrl={mediaUrl(product.imageKey)} stock={product.stock} showStock={isPhysical} showAddToCart={hasOrders && isPhysical} category={product.category} labels={{ view: itemViewLabel, add: t("catalog.products.addToCart"), soldOut: t("catalog.products.status.outOfStock"), lowStock: t("catalog.products.fewLeft") }} />; })}</div>
      )}
      {totalPages > 1 && <Pagination page={page} totalPages={totalPages} baseUrl={paginationBase} />}
    </main>
  )}
</Layout>
