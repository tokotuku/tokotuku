---
import { env } from "cloudflare:workers";
import registry from "virtual:tokotuku/registry";
import { mediaUrl } from "@tokotuku/core";
import { money } from "@tokotuku/core/brand";
import Input from "@tokotuku/ui/Input.astro";
import Layout from "@tokotuku/ui/Layout.astro";
import Pagination from "@tokotuku/ui/Pagination.astro";
import ProductCard from "@tokotuku/ui/ProductCard.astro";
import StoreHeader from "@tokotuku/ui/StoreHeader.astro";
import Tabs from "@tokotuku/ui/Tabs.astro";
import { countProducts, listCategories, listProducts } from "../../products";

const hasOrders = registry.moduleNames.includes("orders");

const PAGE_SIZE = 12;
const category = Astro.url.searchParams.get("category") || undefined;
const search = Astro.url.searchParams.get("q") || undefined;
const page = Math.max(1, Math.trunc(Number(Astro.url.searchParams.get("page"))) || 1);

const [products, totalCount, categories] = await Promise.all([
  listProducts(env.DB, { category, search, limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE }),
  countProducts(env.DB, { category, search }),
  listCategories(env.DB),
]);
const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));

const categoryHref = (targetCategory?: string) => {
  const params = new URLSearchParams();
  if (targetCategory) params.set("category", targetCategory);
  if (search) params.set("q", search);
  const query = params.toString();
  return query ? `/products?${query}` : "/products";
};

const tabItems = [
  { label: "All", href: categoryHref(), active: !category },
  ...categories.map((item) => ({
    label: item,
    href: categoryHref(item),
    active: category === item,
  })),
];

const paginationParams = new URLSearchParams();
if (category) paginationParams.set("category", category);
if (search) paginationParams.set("q", search);
const paginationBase = `/products?${paginationParams.toString()}${paginationParams.toString() ? "&" : ""}page=`;
---

<Layout
  title="Shop — Tokotuku"
  description={`Browse ${totalCount} products, ready for everyday life.`}
>
  <StoreHeader current="products" />
  <main>
    <header class="page-header">
      <p>Shop all</p>
      <h1>Useful by nature.</h1>
      <span>{totalCount} products, ready for everyday life.</span>
    </header>

    <Tabs items={tabItems} label="Categories" />

    <form method="get" class="search-form">
      {category && <input type="hidden" name="category" value={category} />}
      <Input type="search" name="q" value={search ?? ""} placeholder="Cari produk…" aria-label="Cari produk" />
      <button type="submit">Cari</button>
    </form>

    {products.length ? (
      <div class="product-grid">
        {
          products.map((product) => (
            <ProductCard
              id={product.id}
              name={product.name}
              description={product.description}
              price={money(product.priceCents / 100)}
              priceCents={product.priceCents}
              imageUrl={mediaUrl(product.imageKey)}
              stock={product.stock}
              showAddToCart={hasOrders}
            />
          ))
        }
      </div>
    ) : (
      <p class="empty-state">Tidak ada produk yang cocok dengan pencarian/filter ini.</p>
    )}

    {totalPages > 1 && <Pagination page={page} totalPages={totalPages} baseUrl={paginationBase} />}
  </main>
</Layout>

<style>
  main {
    width: min(100% - calc(var(--tk-spacing-4) * 2), 76rem);
    margin-inline: auto;
    padding-block: var(--tk-spacing-10) var(--tk-spacing-12);
  }
  .page-header { margin-bottom: var(--tk-spacing-8); }
  .page-header p { margin: 0; color: var(--tk-color-accent); font-size: var(--tk-font-size-xs); font-weight: var(--tk-font-weight-bold); letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { margin: var(--tk-spacing-2) 0; color: var(--tk-color-fg); font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.05em; }
  .page-header span { color: var(--tk-color-fg-muted); }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--tk-spacing-5); }
  @media (max-width: 60rem) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 38rem) { .product-grid { grid-template-columns: 1fr; } }
  .search-form { display: flex; gap: var(--tk-spacing-3); align-items: flex-end; margin: var(--tk-spacing-6) 0; max-width: 24rem; }
  .search-form :global(div) { flex: 1; }
  .search-form button { min-height: 2.75rem; padding-inline: var(--tk-spacing-5); border: 0; border-radius: var(--tk-radius-md); background: var(--tk-color-accent); color: var(--tk-color-accent-fg); font: inherit; font-weight: var(--tk-font-weight-semibold); cursor: pointer; }
  .empty-state { padding: var(--tk-spacing-10) 0; color: var(--tk-color-fg-muted); text-align: center; }
  main :global(nav.pagination) { margin-top: var(--tk-spacing-8); }
</style>
