---
import { env } from "cloudflare:workers";
import brand from "virtual:tokotuku/config";
import { createTranslator } from "@tokotuku/core";
import AdminLayout from "@tokotuku/core/routes/AdminLayout.astro";
import { catalogMessages, localizeCatalogError } from "../../../messages";
import { productInputFromForm } from "../../../product-form";
import { createProduct } from "../../../products";
import ProductForm from "../../ProductForm.astro";

const t = createTranslator(brand, catalogMessages);

let error = "";
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const productInput = await productInputFromForm(formData, env.MEDIA);
    return Astro.redirect(
      `/admin/products/${String(await createProduct(env.DB, productInput))}/edit?saved=1`,
    );
  } catch (caught) {
    error = localizeCatalogError(caught, t);
  }
}
---

<AdminLayout title={t("catalog.products.newTitle")}>
  <header class="page-heading"><div><h1>{t("catalog.products.newTitle")}</h1><p>{t("catalog.products.newDescription")}</p></div></header>
  <ProductForm error={error} />
</AdminLayout>
