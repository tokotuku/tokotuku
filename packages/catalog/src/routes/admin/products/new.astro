---
import { env } from "cloudflare:workers";
import brand from "virtual:karsa/config";
import registry from "virtual:karsa/registry";
import AdminLayout from "@karsa/core/layouts/AdminLayout.astro";
import AdminInspector from "@karsa/ui/AdminInspector.astro";
import AdminPageHeader from "@karsa/ui/AdminPageHeader.astro";
import Icon from "@karsa/ui/Icon.astro";
import InspectorMetric from "@karsa/ui/InspectorMetric.astro";
import { catalogItemInputFromForm } from "../../../catalog-item-form";
import { createItem } from "../../../catalog-items";
import ProductForm from "../../../components/ProductForm.astro";
import { createCatalogTranslator, localizeCatalogError } from "../../../messages";

const presentation =
  registry.clientConfig["catalog"]?.["presentation"] === "services" ? "services" : "products";
const services = presentation === "services";
const t = createCatalogTranslator(brand, presentation);
const adminBase = services ? "/admin/services" : "/admin/products";

let error = "";
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const productInput = await catalogItemInputFromForm(formData, env.MEDIA, "", presentation);
    return Astro.redirect(
      `${adminBase}/${String(await createItem(env.DB, productInput))}/edit?saved=1`,
    );
  } catch (caught) {
    error = localizeCatalogError(caught, t);
  }
}

import "../../../styles/routes/catalog-admin-products-new.css";
---

<AdminLayout title={t("catalog.products.newTitle")}>
  <AdminPageHeader eyebrow={t("catalog.products.catalogEyebrow")} title={t("catalog.products.newTitle")} description={t("catalog.products.newDescription")}>
    <Fragment slot="actions"><a class="admin-button" href={adminBase}>{t("catalog.products.form.cancel")}</a></Fragment>
  </AdminPageHeader>
  <ProductForm error={error} presentation={presentation} />
  <Fragment slot="inspector">
    <AdminInspector title={t("catalog.products.newTitle")} description={services ? "Pengaturan ringkas layanan baru." : "Pengaturan ringkas produk baru."}>
      <div class="inspector-metrics">
        <InspectorMetric label="Status" value="Aktif" tone="positive" />
        <InspectorMetric label={t("catalog.products.form.price")} value="—" />
        {!services && <InspectorMetric label={t("catalog.products.form.fulfillmentType")} value={t("catalog.products.form.fulfillmentType.physical")} />}
        {!services && <InspectorMetric label={t("catalog.products.form.stock")} value="0" />}
      </div>
      <div class="inspector-actions"><button class="admin-button admin-button--primary" type="submit" form="catalog-item-form"><Icon name="check" size={16} /> {t("catalog.products.form.save")}</button></div>
    </AdminInspector>
  </Fragment>
</AdminLayout>
