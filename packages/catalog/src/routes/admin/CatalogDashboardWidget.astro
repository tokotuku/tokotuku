---
import { env } from "cloudflare:workers";
import { createTranslator } from "@takontuku/core";
import { brand } from "@takontuku/core/brand";
import DashboardMetric from "@takontuku/ui/DashboardMetric.astro";
import Icon from "@takontuku/ui/Icon.astro";
import { catalogMessages } from "../../messages";
import { countProducts, listCategories, listProducts } from "../../products";

const [productCount, categories, products] = await Promise.all([
  countProducts(env.DB),
  listCategories(env.DB),
  listProducts(env.DB, { limit: 6 }),
]);
const t = createTranslator(brand, catalogMessages);
---

<section class="catalog-widget panel" data-dashboard-widget="catalog" aria-labelledby="catalog-widget-title">
  <div class="widget-heading"><div><p class="eyebrow">{t("catalog.dashboard.eyebrow")}</p><h2 id="catalog-widget-title">{t("catalog.dashboard.title")}</h2></div><a href="/admin/products">{t("catalog.dashboard.manage")} <span aria-hidden="true">↗</span></a></div>
  {productCount === 0 ? (
    <div class="launch-checklist" data-catalog-onboarding>
      <div class="launch-mark"><Icon name="products" size={22} /></div>
      <div><h3>{t("catalog.dashboard.startTitle")}</h3><p>{t("catalog.dashboard.startDescription")}</p><div class="launch-actions"><a class="admin-button admin-button--primary" href="/admin/products/new">{t("catalog.dashboard.addFirst")}</a>{import.meta.env.DEV && <span class="seed-hint">{t("catalog.dashboard.seedHint")} <code>bun run db:seed</code></span>}</div></div>
    </div>
  ) : (
    <>
      <div class="metrics"><DashboardMetric label={t("catalog.dashboard.activeProducts")} value={String(productCount)} hint={t("catalog.dashboard.acrossCategories", { count: categories.length })} /><DashboardMetric label={t("catalog.dashboard.categories")} value={String(categories.length)} /><DashboardMetric label={t("catalog.dashboard.lowStock")} value={String(products.filter((product) => product.stock > 0 && product.stock <= 5).length)} tone="warning" hint={t("catalog.dashboard.lowStockHint")} /></div>
      <div class="product-preview"><div class="subheading"><h3>{t("catalog.dashboard.featured")}</h3><a href="/products">{t("catalog.dashboard.viewStore")} ↗</a></div>{products.length ? products.slice(0, 4).map((product) => <div class="product-row"><span class="product-dot"></span><span>{product.name}</span><strong>{product.fulfillmentType === "physical" ? product.stock : "—"}</strong></div>) : <p class="muted">{t("catalog.dashboard.noActiveProducts")}</p>}</div>
    </>
  )}
</section>

<style>
  .catalog-widget { padding:1.25rem; }.widget-heading,.subheading { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; }.widget-heading h2,.widget-heading p,.subheading h3 { margin:0; }.eyebrow { color:var(--tk-color-accent); font-size:.65rem; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }.widget-heading h2 { margin-top:.3rem; font-family:var(--tk-font-family-display); font-size:1.75rem; font-weight:400; }.widget-heading a,.subheading a { color:var(--tk-color-fg-muted); font-size:.7rem; text-decoration:none; }.launch-checklist { display:flex; align-items:flex-start; gap:1rem; margin-top:1.5rem; padding:1.1rem; border:1px dashed var(--tk-color-border); border-radius:var(--tk-radius-md); background:color-mix(in srgb,var(--tk-color-bg-subtle) 55%,var(--tk-color-surface)); }.launch-mark { display:grid; flex:none; width:2.75rem; height:2.75rem; place-items:center; border-radius:var(--tk-radius-md); background:color-mix(in srgb,var(--tk-color-accent) 14%,var(--tk-color-surface)); color:var(--tk-color-accent); }.launch-checklist h3 { margin:0; font-size:.95rem; }.launch-checklist p { max-width:34rem; margin:.35rem 0 0; color:var(--tk-color-fg-muted); font-size:.75rem; line-height:1.6; }.launch-actions { display:flex; align-items:center; flex-wrap:wrap; gap:.8rem; margin-top:1rem; }.admin-button { display:inline-flex; min-height:2.5rem; align-items:center; padding-inline:.8rem; border-radius:var(--tk-radius-sm); font-size:.75rem; font-weight:700; text-decoration:none; }.admin-button--primary { background:var(--tk-color-accent); color:var(--tk-color-accent-fg); }.seed-hint { color:var(--tk-color-fg-muted); font-size:.65rem; }.seed-hint code { padding:.2rem .35rem; border-radius:4px; background:var(--tk-color-bg-subtle); font-family:var(--tk-font-family-mono); }.metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-top:1.5rem; }.product-preview { margin-top:1.5rem; padding-top:1.2rem; border-top:1px solid var(--tk-color-border); }.subheading h3 { font-size:.8rem; }.product-row { display:grid; grid-template-columns:.5rem 1fr auto; align-items:center; gap:.55rem; padding:.7rem 0; border-bottom:1px solid var(--tk-color-border); font-size:.75rem; }.product-row:last-child { border-bottom:0; }.product-dot { width:.45rem; height:.45rem; border-radius:50%; background:var(--tk-color-success); }.product-row strong { color:var(--tk-color-fg-muted); font-size:.7rem; }.muted { color:var(--tk-color-fg-muted); font-size:.75rem; }
  @media (max-width:560px) { .metrics { grid-template-columns:1fr; }.launch-checklist { flex-direction:column; } }
</style>
