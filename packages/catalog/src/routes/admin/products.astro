---
import { env } from "cloudflare:workers";
import brand from "virtual:karsa/config";
import { CursorError, createTranslator, mediaUrl } from "@karsa/core";
import { money } from "@karsa/core/brand";
import AdminLayout from "@karsa/core/layouts/AdminLayout.astro";
import AdminInspector from "@karsa/ui/AdminInspector.astro";
import AdminPageHeader from "@karsa/ui/AdminPageHeader.astro";
import AdminQuickView from "@karsa/ui/AdminQuickView.astro";
import CursorPagination from "@karsa/ui/CursorPagination.astro";
import Icon from "@karsa/ui/Icon.astro";
import InspectorMetric from "@karsa/ui/InspectorMetric.astro";
import { getCatalogDashboardSummary, listCategories, listItems } from "../../catalog-items";
import { catalogMessages } from "../../messages";

const after = Astro.url.searchParams.get("after") ?? undefined;
const before = Astro.url.searchParams.get("before") ?? undefined;
const category = Astro.url.searchParams.get("category") || undefined;
const search = Astro.url.searchParams.get("q") || undefined;
let productPage: Awaited<ReturnType<typeof listItems>>;
try {
  productPage = await listItems(env.DB, {
    activeOnly: false,
    pageSize: 25,
    ...(category ? { category } : {}),
    ...(search ? { search } : {}),
    ...(after ? { after } : {}),
    ...(before ? { before } : {}),
  });
} catch (error) {
  if (error instanceof CursorError) return new Response(error.message, { status: 400 });
  throw error;
}
const products = productPage.items;
const summary = await getCatalogDashboardSummary(env.DB);
const categories = await listCategories(env.DB);
const activeProductCount = summary.active;
const lowStock = summary.lowStock;
const outOfStock = summary.outOfStock;
const t = createTranslator(brand, catalogMessages);
function statusKeyFor(stock: number, active: boolean, fulfillmentType: string): string {
  if (!active) return "inactive";
  if (fulfillmentType !== "physical") return "scheduled";
  if (stock === 0) return "outOfStock";
  if (stock < 10) return "lowStock";
  return "inStock";
}
function statusToneFor(stock: number, active: boolean, fulfillmentType: string): string {
  const key = statusKeyFor(stock, active, fulfillmentType);
  if (key === "inStock" || key === "scheduled") return "success";
  if (key === "lowStock") return "warning";
  return "danger";
}
const statusClassByTone: Record<string, string> = {
  success: "status--success",
  warning: "status--warning",
  danger: "status--danger",
};
function statusClassFor(stock: number, active: boolean, fulfillmentType: string): string {
  return statusClassByTone[statusToneFor(stock, active, fulfillmentType)] ?? "status--danger";
}
const statusFor = (stock: number, active: boolean, fulfillmentType: string) =>
  t(`catalog.products.status.${statusKeyFor(stock, active, fulfillmentType)}`);
const initialResult = products.length
  ? t("catalog.products.showing", { count: products.length })
  : t("catalog.products.empty");

import "../../styles/routes/catalog-admin-products.css";
---

<AdminLayout title={t("catalog.products.title")}>
  {products.length === 0 && (
    <section class="standalone-empty" data-products-empty>
      <div class="empty-symbol"><Icon name="catalog-items" size={27} /></div><p class="eyebrow">{t("catalog.products.catalogEyebrow")}</p><h1>{t("catalog.products.empty")}</h1><p>{t("catalog.products.emptyDescription")}</p><a class="admin-button admin-button--primary" href="/admin/products/new"><Icon name="plus" size={16} /> {t("catalog.products.add")}</a>{import.meta.env.DEV && <span class="seed-hint">{t("catalog.products.localDemo")} <code>bun run db:seed</code></span>}
    </section>
  )}
  {products.length > 0 && (
    <>
      <AdminPageHeader eyebrow={t("catalog.products.catalogEyebrow")} title={t("catalog.products.title")} description={t("catalog.products.description", { count: products.length, categories: categories.length })}>
        <Fragment slot="actions"><a class="admin-button admin-button--primary" href="/admin/products/new"><Icon name="plus" size={16} /> {t("catalog.products.add")}</a></Fragment>
      </AdminPageHeader>
      <section class="panel data-panel" data-product-table data-currency={brand.currency} data-result-template={t("catalog.products.showing")} data-no-match={t("catalog.products.noMatch")}>
        <div class="table-toolbar"><div class="filter-tabs" role="tablist" aria-label={t("catalog.products.categoryFilter")}><a aria-current={!category ? "page" : undefined} href={search ? `/admin/products?q=${encodeURIComponent(search)}` : "/admin/products"}>{t("catalog.products.all")}</a>{categories.map((item) => <a aria-current={category === item ? "page" : undefined} href={`/admin/products?category=${encodeURIComponent(item)}${search ? `&q=${encodeURIComponent(search)}` : ""}`}>{item}</a>)}</div><form method="get" class="table-search"><Icon name="search" size={16} /><label class="sr-only" for="catalog-admin-search">{t("catalog.products.search")}</label><input id="catalog-admin-search" type="search" name="q" value={search ?? ""} placeholder={t("catalog.products.searchPlaceholder")} />{category && <input type="hidden" name="category" value={category} />}</form></div>
        <div class="table-wrap"><table class="admin-table"><thead><tr><th>{t("catalog.products.product")}</th><th>{t("catalog.products.category")}</th><th class="numeric">{t("catalog.products.price")}</th><th class="numeric">{t("catalog.products.stock")}</th><th>{t("catalog.products.status")}</th><th><span class="sr-only">{t("catalog.products.actions")}</span></th></tr></thead><tbody>{products.map((product) => <tr data-row><td><div class="entity"><img src={mediaUrl(product.imageKey)} alt={product.name} /><div><strong>{product.name}</strong><span>{t("catalog.products.form.sku")}: {product.sku}</span></div></div></td><td>{product.category}</td><td class="money">{product.priceCents === null ? "—" : money(product.priceCents / 100)}</td><td class="numeric">{product.fulfillmentType === "physical" ? product.stock : "—"}</td><td><span class:list={["status", statusClassFor(product.stock, product.isActive, product.fulfillmentType)]}>{statusFor(product.stock, product.isActive, product.fulfillmentType)}</span></td><td><div class="row-actions"><button type="button" data-quick-view-target="product-quick-view" data-quick-view-endpoint={`/admin/api/products/${product.id}`} data-quick-view-title={product.name} data-quick-view-meta={product.sku} aria-label={t("catalog.products.preview", { name: product.name })}><Icon name="eye" size={16} /></button><a aria-label={t("catalog.products.edit", { name: product.name })} href={`/admin/products/${product.id}/edit`}><Icon name="edit" size={16} /></a></div></td></tr>)}</tbody></table></div>
        <div class="table-footer"><span data-result-count>{initialResult}</span></div>
      </section>
      <CursorPagination pageInfo={productPage.pageInfo} />
    </>
  )}

  <Fragment slot="inspector">
    <AdminInspector title={t("catalog.products.title")} description={t("catalog.products.description", { count: products.length, categories: categories.length })}>
      <div class="inspector-metrics"><InspectorMetric label="Total" value={String(summary.total)} /><InspectorMetric label="Aktif" value={String(activeProductCount)} tone="positive" /><InspectorMetric label="Stok menipis" value={String(lowStock)} tone="warning" /><InspectorMetric label="Habis" value={String(outOfStock)} tone={outOfStock ? "warning" : "default"} /></div>
    </AdminInspector>
    <AdminInspector title={t("catalog.products.categoryFilter")}>
      <dl class="inspector-list"><div><dt>{t("catalog.products.category")}</dt><dd>{categories.length}</dd></div><div><dt>Aktif</dt><dd>{activeProductCount}</dd></div></dl>
    </AdminInspector>
  </Fragment>

  <AdminQuickView id="product-quick-view" titleLabel="Preview produk" closeLabel="Tutup preview" loadingLabel="Memuat preview…" errorLabel="Preview tidak dapat dimuat." retryLabel="Coba lagi" />
</AdminLayout>

{products.length > 0 && <script>
  type ProductDetail = { id:number; name:string; description:string; priceCents:number; imageKey:string; sku:string; category:string; stock:number; isActive:boolean; customFields:Record<string,string>; fulfillmentType:string };
  const container = document.querySelector<HTMLElement>("[data-product-table]");
  const currency = container?.dataset["currency"] ?? "IDR";

  document.addEventListener("karsa:quick-view-loaded", (event) => {
    const detail = (event as CustomEvent<{ data: ProductDetail; dialog: HTMLDialogElement }>).detail;
    if (detail.dialog.id !== "product-quick-view") return;
    const body = detail.dialog.querySelector<HTMLElement>("[data-quick-view-body]");
    const footer = detail.dialog.querySelector<HTMLElement>("[data-quick-view-footer]");
    if (!body || !footer) return;
    const product = detail.data;
    body.replaceChildren(); footer.replaceChildren();
    const wrapper = document.createElement("div"); wrapper.className = "quick-view-data";
    const image = document.createElement("img"); image.className = "quick-view-product-image"; image.src = `/api/images/${product.imageKey.split("/").map(encodeURIComponent).join("/")}`; image.alt = product.name; wrapper.append(image);
    const heading = document.createElement("div"); const h3 = document.createElement("h3"); h3.textContent = product.name; const desc = document.createElement("p"); desc.textContent = product.description; heading.append(h3, desc); wrapper.append(heading);
    const facts = document.createElement("dl"); const factRows: Array<[string, string]> = [["SKU", product.sku], ["Kategori", product.category], ["Harga", new Intl.NumberFormat(document.documentElement.lang === "id" ? "id-ID" : "en-US", { style: "currency", currency, maximumFractionDigits: 0 }).format(product.priceCents / 100)], ["Stok", product.fulfillmentType === "physical" ? String(product.stock) : "Terjadwal"], ["Status", product.isActive ? "Aktif" : "Nonaktif"]]; factRows.forEach(([label, value]) => { const row = document.createElement("div"); const dt = document.createElement("dt"); dt.textContent = label; const dd = document.createElement("dd"); dd.textContent = value; row.append(dt, dd); facts.append(row); }); wrapper.append(facts);
    if (Object.keys(product.customFields).length) { const custom = document.createElement("dl"); custom.className = "quick-view-items"; Object.entries(product.customFields).forEach(([label, value]) => { const row = document.createElement("div"); row.className = "quick-view-item"; const text = document.createElement("span"); text.textContent = label; const val = document.createElement("strong"); val.textContent = value; row.append(text, val); custom.append(row); }); wrapper.append(custom); }
    body.append(wrapper);
    const edit = document.createElement("a"); edit.className = "admin-button admin-button--primary"; edit.href = `/admin/products/${product.id}/edit`; edit.textContent = "Edit produk"; footer.append(edit);
    if (product.isActive) { const view = document.createElement("a"); view.className = "admin-button"; view.href = `/products/${product.id}`; view.textContent = "Lihat di toko ↗"; footer.append(view); }
  });
</script>}
