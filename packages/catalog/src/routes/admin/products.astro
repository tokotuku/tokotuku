---
import { env } from "cloudflare:workers";
import brand from "virtual:takontuku/config";
import { createTranslator, mediaUrl } from "@takontuku/core";
import { money } from "@takontuku/core/brand";
import AdminLayout from "@takontuku/core/routes/AdminLayout.astro";
import AdminInspector from "@takontuku/ui/AdminInspector.astro";
import AdminMetric from "@takontuku/ui/AdminMetric.astro";
import AdminPageHeader from "@takontuku/ui/AdminPageHeader.astro";
import AdminQuickView from "@takontuku/ui/AdminQuickView.astro";
import Icon from "@takontuku/ui/Icon.astro";
import { catalogMessages } from "../../messages";
import { listProducts } from "../../products";

const products = await listProducts(env.DB, { activeOnly: false });
const categories = [...new Set(products.map((product) => product.category))];
const activeProducts = products.filter((product) => product.isActive);
const lowStock = products.filter(
  (product) =>
    product.isActive &&
    product.fulfillmentType === "physical" &&
    product.stock > 0 &&
    product.stock <= 5,
).length;
const outOfStock = products.filter(
  (product) => product.isActive && product.fulfillmentType === "physical" && product.stock === 0,
).length;
const t = createTranslator(brand, catalogMessages);
const statusKeyFor = (stock: number, active: boolean, fulfillmentType: string) =>
  !active
    ? "inactive"
    : fulfillmentType !== "physical"
      ? "scheduled"
      : stock === 0
        ? "outOfStock"
        : stock < 10
          ? "lowStock"
          : "inStock";
const statusFor = (stock: number, active: boolean, fulfillmentType: string) =>
  t(`catalog.products.status.${statusKeyFor(stock, active, fulfillmentType)}`);
const initialResult = products.length
  ? t("catalog.products.showing", { count: products.length })
  : t("catalog.products.empty");
---

<AdminLayout title={t("catalog.products.title")}>
  {products.length === 0 ? (
    <section class="standalone-empty" data-products-empty>
      <div class="empty-symbol"><Icon name="products" size={27} /></div><p class="eyebrow">{t("catalog.products.catalogEyebrow")}</p><h1>{t("catalog.products.empty")}</h1><p>{t("catalog.products.emptyDescription")}</p><a class="admin-button admin-button--primary" href="/admin/products/new"><Icon name="plus" size={16} /> {t("catalog.products.add")}</a>{import.meta.env.DEV && <span class="seed-hint">{t("catalog.products.localDemo")} <code>bun run db:seed</code></span>}
    </section>
  ) : (
    <>
      <AdminPageHeader eyebrow={t("catalog.products.catalogEyebrow")} title={t("catalog.products.title")} description={t("catalog.products.description", { count: products.length, categories: categories.length })}>
        <Fragment slot="actions"><a class="admin-button admin-button--primary" href="/admin/products/new"><Icon name="plus" size={16} /> {t("catalog.products.add")}</a></Fragment>
      </AdminPageHeader>
      <section class="panel data-panel" data-product-table data-currency={brand.currency} data-result-template={t("catalog.products.showing")} data-no-match={t("catalog.products.noMatch")}>
        <div class="table-toolbar"><div class="filter-tabs" role="tablist" aria-label={t("catalog.products.categoryFilter")}><button type="button" aria-selected="true" data-filter="All">{t("catalog.products.all")}</button>{categories.map((category) => <button type="button" aria-selected="false" data-filter={category}>{category}</button>)}</div><label class="table-search"><Icon name="search" size={16} /><span class="sr-only">{t("catalog.products.search")}</span><input type="search" placeholder={t("catalog.products.searchPlaceholder")} data-table-search /></label></div>
        <div class="table-wrap"><table class="admin-table"><thead><tr><th>{t("catalog.products.product")}</th><th>{t("catalog.products.category")}</th><th class="numeric">{t("catalog.products.price")}</th><th class="numeric">{t("catalog.products.stock")}</th><th>{t("catalog.products.status")}</th><th><span class="sr-only">{t("catalog.products.actions")}</span></th></tr></thead><tbody>{products.map((product) => <tr data-row data-category={product.category} data-search={(product.name + " " + product.description + " " + product.category).toLowerCase()}><td><div class="entity"><img src={mediaUrl(product.imageKey)} alt={product.name} /><div><strong>{product.name}</strong><span>{t("catalog.products.form.sku")}: {product.sku}</span></div></div></td><td>{product.category}</td><td class="money">{money(product.priceCents / 100)}</td><td class="numeric">{product.fulfillmentType === "physical" ? product.stock : "—"}</td><td><span class:list={["status", ["inStock", "scheduled"].includes(statusKeyFor(product.stock, product.isActive, product.fulfillmentType)) ? "status--success" : statusKeyFor(product.stock, product.isActive, product.fulfillmentType) === "lowStock" ? "status--warning" : "status--danger"]}>{statusFor(product.stock, product.isActive, product.fulfillmentType)}</span></td><td><div class="row-actions"><button type="button" data-quick-view-target="product-quick-view" data-quick-view-endpoint={`/admin/api/products/${product.id}`} data-quick-view-title={product.name} data-quick-view-meta={product.sku} aria-label={t("catalog.products.preview", { name: product.name })}><Icon name="eye" size={16} /></button><a aria-label={t("catalog.products.edit", { name: product.name })} href={`/admin/products/${product.id}/edit`}><Icon name="edit" size={16} /></a></div></td></tr>)}</tbody></table></div>
        <div class="table-footer"><span data-result-count>{initialResult}</span></div>
      </section>
    </>
  )}

  <Fragment slot="inspector">
    <AdminInspector title={t("catalog.products.title")} description={t("catalog.products.description", { count: products.length, categories: categories.length })}>
      <div class="inspector-metrics"><AdminMetric label="Total" value={String(products.length)} /><AdminMetric label="Aktif" value={String(activeProducts.length)} tone="positive" /><AdminMetric label="Stok menipis" value={String(lowStock)} tone="warning" /><AdminMetric label="Habis" value={String(outOfStock)} tone={outOfStock ? "warning" : "default"} /></div>
    </AdminInspector>
    <AdminInspector title={t("catalog.products.categoryFilter")}>
      <dl class="inspector-list"><div><dt>{t("catalog.products.category")}</dt><dd>{categories.length}</dd></div><div><dt>Aktif</dt><dd>{activeProducts.length}</dd></div></dl>
    </AdminInspector>
  </Fragment>

  <AdminQuickView id="product-quick-view" titleLabel="Preview produk" closeLabel="Tutup preview" loadingLabel="Memuat preview…" errorLabel="Preview tidak dapat dimuat." retryLabel="Coba lagi" />
</AdminLayout>

{products.length > 0 && <script>
  type ProductDetail = { id:number; name:string; description:string; priceCents:number; imageKey:string; sku:string; category:string; stock:number; isActive:boolean; customFields:Record<string,string>; fulfillmentType:string };
  const container = document.querySelector<HTMLElement>("[data-product-table]");
  const rows = Array.from(container?.querySelectorAll<HTMLElement>("[data-row]") ?? []);
  const count = container?.querySelector("[data-result-count]");
  let filter = "All"; let query = "";
  const resultTemplate = container?.dataset["resultTemplate"] ?? ""; const emptyLabel = container?.dataset["noMatch"] ?? ""; const currency = container?.dataset["currency"] ?? "IDR";
  const update = () => { let visible = 0; for (const row of rows) { const match = (filter === "All" || row.dataset["category"] === filter) && (row.dataset["search"]?.includes(query) ?? false); row.hidden = !match; if (match) visible += 1; } if (count) count.textContent = visible ? resultTemplate.replace(/\{count\}/g, String(visible)) : emptyLabel; };
  for (const button of container?.querySelectorAll<HTMLButtonElement>("[data-filter]") ?? []) button.addEventListener("click", () => { filter = button.dataset["filter"] ?? "All"; container?.querySelectorAll("[data-filter]").forEach((item) => item.setAttribute("aria-selected", String(item === button))); update(); });
  container?.querySelector<HTMLInputElement>("[data-table-search]")?.addEventListener("input", (event) => { query = (event.currentTarget as HTMLInputElement).value.trim().toLowerCase(); update(); });

  document.addEventListener("takontuku:quick-view-loaded", (event) => {
    const detail = (event as CustomEvent<{ data: ProductDetail; dialog: HTMLDialogElement }>).detail;
    if (detail.dialog.id !== "product-quick-view") return;
    const body = detail.dialog.querySelector<HTMLElement>("[data-quick-view-body]");
    const footer = detail.dialog.querySelector<HTMLElement>("[data-quick-view-footer]");
    if (!body || !footer) return;
    const product = detail.data;
    body.replaceChildren(); footer.replaceChildren();
    const wrapper = document.createElement("div"); wrapper.className = "quick-view-data";
    const image = document.createElement("img"); image.className = "quick-view-product-image"; image.src = `/api/images/${product.imageKey.split("/").map(encodeURIComponent).join("/")}`; image.alt = product.name; wrapper.append(image);
    const heading = document.createElement("div"); const h3 = document.createElement("h3"); h3.textContent = product.name; const desc = document.createElement("p"); desc.textContent = product.description; heading.append(h3, desc); wrapper.append(heading);
    const facts = document.createElement("dl"); const factRows: Array<[string, string]> = [["SKU", product.sku], ["Kategori", product.category], ["Harga", new Intl.NumberFormat(document.documentElement.lang === "id" ? "id-ID" : "en-US", { style: "currency", currency, maximumFractionDigits: 0 }).format(product.priceCents / 100)], ["Stok", product.fulfillmentType === "physical" ? String(product.stock) : "Terjadwal"], ["Status", product.isActive ? "Aktif" : "Nonaktif"]]; factRows.forEach(([label, value]) => { const row = document.createElement("div"); const dt = document.createElement("dt"); dt.textContent = label; const dd = document.createElement("dd"); dd.textContent = value; row.append(dt, dd); facts.append(row); }); wrapper.append(facts);
    if (Object.keys(product.customFields).length) { const custom = document.createElement("dl"); custom.className = "quick-view-items"; Object.entries(product.customFields).forEach(([label, value]) => { const row = document.createElement("div"); row.className = "quick-view-item"; const text = document.createElement("span"); text.textContent = label; const val = document.createElement("strong"); val.textContent = value; row.append(text, val); custom.append(row); }); wrapper.append(custom); }
    body.append(wrapper);
    const edit = document.createElement("a"); edit.className = "admin-button admin-button--primary"; edit.href = `/admin/products/${product.id}/edit`; edit.textContent = "Edit produk"; footer.append(edit);
    if (product.isActive) { const view = document.createElement("a"); view.className = "admin-button"; view.href = `/products/${product.id}`; view.textContent = "Lihat di toko ↗"; footer.append(view); }
  });
</script>}

<style>
  .standalone-empty { display:grid; min-height:calc(100vh - 13rem); place-items:center; align-content:center; padding:3rem; text-align:center; }.empty-symbol { display:grid; width:4.5rem; height:4.5rem; place-items:center; border:1px solid var(--admin-line); border-radius:50%; background:var(--admin-accent-soft); color:var(--admin-accent); }.standalone-empty .eyebrow { margin:1.5rem 0 .45rem; color:var(--tk-color-accent); font-size:.68rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }.standalone-empty h1 { margin:0; font-family:var(--tk-font-family-display); font-size:clamp(2.7rem,5vw,4.5rem); font-weight:400; letter-spacing:-.045em; }.standalone-empty > p:not(.eyebrow) { max-width:30rem; margin:.7rem 0 1.4rem; color:var(--tk-color-fg-muted); font-size:.8rem; line-height:1.7; }.seed-hint { margin-top:1rem; color:var(--tk-color-fg-muted); font-size:.65rem; }.seed-hint code { padding:.2rem .35rem; border-radius:4px; background:var(--tk-color-bg-subtle); font-family:var(--tk-font-family-mono); }.data-panel { overflow:hidden; }.inspector-metrics { display:grid; gap:.6rem; }
  @media (max-width:640px) { .standalone-empty { min-height:calc(100vh - 9rem); padding-inline:1rem; } }
</style>
