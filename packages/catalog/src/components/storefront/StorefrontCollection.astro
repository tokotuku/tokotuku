---
import { env } from "cloudflare:workers";
import registry from "virtual:karsa/registry";
import { mediaUrl } from "@karsa/core";
import { brand, money } from "@karsa/core/brand";
import CatalogEmptyState from "@karsa/ui/CatalogEmptyState.astro";
import ProductCard from "@karsa/ui/ProductCard.astro";
import { listItems } from "../../catalog-items";
import { createCatalogTranslator } from "../../messages";

const presentation =
  registry.clientConfig["catalog"]?.["presentation"] === "services" ? "services" : "products";
const services = presentation === "services";
const publicBase = services ? "/services" : "/products";
const adminBase = services ? "/admin/services" : "/admin/products";
const { items: products } = await listItems(env.DB, { pageSize: 6, presentation });
const hasOrders = registry.clientConfig["orders"]?.["presentation"] === "orders";
const canManage = Astro.locals.canAccessBackoffice;
const t = createCatalogTranslator(brand, presentation);
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const localized = (idText: string, enText: string) => (locale === "id" ? idText : enText);
const actionLabel = services
  ? localized("Tambah layanan", "Add service")
  : t("catalog.storefront.addFirst");
const collectionEyebrow = services
  ? localized("Layanan", "Services")
  : t("catalog.storefront.collectionEyebrow");
const collectionHeading = services
  ? localized("Layanan terbaru", "Latest services")
  : t("catalog.storefront.collectionHeading");
const viewAllLabel = services
  ? localized("Semua layanan", "All services")
  : t("catalog.storefront.viewAll");
const itemViewLabel = services
  ? localized("Lihat layanan", "View service")
  : t("catalog.products.view");

import "./StorefrontCollection.css";
---

{products.length === 0 && (
  <CatalogEmptyState
    eyebrow={t("catalog.storefront.eyebrow")}
    title={t("catalog.storefront.emptyTitle")}
    description={canManage ? t("catalog.storefront.emptyStaffDescription") : t("catalog.storefront.emptyDescription")}
    actionHref={canManage ? `${adminBase}/new` : undefined}
    actionLabel={canManage ? actionLabel : undefined}
  />
)}
{products.length > 0 && (
  <section class="collection-section" aria-labelledby="collection-title">
    <div class="collection-heading"><div><p class="eyebrow">{collectionEyebrow}</p><h2 id="collection-title">{collectionHeading}</h2></div><a href={publicBase}>{viewAllLabel} <span aria-hidden="true">↗</span></a></div>
    <div class="product-grid">
      {products.map((product) => { const isPhysical = product.fulfillmentType === "physical"; const itemPrice = product.priceCents === null ? localized("Hubungi kami", "Request a quote") : money(product.priceCents / 100); return <ProductCard id={product.id} href={`${publicBase}/${product.id}`} name={product.name} description={product.description} price={itemPrice} priceCents={product.priceCents} imageUrl={mediaUrl(product.imageKey)} stock={product.stock} showStock={isPhysical} showAddToCart={hasOrders && isPhysical} category={product.category} labels={{ view: itemViewLabel, add: t("catalog.products.addToCart"), soldOut: t("catalog.products.status.outOfStock"), lowStock: t("catalog.products.fewLeft") }} />; })}
    </div>
  </section>
)}
