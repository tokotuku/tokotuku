---
import { env } from "cloudflare:workers";
import registry from "virtual:takontuku/registry";
import { createTranslator, mediaUrl } from "@takontuku/core";
import { brand, money } from "@takontuku/core/brand";
import ProductCard from "@takontuku/ui/ProductCard.astro";
import StorefrontEmptyCollection from "@takontuku/ui/StorefrontEmptyCollection.astro";
import { catalogMessages } from "../../messages";
import { listProducts } from "../../products";

const { items: products } = await listProducts(env.DB, { pageSize: 6 });
const hasOrders = registry.moduleNames.includes("orders");
const canManage = Astro.locals.canAccessBackoffice;
const t = createTranslator(brand, catalogMessages);

import "./StorefrontCollection.css";
---

{products.length === 0 && (
  <StorefrontEmptyCollection
    eyebrow={t("catalog.storefront.eyebrow")}
    title={t("catalog.storefront.emptyTitle")}
    description={canManage ? t("catalog.storefront.emptyStaffDescription") : t("catalog.storefront.emptyDescription")}
    actionHref={canManage ? "/admin/products/new" : undefined}
    actionLabel={canManage ? t("catalog.storefront.addFirst") : undefined}
  />
)}
{products.length > 0 && (
  <section class="collection-section" aria-labelledby="collection-title">
    <div class="collection-heading"><div><p class="eyebrow">{t("catalog.storefront.collectionEyebrow")}</p><h2 id="collection-title">{t("catalog.storefront.collectionHeading")}</h2></div><a href="/products">{t("catalog.storefront.viewAll")} <span aria-hidden="true">↗</span></a></div>
    <div class="product-grid">
      {products.map((product) => { const isPhysical = product.fulfillmentType === "physical"; return <ProductCard id={product.id} name={product.name} description={product.description} price={money(product.priceCents / 100)} priceCents={product.priceCents} imageUrl={mediaUrl(product.imageKey)} stock={product.stock} showStock={isPhysical} showAddToCart={hasOrders && isPhysical} category={product.category} labels={{ view: t("catalog.products.view"), add: t("catalog.products.addToCart"), soldOut: t("catalog.products.status.outOfStock"), lowStock: t("catalog.products.fewLeft") }} />; })}
    </div>
  </section>
)}
