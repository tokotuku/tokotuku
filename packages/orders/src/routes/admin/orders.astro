---
import { env } from "cloudflare:workers";
import brand from "virtual:karsa/config";
import { CursorError, createTranslator } from "@karsa/core";
import { date, money } from "@karsa/core/brand";
import AdminLayout from "@karsa/core/layouts/AdminLayout.astro";
import AdminInspector from "@karsa/ui/AdminInspector.astro";
import AdminPageHeader from "@karsa/ui/AdminPageHeader.astro";
import AdminQuickView from "@karsa/ui/AdminQuickView.astro";
import CursorPagination from "@karsa/ui/CursorPagination.astro";
import Icon from "@karsa/ui/Icon.astro";
import InspectorMetric from "@karsa/ui/InspectorMetric.astro";
import { orderMessages } from "../../messages";
import {
  approvePayment,
  getOrderDashboardSummary,
  listOrders,
  type OrderStatus,
  orderStatuses,
  orderTransitions,
  updateOrderStatus,
} from "../../orders";

const t = createTranslator(brand, orderMessages);
let error = "";
if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const id = Number(form.get("orderId"));
    if (!Number.isInteger(id)) throw new Error(t("orders.admin.error.notFound"));
    if (String(form.get("action") ?? "") === "approve_payment") await approvePayment(env.DB, id);
    else {
      const status = String(form.get("status")) as OrderStatus;
      if (!orderStatuses.includes(status)) throw new Error(t("orders.admin.error.invalidStatus"));
      await updateOrderStatus(env.DB, id, status);
    }
    return Astro.redirect("/admin/orders?updated=1");
  } catch (caught) {
    error = caught instanceof Error ? caught.message : t("orders.admin.error.generic");
  }
}

const after = Astro.url.searchParams.get("after") ?? undefined;
const before = Astro.url.searchParams.get("before") ?? undefined;
const search = Astro.url.searchParams.get("q") ?? undefined;
const statusParam = Astro.url.searchParams.get("status") ?? undefined;
if (statusParam && !orderStatuses.includes(statusParam as OrderStatus)) {
  return new Response("Invalid order status filter.", { status: 400 });
}
const status = statusParam as OrderStatus | undefined;
let orderPage: Awaited<ReturnType<typeof listOrders>>;
try {
  orderPage = await listOrders(env.DB, {
    pageSize: 25,
    ...(status ? { status } : {}),
    ...(after ? { after } : {}),
    ...(before ? { before } : {}),
    ...(search ? { search } : {}),
  });
} catch (caught) {
  if (caught instanceof CursorError) return new Response(caught.message, { status: 400 });
  throw caught;
}
const orders = orderPage.items;
const summary = await getOrderDashboardSummary(env.DB);
const statusLabel: Record<OrderStatus, string> = {
  inquiry: t("orders.status.inquiry"),
  quoted: t("orders.status.quoted"),
  pending: t("orders.status.pending"),
  confirmed: t("orders.status.confirmed"),
  in_progress: t("orders.status.in_progress"),
  delivered: t("orders.status.delivered"),
  completed: t("orders.status.completed"),
  cancelled: t("orders.status.cancelled"),
};
function statusTone(status: OrderStatus): string {
  if (status === "delivered" || status === "completed") return "success";
  if (status === "pending" || status === "inquiry") return "warning";
  if (status === "cancelled") return "danger";
  return "info";
}
const statusClassByTone: Record<string, string> = {
  success: "status--success",
  warning: "status--warning",
  danger: "status--danger",
  info: "status--info",
};
function statusClass(status: OrderStatus): string {
  return statusClassByTone[statusTone(status)] ?? "status--info";
}
function paymentStatusClass(status: string): string {
  return status === "paid" ? "status--success" : "status--warning";
}
function paymentLabel(method: string, status: string): string {
  if (method === "transfer") {
    return status === "paid"
      ? t("orders.admin.payment.transferVerified")
      : t("orders.admin.payment.transferPending");
  }
  return status === "paid" ? t("orders.admin.payment.paidCash") : t("orders.admin.payment.cashDue");
}
function statusHref(nextStatus?: OrderStatus): string {
  const params = new URLSearchParams();
  if (nextStatus) params.set("status", nextStatus);
  if (search) params.set("q", search);
  const query = params.toString();
  return query ? `/admin/orders?${query}` : "/admin/orders";
}
const isTerminal = (status: OrderStatus) => orderTransitions[status].length === 0;
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const todaySalesCents = summary.todaySalesCents;
const thirtyDayRevenueCents = summary.thirtyDayRevenueCents;
const pendingCount = summary.pendingCount;
const transferPendingCount = summary.transferPendingCount;

import "../../styles/routes/orders-admin.css";
---

<AdminLayout title={t("orders.admin.title")}>
  {error && <p class="notice notice--error" role="alert">{error}</p>}
  {Astro.url.searchParams.has("updated") && <p class="notice">{t("orders.admin.updated")}</p>}

  {orders.length === 0 && (
    <section class="standalone-empty" data-orders-empty>
      <div class="empty-symbol"><Icon name="orders" size={27} /></div>
      <p class="eyebrow">{locale === "id" ? "Pesanan" : "Orders"}</p>
      <h1>{t("orders.admin.empty")}</h1>
      <p>{t("orders.admin.emptyDescription")}</p>
    </section>
  )}
  {orders.length > 0 && (
    <>
      <AdminPageHeader eyebrow={locale === "id" ? "Operasional" : "Operations"} title={t("orders.admin.title")} description={t("orders.admin.description")} />
      <section class="panel data-panel" data-order-table data-currency={brand.currency} data-result-template={t("orders.admin.showing")} data-no-match={t("orders.admin.noMatch")}>
        <div class="table-toolbar">
          <div class="filter-tabs" role="tablist" aria-label={t("orders.admin.statusFilter")}>
            <a aria-current={!status ? "page" : undefined} href={statusHref()}>{t("orders.admin.all")}</a>
            {orderStatuses.map((item) => <a aria-current={status === item ? "page" : undefined} href={statusHref(item)}>{statusLabel[item]}</a>)}
          </div>
          <form method="get" class="table-search"><label class="sr-only" for="orders-admin-search">{t("orders.admin.search")}</label><input id="orders-admin-search" type="search" name="q" value={search ?? ""} placeholder={t("orders.admin.searchPlaceholder")} />{status && <input type="hidden" name="status" value={status} />}</form>
        </div>
        <div class="table-wrap">
          <table class="admin-table">
            <thead><tr><th>{t("orders.admin.order")}</th><th>{t("orders.admin.customer")}</th><th>{t("orders.admin.date")}</th><th class="numeric">{t("orders.admin.items")}</th><th class="numeric">{t("orders.admin.total")}</th><th>{t("orders.admin.payment")}</th><th>{t("orders.admin.status")}</th><th>{t("orders.admin.update")}</th><th><span class="sr-only">{t("orders.admin.previewTitle")}</span></th></tr></thead>
            <tbody>
              {orders.map((order) => (
                <tr data-row data-status={order.status} data-search={(order.orderNumber + " " + order.customerName + " " + (order.customerEmail ?? "")).toLowerCase()}>
                  <td><strong>#{order.orderNumber}</strong></td>
                  <td><div class="entity"><span class="entity-avatar">{order.customerName.slice(0, 2).toUpperCase()}</span><div><strong>{order.customerName}</strong><span>{order.customerEmail}</span></div></div></td>
                  <td>{date(new Date(`${order.createdAt}Z`))}</td>
                  <td class="numeric">{order.itemCount}</td>
                  <td class="money">{order.totalCents === null ? "—" : money(order.totalCents / 100)}</td>
                  <td>{order.status === "inquiry" ? <span class="status status--info">{t("orders.admin.payment.notQuoted")}</span> : <div class="payment-cell"><span class:list={["status", paymentStatusClass(order.paymentStatus)]}>{paymentLabel(order.paymentMethod, order.paymentStatus)}</span>{order.paymentMethod === "transfer" && order.paymentProofKey && <a href={`/api/payment-proofs/${order.paymentProofKey}`} target="_blank" rel="noreferrer">{t("orders.admin.viewProof")}</a>}{order.paymentMethod === "transfer" && order.paymentStatus === "unpaid" && order.paymentProofKey && <form method="post" class="approve-form"><input type="hidden" name="orderId" value={order.id} /><input type="hidden" name="action" value="approve_payment" /><button type="submit">{t("orders.admin.verify")}</button></form>}</div>}</td>
                  <td><span class:list={["status", statusClass(order.status)]}>{statusLabel[order.status]}</span></td>
                  <td><form method="post" class="status-form"><input type="hidden" name="orderId" value={order.id} /><select name="status" aria-label={`${t("orders.admin.update")} ${order.orderNumber}`} disabled={isTerminal(order.status)}>{[order.status, ...orderTransitions[order.status]].map((status) => <option value={status} selected={status === order.status}>{statusLabel[status]}</option>)}</select><button type="submit" disabled={isTerminal(order.status)}>{t("orders.admin.save")}</button></form></td>
                  <td><div class="row-actions"><button type="button" data-quick-view-target="order-quick-view" data-quick-view-endpoint={`/admin/api/orders/${order.id}`} data-quick-view-title={`#${order.orderNumber}`} data-quick-view-meta={order.customerName} aria-label={`${t("orders.admin.previewTitle")}: ${order.orderNumber}`}><Icon name="eye" size={16} /></button></div></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="table-footer"><span data-result-count>{t("orders.admin.showing", { count: orders.length })}</span></div>
      </section>
      <CursorPagination pageInfo={orderPage.pageInfo} />
    </>
  )}

  <Fragment slot="inspector">
    <AdminInspector title={t("orders.admin.title")} description={t("orders.admin.description")}>
      <div class="inspector-metrics">
        <InspectorMetric label={t("orders.dashboard.today")} value={money(todaySalesCents / 100)} />
        <InspectorMetric label={t("orders.dashboard.thirtyDays")} value={money(thirtyDayRevenueCents / 100)} />
        <InspectorMetric label={t("orders.dashboard.pending")} value={String(pendingCount)} tone={pendingCount ? "warning" : "default"} />
        <InspectorMetric label={t("orders.admin.verify")} value={String(transferPendingCount)} tone={transferPendingCount ? "warning" : "default"} />
      </div>
    </AdminInspector>
    <AdminInspector title={t("orders.admin.status")}>
      <dl class="inspector-list">{orderStatuses.map((status) => <div><dt>{statusLabel[status]}</dt><dd>{summary.statusCounts[status]}</dd></div>)}</dl>
    </AdminInspector>
  </Fragment>

  <AdminQuickView id="order-quick-view" titleLabel={t("orders.admin.previewTitle")} closeLabel={t("orders.admin.previewClose")} loadingLabel={t("orders.admin.previewLoading")} errorLabel={t("orders.admin.previewError")} retryLabel={t("orders.admin.previewRetry")} />
</AdminLayout>

{orders.length > 0 && <script>
  type OrderDetail = { id:number; orderNumber:string; customerName:string; customerEmail:string|null; createdAt:string; itemCount:number; totalCents:number|null; status:string; paymentMethod:string; paymentStatus:string; paymentProofKey:string|null; customerPhone:string; shippingAddress:string; shippingCity:string; shippingPostalCode:string; customerNote:string; source:string; items:Array<{itemId:number;productName:string;sku:string;priceCents:number;quantity:number;lineTotalCents:number|null}> };
  const container = document.querySelector<HTMLElement>("[data-order-table]");

  const transitions: Record<string, string[]> = { inquiry:["quoted","confirmed","cancelled"], quoted:["confirmed","cancelled"], pending:["confirmed","cancelled"], confirmed:["in_progress","delivered","completed","cancelled"], in_progress:["completed","cancelled"], delivered:[], completed:[], cancelled:[] };
  const labels: Record<string, string> = { inquiry:"Permintaan baru", quoted:"Penawaran terkirim", pending:"Menunggu", confirmed:"Dikonfirmasi", in_progress:"Berlangsung", delivered:"Selesai", completed:"Tuntas", cancelled:"Dibatalkan" };
  const currency = container?.dataset["currency"] ?? "IDR"; const locale = document.documentElement.lang === "id" ? "id-ID" : "en-US";
  const formatMoney = (cents:number|null) => cents === null ? "—" : new Intl.NumberFormat(locale, { style:"currency", currency, maximumFractionDigits:0 }).format(cents / 100);
  const addTextRow = (parent:HTMLElement, label:string, value:string) => { const row = document.createElement("div"); const dt = document.createElement("dt"); dt.textContent = label; const dd = document.createElement("dd"); dd.textContent = value || "—"; row.append(dt, dd); parent.append(row); };
  const addSection = (parent:HTMLElement, heading:string, content:HTMLElement) => { const section = document.createElement("section"); section.className = "quick-view-section"; const title = document.createElement("h3"); title.textContent = heading; section.append(title, content); parent.append(section); };

  document.addEventListener("karsa:quick-view-loaded", (event) => {
    const detail = (event as CustomEvent<{data:OrderDetail;dialog:HTMLDialogElement}>).detail; if (detail.dialog.id !== "order-quick-view") return;
    const body = detail.dialog.querySelector<HTMLElement>("[data-quick-view-body]"); const footer = detail.dialog.querySelector<HTMLElement>("[data-quick-view-footer]"); if (!body || !footer) return; const order = detail.data; body.replaceChildren(); footer.replaceChildren();
    const wrapper = document.createElement("div"); wrapper.className = "quick-view-data";
    const summary = document.createElement("div"); const heading = document.createElement("h3"); heading.textContent = `#${order.orderNumber}`; const status = document.createElement("span"); status.className = "status status--info"; status.textContent = labels[order.status] ?? order.status; summary.append(heading, status); wrapper.append(summary);
    const facts = document.createElement("dl"); addTextRow(facts, "Tanggal", new Intl.DateTimeFormat(locale, { dateStyle:"medium", timeStyle:"short" }).format(new Date(`${order.createdAt}Z`))); addTextRow(facts, "Sumber", order.source); addTextRow(facts, "Status", labels[order.status] ?? order.status); addSection(wrapper, "Ringkasan", facts);
    const customer = document.createElement("dl"); addTextRow(customer, "Nama", order.customerName); addTextRow(customer, "Email", order.customerEmail ?? "—"); addTextRow(customer, "Telepon", order.customerPhone); addTextRow(customer, "Alamat", [order.shippingAddress, order.shippingCity, order.shippingPostalCode].filter(Boolean).join(", ")); addSection(wrapper, "Pelanggan", customer);
    const itemList = document.createElement("div"); itemList.className = "quick-view-items"; for (const item of order.items) { const itemRow = document.createElement("div"); itemRow.className = "quick-view-item"; const copy = document.createElement("span"); copy.textContent = `${item.productName} · ${item.sku} × ${item.quantity}`; const total = document.createElement("strong"); total.textContent = formatMoney(item.lineTotalCents ?? item.priceCents * item.quantity); itemRow.append(copy, total); itemList.append(itemRow); } const totalRow = document.createElement("div"); totalRow.className = "quick-view-item quick-view-total"; const totalLabel = document.createElement("strong"); totalLabel.textContent = "Total"; const total = document.createElement("strong"); total.textContent = formatMoney(order.totalCents); totalRow.append(totalLabel, total); itemList.append(totalRow); addSection(wrapper, "Item pesanan", itemList);
    const payment = document.createElement("dl"); addTextRow(payment, "Metode", order.paymentMethod === "transfer" ? "Transfer" : "Tunai"); addTextRow(payment, "Status", order.paymentStatus === "paid" ? "Terverifikasi" : "Belum dibayar"); if (order.paymentProofKey) { const row = document.createElement("div"); const dt = document.createElement("dt"); dt.textContent = "Bukti"; const dd = document.createElement("dd"); const link = document.createElement("a"); link.href = `/api/payment-proofs/${order.paymentProofKey}`; link.target = "_blank"; link.rel = "noreferrer"; link.textContent = "Lihat bukti"; dd.append(link); row.append(dt, dd); payment.append(row); } addSection(wrapper, "Pembayaran", payment);
    if (order.customerNote) { const note = document.createElement("p"); note.className = "quick-view-note"; note.textContent = order.customerNote; addSection(wrapper, "Catatan pelanggan", note); }
    body.append(wrapper);
    for (const nextStatus of transitions[order.status] ?? []) { if (nextStatus === order.status) continue; const form = document.createElement("form"); form.method = "post"; form.action = "/admin/orders"; const id = document.createElement("input"); id.type = "hidden"; id.name = "orderId"; id.value = String(order.id); const statusInput = document.createElement("input"); statusInput.type = "hidden"; statusInput.name = "status"; statusInput.value = nextStatus; const action = document.createElement("button"); action.className = "admin-button"; action.type = "submit"; action.textContent = `→ ${labels[nextStatus] ?? nextStatus}`; form.append(id, statusInput, action); footer.append(form); }
    if (order.paymentMethod === "transfer" && order.paymentStatus === "unpaid" && order.paymentProofKey) { const form = document.createElement("form"); form.method = "post"; form.action = "/admin/orders"; const id = document.createElement("input"); id.type = "hidden"; id.name = "orderId"; id.value = String(order.id); const action = document.createElement("input"); action.type = "hidden"; action.name = "action"; action.value = "approve_payment"; const button = document.createElement("button"); button.className = "admin-button admin-button--primary"; button.type = "submit"; button.textContent = "Verifikasi transfer"; form.append(id, action, button); footer.append(form); }
  });
</script>}
