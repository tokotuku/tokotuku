---
import { createTranslator } from "@takontuku/core";
import { brand, money } from "@takontuku/core/brand";
import Layout from "@takontuku/ui/DocumentLayout.astro";
import Icon from "@takontuku/ui/Icon.astro";
import StoreHeader from "@takontuku/ui/StoreHeader.astro";
import { orderMessages } from "../messages";

const id = brand.locale.toLowerCase().startsWith("id");
const t = createTranslator(brand, orderMessages);

import "../styles/routes/orders-cart.css";
---

<Layout title={`${t("orders.cart.pageTitle")} — ${brand.name}`} siteName={brand.name} lang={id ? "id" : "en"}>
  <StoreHeader current="cart" brand={brand} showCart={true} announcement={brand.storefront?.announcement ?? (id ? "Objek untuk ritual sehari-hari." : "Objects for everyday rituals.")} labels={{ home: id ? "Beranda" : "Home", shop: id ? "Toko" : "Shop", cart: id ? "Keranjang" : "Cart" }} />
  <main>
    <header><p>{t("orders.cart.eyebrow")}</p><h1>{t("orders.cart.title")}</h1></header>
    <div class="cart-layout">
      <section class="cart-items" aria-label={t("orders.cart.itemsLabel")} data-cart-items data-label-remove={t("orders.cart.remove")} data-label-quantity={t("orders.cart.quantity")} data-label-available={t("orders.cart.available")}>
        <div class="empty" data-cart-empty><div class="empty-mark" aria-hidden="true"><Icon name="cart" size={28} /></div><h2>{t("orders.cart.emptyTitle")}</h2><p>{t("orders.cart.emptyDescription")}</p><a href="/products">{t("orders.cart.emptyAction")}</a></div>
      </section>
      <aside data-cart-summary hidden>
        <h2>{t("orders.cart.summary")}</h2><div><span>{t("orders.cart.subtotal")}</span><strong data-cart-subtotal>{money(0)}</strong></div><p>{t("orders.cart.calculationNote")}</p><a href="/login?next=/checkout">{t("orders.cart.checkout")}</a>
      </aside>
    </div>
  </main>
</Layout>

<script>
  import { money } from "@takontuku/core/brand";
  import { onCartChange, readCart, removeFromCart, setQuantity } from "../client/cart";
  import { appendAll } from "../client/dom";

  interface CartLineProduct {
    id: number;
    name: string;
    description: string;
    priceCents: number;
    imageUrl: string;
    stock: number;
  }

  const container = document.querySelector<HTMLElement>("[data-cart-items]");
  const emptyState = document.querySelector<HTMLElement>("[data-cart-empty]");
  const summary = document.querySelector<HTMLElement>("[data-cart-summary]");
  const subtotalEl = document.querySelector<HTMLElement>("[data-cart-subtotal]");
  const labelsRoot = document.querySelector<HTMLElement>("[data-cart-items]");
  const removeLabel = labelsRoot?.dataset["labelRemove"] ?? "Remove";
  const quantityLabel = labelsRoot?.dataset["labelQuantity"] ?? "Qty";
  const availableTemplate = labelsRoot?.dataset["labelAvailable"] ?? "{count} available";

  async function fetchLines(ids: number[]): Promise<CartLineProduct[]> {
    if (!ids.length) return [];
    const response = await fetch(`/api/cart/lines?ids=${encodeURIComponent(ids.join(","))}`);
    if (!response.ok) return [];
    const data = (await response.json()) as { products: CartLineProduct[] };
    return data.products;
  }

  function renderLine(product: CartLineProduct, quantity: number): HTMLElement {
    const article = document.createElement("article");
    article.dataset["productId"] = String(product.id);

    const img = document.createElement("img");
    img.src = product.imageUrl;
    img.alt = product.name;

    const info = document.createElement("div");
    const heading = document.createElement("h2");
    const link = document.createElement("a");
    link.href = `/products/${product.id}`;
    link.textContent = product.name;
    appendAll(heading, link);
    const description = document.createElement("p");
    description.textContent = product.description;
    appendAll(info, heading, description);

    const removeButton = document.createElement("button");
    removeButton.type = "button";
    removeButton.dataset["removeItem"] = "";
    removeButton.textContent = removeLabel;

    const quantityBlock = document.createElement("div");
    quantityBlock.className = "quantity";
    const label = document.createElement("label");
    appendAll(label, `${quantityLabel} `);
    const input = document.createElement("input");
    input.type = "number";
    input.min = "1";
    input.max = String(product.stock);
    input.value = String(quantity);
    input.dataset["quantity"] = "";
    appendAll(label, input);
    const qtyRow = document.createElement("div");
    qtyRow.className = "qty-row";
    appendAll(qtyRow, label, removeButton);
    const available = document.createElement("span");
    available.textContent = availableTemplate.replace("{count}", String(product.stock));
    const lineTotal = document.createElement("strong");
    lineTotal.dataset["lineTotal"] = "";
    appendAll(quantityBlock, qtyRow, available, lineTotal);

    appendAll(article, img, info, quantityBlock);
    return article;
  }

  async function render(): Promise<void> {
    const cart = readCart();
    if (emptyState) emptyState.hidden = cart.length > 0;
    if (summary) summary.hidden = cart.length === 0;
    container?.querySelectorAll("article[data-product-id]").forEach((el) => el.remove());
    if (!cart.length) {
      if (subtotalEl) subtotalEl.textContent = money(0);
      return;
    }

    const products = await fetchLines(cart.map((item) => item.id));
    const byId = new Map(products.map((product) => [product.id, product]));
    let subtotal = 0;
    for (const item of cart) {
      const product = byId.get(item.id);
      if (!product) continue;
      const line = renderLine(product, item.quantity);
      const lineTotalCents = product.priceCents * item.quantity;
      subtotal += lineTotalCents;
      const lineTotalEl = line.querySelector<HTMLElement>("[data-line-total]");
      if (lineTotalEl) lineTotalEl.textContent = money(lineTotalCents / 100);
      if (container) appendAll(container, line);
    }
    if (subtotalEl) subtotalEl.textContent = money(subtotal / 100);
  }

  document.addEventListener("change", (event) => {
    const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-quantity]");
    if (!input) return;
    const id = Number(input.closest<HTMLElement>("[data-product-id]")?.dataset["productId"]);
    const max = Number(input.max) || 1;
    setQuantity(id, Math.min(max, Math.max(1, Number(input.value) || 1)));
  });

  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest("[data-remove-item]");
    if (!button) return;
    const id = Number(button.closest<HTMLElement>("[data-product-id]")?.dataset["productId"]);
    removeFromCart(id);
  });

  onCartChange(render);
</script>
