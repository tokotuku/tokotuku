---
import { createTranslator } from "@tokotuku/core";
import { brand, money } from "@tokotuku/core/brand";
import Icon from "@tokotuku/ui/Icon.astro";
import Layout from "@tokotuku/ui/Layout.astro";
import StoreHeader from "@tokotuku/ui/StoreHeader.astro";
import { orderMessages } from "../messages";

const id = brand.locale.toLowerCase().startsWith("id");
const t = createTranslator(brand, orderMessages);
---

<Layout title={`${t("orders.cart.pageTitle")} — ${brand.name}`} siteName={brand.name} lang={id ? "id" : "en"}>
  <StoreHeader current="cart" brand={brand} showCart={true} announcement={brand.storefront?.announcement ?? (id ? "Objek untuk ritual sehari-hari." : "Objects for everyday rituals.")} labels={{ home: id ? "Beranda" : "Home", shop: id ? "Toko" : "Shop", cart: id ? "Keranjang" : "Cart" }} />
  <main>
    <header><p>{t("orders.cart.eyebrow")}</p><h1>{t("orders.cart.title")}</h1></header>
    <div class="cart-layout">
      <section class="cart-items" aria-label={t("orders.cart.itemsLabel")} data-cart-items data-label-remove={t("orders.cart.remove")} data-label-quantity={t("orders.cart.quantity")} data-label-available={t("orders.cart.available")}>
        <div class="empty" data-cart-empty><div class="empty-mark" aria-hidden="true"><Icon name="cart" size={28} /></div><h2>{t("orders.cart.emptyTitle")}</h2><p>{t("orders.cart.emptyDescription")}</p><a href="/products">{t("orders.cart.emptyAction")}</a></div>
      </section>
      <aside data-cart-summary hidden>
        <h2>{t("orders.cart.summary")}</h2><div><span>{t("orders.cart.subtotal")}</span><strong data-cart-subtotal>{money(0)}</strong></div><p>{t("orders.cart.calculationNote")}</p><a href="/login?next=/checkout">{t("orders.cart.checkout")}</a>
      </aside>
    </div>
  </main>
</Layout>

<script>
  import { money } from "@tokotuku/core/brand";
  import { onCartChange, readCart, removeFromCart, setQuantity } from "../client/cart";
  import { appendAll } from "../client/dom";

  interface CartLineProduct {
    id: number;
    name: string;
    description: string;
    priceCents: number;
    imageUrl: string;
    stock: number;
  }

  const container = document.querySelector<HTMLElement>("[data-cart-items]");
  const emptyState = document.querySelector<HTMLElement>("[data-cart-empty]");
  const summary = document.querySelector<HTMLElement>("[data-cart-summary]");
  const subtotalEl = document.querySelector<HTMLElement>("[data-cart-subtotal]");
  const labelsRoot = document.querySelector<HTMLElement>("[data-cart-items]");
  const removeLabel = labelsRoot?.dataset["labelRemove"] ?? "Remove";
  const quantityLabel = labelsRoot?.dataset["labelQuantity"] ?? "Qty";
  const availableTemplate = labelsRoot?.dataset["labelAvailable"] ?? "{count} available";

  async function fetchLines(ids: number[]): Promise<CartLineProduct[]> {
    if (!ids.length) return [];
    const response = await fetch(`/api/cart/lines?ids=${encodeURIComponent(ids.join(","))}`);
    if (!response.ok) return [];
    const data = (await response.json()) as { products: CartLineProduct[] };
    return data.products;
  }

  function renderLine(product: CartLineProduct, quantity: number): HTMLElement {
    const article = document.createElement("article");
    article.dataset["productId"] = String(product.id);

    const img = document.createElement("img");
    img.src = product.imageUrl;
    img.alt = product.name;

    const info = document.createElement("div");
    const heading = document.createElement("h2");
    const link = document.createElement("a");
    link.href = `/products/${product.id}`;
    link.textContent = product.name;
    appendAll(heading, link);
    const description = document.createElement("p");
    description.textContent = product.description;
    appendAll(info, heading, description);

    const removeButton = document.createElement("button");
    removeButton.type = "button";
    removeButton.dataset["removeItem"] = "";
    removeButton.textContent = removeLabel;

    const quantityBlock = document.createElement("div");
    quantityBlock.className = "quantity";
    const label = document.createElement("label");
    appendAll(label, `${quantityLabel} `);
    const input = document.createElement("input");
    input.type = "number";
    input.min = "1";
    input.max = String(product.stock);
    input.value = String(quantity);
    input.dataset["quantity"] = "";
    appendAll(label, input);
    const qtyRow = document.createElement("div");
    qtyRow.className = "qty-row";
    appendAll(qtyRow, label, removeButton);
    const available = document.createElement("span");
    available.textContent = availableTemplate.replace("{count}", String(product.stock));
    const lineTotal = document.createElement("strong");
    lineTotal.dataset["lineTotal"] = "";
    appendAll(quantityBlock, qtyRow, available, lineTotal);

    appendAll(article, img, info, quantityBlock);
    return article;
  }

  async function render(): Promise<void> {
    const cart = readCart();
    if (emptyState) emptyState.hidden = cart.length > 0;
    if (summary) summary.hidden = cart.length === 0;
    container?.querySelectorAll("article[data-product-id]").forEach((el) => el.remove());
    if (!cart.length) {
      if (subtotalEl) subtotalEl.textContent = money(0);
      return;
    }

    const products = await fetchLines(cart.map((item) => item.id));
    const byId = new Map(products.map((product) => [product.id, product]));
    let subtotal = 0;
    for (const item of cart) {
      const product = byId.get(item.id);
      if (!product) continue;
      const line = renderLine(product, item.quantity);
      const lineTotalCents = product.priceCents * item.quantity;
      subtotal += lineTotalCents;
      const lineTotalEl = line.querySelector<HTMLElement>("[data-line-total]");
      if (lineTotalEl) lineTotalEl.textContent = money(lineTotalCents / 100);
      if (container) appendAll(container, line);
    }
    if (subtotalEl) subtotalEl.textContent = money(subtotal / 100);
  }

  document.addEventListener("change", (event) => {
    const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-quantity]");
    if (!input) return;
    const id = Number(input.closest<HTMLElement>("[data-product-id]")?.dataset["productId"]);
    const max = Number(input.max) || 1;
    setQuantity(id, Math.min(max, Math.max(1, Number(input.value) || 1)));
  });

  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest("[data-remove-item]");
    if (!button) return;
    const id = Number(button.closest<HTMLElement>("[data-product-id]")?.dataset["productId"]);
    removeFromCart(id);
  });

  onCartChange(render);
</script>

<style>
  main { width: min(100% - 2.5rem, 78rem); margin-inline: auto; padding-block: 4.5rem 5rem; }
  header p { margin: 0; color: var(--tk-color-accent); font-size: var(--tk-font-size-xs); font-weight: var(--tk-font-weight-bold); letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { margin: var(--tk-spacing-2) 0 2.5rem; font-family:var(--tk-font-family-display); font-size: clamp(3rem, 6vw, 5.4rem); font-weight:400; letter-spacing: -0.05em; line-height:.95; }
  .cart-layout { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: var(--tk-spacing-8); align-items: start; }
  .cart-items { display: grid; gap: var(--tk-spacing-4); }
  .cart-items :global(article) { display: grid; grid-template-columns: 7rem minmax(0, 1fr) auto; gap: var(--tk-spacing-4); align-items: center; padding-bottom: var(--tk-spacing-4); border-bottom: 1px solid var(--tk-color-border); }
  .cart-items :global(article img) { width: 7rem; height: 7rem; border-radius: var(--tk-radius-lg); object-fit: cover; background: var(--tk-color-bg-subtle); }
  .cart-items :global(article h2), .cart-items :global(article p) { margin: 0; }
  .cart-items :global(article h2) { font-size: var(--tk-font-size-lg); }
  .cart-items :global(article h2 a) { color: var(--tk-color-fg); text-decoration: none; }
  .cart-items :global(article p) { margin-top: var(--tk-spacing-1); color: var(--tk-color-fg-muted); font-size: var(--tk-font-size-sm); }
  .cart-items :global(article button) { padding: 0; border: 0; background: transparent; color: var(--tk-color-danger); cursor: pointer; font: inherit; font-size: var(--tk-font-size-xs); }
  .cart-items :global(.quantity) { display: grid; justify-items: end; gap: var(--tk-spacing-3); }
  .cart-items :global(.quantity .qty-row) { display: flex; align-items: center; gap: var(--tk-spacing-3); }
  .cart-items :global(.quantity label) { color: var(--tk-color-fg-muted); font-size: var(--tk-font-size-xs); }
  .cart-items :global(.quantity span) { color: var(--tk-color-fg-muted); font-size:10px; }
  .cart-items :global(input) { width: 3.5rem; margin-left: var(--tk-spacing-1); padding: var(--tk-spacing-2); border: 1px solid var(--tk-color-border); border-radius: var(--tk-radius-md); background: var(--tk-color-bg); color: var(--tk-color-fg); }
  aside { padding: var(--tk-spacing-5); border: 1px solid var(--tk-color-border); border-radius: var(--tk-radius-xl); background: var(--tk-color-bg-subtle); }
  aside h2 { margin-top: 0; }
  aside div { display: flex; justify-content: space-between; padding-block: var(--tk-spacing-4); border-block: 1px solid var(--tk-color-border); }
  aside p { color: var(--tk-color-fg-muted); font-size: var(--tk-font-size-xs); }
  aside a, .empty a { display: block; margin-top: var(--tk-spacing-4); padding: var(--tk-spacing-3); border-radius: var(--tk-radius-md); background: var(--tk-color-accent); color: var(--tk-color-accent-fg); font-size: var(--tk-font-size-sm); font-weight: var(--tk-font-weight-bold); text-align: center; text-decoration: none; }
  .empty { display:grid; min-height:20rem; place-items:center; align-content:center; padding:2.5rem; border:1px solid var(--tk-color-border); border-radius:var(--tk-radius-md); background:var(--tk-color-surface); text-align:center; }.empty-mark { display:grid; width:4rem; height:4rem; place-items:center; border:1px solid var(--tk-color-border); border-radius:50%; color:var(--tk-color-accent); font-size:2rem; }.empty h2 { margin:1.25rem 0 .45rem; font-family:var(--tk-font-family-display); font-size:2rem; font-weight:400; }
  .empty p { color: var(--tk-color-fg-muted); }
  .empty a { width: fit-content; margin-inline: auto; }
  @media (max-width: 48rem) { main { width:min(100% - 1.5rem,78rem); padding-top:3rem; }.cart-layout { grid-template-columns: 1fr; } .cart-items :global(article) { grid-template-columns: 5rem minmax(0, 1fr); } .cart-items :global(article img) { width: 5rem; height: 5rem; } .cart-items :global(.quantity) { grid-column: 2; justify-items: start; } }
</style>
