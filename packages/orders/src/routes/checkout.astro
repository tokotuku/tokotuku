---
import { env } from "cloudflare:workers";
import { createTranslator } from "@tokotuku/core";
import { brand, money } from "@tokotuku/core/brand";
import Icon from "@tokotuku/ui/Icon.astro";
import Layout from "@tokotuku/ui/Layout.astro";
import StoreHeader from "@tokotuku/ui/StoreHeader.astro";
import { orderMessages } from "../messages";
import {
  type CartLineInput,
  createOrder,
  findCustomerOrder,
  type PaymentMethod,
  paymentMethods,
} from "../orders";

const bankAccount = { bank: "BCA", accountNumber: "1234567890", accountName: "Tokotuku" };
const id = brand.locale.toLowerCase().startsWith("id");
const t = createTranslator(brand, orderMessages);

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login?next=/checkout");

let error = "";

if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const required = (name: string, label: string) => {
      const value = String(form.get(name) ?? "").trim();
      if (!value) throw new Error(t("orders.checkout.error.required", { label }));
      return value;
    };
    let cart: CartLineInput[] = [];
    try {
      cart = JSON.parse(String(form.get("cart") ?? "[]"));
    } catch {
      throw new Error(t("orders.checkout.error.invalidCart"));
    }
    if (!Array.isArray(cart)) throw new Error(t("orders.checkout.error.invalidCart"));
    const paymentMethod = String(form.get("paymentMethod") ?? "cash") as PaymentMethod;
    if (!paymentMethods.includes(paymentMethod))
      throw new Error(t("orders.checkout.error.invalidPayment"));
    return Astro.redirect(
      `/checkout?order=${encodeURIComponent(
        (
          await createOrder(
            env.DB,
            user.id,
            {
              customerName: required("customerName", t("orders.checkout.fullName")),
              customerEmail: user.email,
              customerPhone: required("customerPhone", t("orders.checkout.phone")),
              address: required("address", t("orders.checkout.address")),
              city: required("city", t("orders.checkout.city")),
              postalCode: required("postalCode", t("orders.checkout.postalCode")),
              note: String(form.get("note") ?? "").trim(),
            },
            cart,
            paymentMethod,
          )
        ).orderNumber,
      )}`,
    );
  } catch (caught) {
    error = caught instanceof Error ? caught.message : t("orders.checkout.error.generic");
  }
}

const requestedOrder = Astro.url.searchParams.get("order");
const completedOrder = requestedOrder
  ? await findCustomerOrder(env.DB, requestedOrder, user.id)
  : null;
const proofError = Astro.url.searchParams.get("proofError");
---

<Layout title={(id ? "Checkout" : "Checkout") + " — " + brand.name} siteName={brand.name} lang={id ? "id" : "en"}>
  <StoreHeader brand={brand} showCart={true} current="cart" announcement={brand.storefront?.announcement ?? (id ? "Objek untuk ritual sehari-hari." : "Objects for everyday rituals.")} labels={{ home: id ? "Beranda" : "Home", shop: id ? "Toko" : "Shop", cart: id ? "Keranjang" : "Cart" }} />
  <main>
    {completedOrder ? (
      <section class="success-card">
        <span class="success-icon"><Icon name="check" size={22} /></span><p class="eyebrow">{t("orders.checkout.successEyebrow")}</p><h1>{t("orders.checkout.successTitle")}</h1>
        <p>{t("orders.checkout.successDescription", { order: completedOrder.orderNumber })}</p>
        {completedOrder.paymentMethod === "cash" ? (
          <div class="cash-note"><strong>{t("orders.checkout.cashTitle")}</strong><span>{t("orders.checkout.cashDueDescription", { total: money(completedOrder.totalCents / 100) })}</span></div>
        ) : completedOrder.paymentStatus === "paid" ? (
          <div class="cash-note"><strong>{t("orders.checkout.paidTitle")}</strong><span>{t("orders.checkout.paidDescription")}</span></div>
        ) : completedOrder.paymentProofKey ? (
          <div class="cash-note"><strong>{t("orders.checkout.proofSentTitle")}</strong><span>{t("orders.checkout.proofSentDescription")}</span></div>
        ) : (
          <div class="cash-note">
            <strong>{t("orders.checkout.transferTitle")}</strong>
            <span>{t("orders.checkout.transferAccount", { bank: bankAccount.bank, account: bankAccount.accountNumber, name: bankAccount.accountName, total: money(completedOrder.totalCents / 100) })}</span>
            {proofError && <p class="checkout-error" role="alert">{proofError}</p>}
            <form method="post" action="/api/orders/proof" enctype="multipart/form-data" class="proof-form">
              <input type="hidden" name="orderNumber" value={completedOrder.orderNumber} />
              <label>{t("orders.checkout.uploadProof")}<input type="file" name="proof" accept="image/*,application/pdf" required /></label>
              <button type="submit">{t("orders.checkout.sendProof")}</button>
            </form>
          </div>
        )}
        <a class="primary-link" href="/products">{t("orders.checkout.continueShopping")}</a>
      </section>
    ) : (
      <>
        <p class="eyebrow">{t("orders.checkout.eyebrow")}</p><h1>{t("orders.checkout.title")}</h1>
        {error && <p class="checkout-error" role="alert">{error}</p>}
        <form method="post" data-checkout-form>
          <input type="hidden" name="cart" data-cart-payload />
          <div class="checkout-grid">
            <section>
              <h2>{t("orders.checkout.contact")}</h2>
              <div class="fields"><label>{t("auth.login.emailLabel")}<input type="email" value={user.email} readonly /></label><label>{t("orders.checkout.phone")}<input name="customerPhone" type="tel" required autocomplete="tel" /></label></div>
              <h2>{t("orders.checkout.shipping")}</h2>
              <div class="fields">
                <label>{t("orders.checkout.fullName")}<input name="customerName" required value={user.name} autocomplete="name" /></label>
                <label>{t("orders.checkout.city")}<input name="city" required autocomplete="address-level2" /></label>
                <label class="wide">{t("orders.checkout.address")}<textarea name="address" required rows="3" autocomplete="street-address"></textarea></label>
                <label>{t("orders.checkout.postalCode")}<input name="postalCode" required autocomplete="postal-code" /></label>
                <label>{t("orders.checkout.note")}<input name="note" placeholder={t("orders.checkout.optional")} /></label>
              </div>
            </section>
            <aside>
              <h2>{t("orders.checkout.summary")}</h2><div class="order-lines" data-order-lines data-empty-label={t("orders.checkout.emptyCart")}></div>
              <div class="total"><span>{t("orders.checkout.total")}</span><strong data-order-total>{money(0)}</strong></div>
              <fieldset class="payment-methods">
                <legend>{t("orders.checkout.payment")}</legend>
                <label class="payment-option"><input type="radio" name="paymentMethod" value="cash" checked />{t("orders.checkout.cash")} <span>{t("orders.checkout.cashDescription")}</span></label>
                <label class="payment-option"><input type="radio" name="paymentMethod" value="transfer" />{t("orders.checkout.transfer")} <span>{t("orders.checkout.transferDescription")}</span></label>
              </fieldset>
              <button type="submit" data-place-order disabled>{t("orders.checkout.submit")}</button>
              <a href="/cart">← {t("orders.checkout.back")}</a>
            </aside>
          </div>
        </form>
      </>
    )}
  </main>
</Layout>

{completedOrder && <script>
  import { clearCart } from "../client/cart";
  clearCart();
</script>}
{!completedOrder && <script>
  import { money } from "@tokotuku/core/brand";
  import { readCart } from "../client/cart";
  import { appendAll } from "../client/dom";

  interface CartLineProduct { id: number; name: string; priceCents: number; }

  const payload = document.querySelector<HTMLInputElement>("[data-cart-payload]");
  const lines = document.querySelector<HTMLElement>("[data-order-lines]");
  const total = document.querySelector<HTMLElement>("[data-order-total]");
  const button = document.querySelector<HTMLButtonElement>("[data-place-order]");
  const emptyCartLabel = lines?.dataset["emptyLabel"] ?? "Your cart is empty.";

  async function render(): Promise<void> {
    const cart = readCart().map((item) => ({
      id: Number(item.id),
      quantity: Math.min(99, Math.max(1, Math.trunc(Number(item.quantity)))),
    }));

    const ids = cart.map((item) => item.id).join(",");
    const response = cart.length ? await fetch(`/api/cart/lines?ids=${encodeURIComponent(ids)}`) : null;
    const data = response?.ok ? ((await response.json()) as { products: CartLineProduct[] }) : { products: [] };
    const byId = new Map(data.products.map((product) => [product.id, product]));
    const validCart = cart.filter((item) => byId.has(item.id));

    if (payload) payload.value = JSON.stringify(validCart);
    if (lines) lines.textContent = "";
    let totalCents = 0;
    for (const item of validCart) {
      const product = byId.get(item.id);
      if (!product) continue;
      const lineTotalCents = product.priceCents * item.quantity;
      totalCents += lineTotalCents;
      const row = document.createElement("div");
      row.className = "order-line";
      const name = document.createElement("span");
      name.textContent = `${product.name} × ${item.quantity}`;
      const price = document.createElement("strong");
      price.textContent = money(lineTotalCents / 100);
      appendAll(row, name, price);
      if (lines) appendAll(lines, row);
    }
    if (!validCart.length && lines) lines.textContent = emptyCartLabel;
    if (total) total.textContent = money(totalCents / 100);
    if (button) button.disabled = validCart.length === 0;
  }

  render();
</script>}

<style>
  main { width:min(100% - calc(var(--tk-spacing-4) * 2),68rem);margin-inline:auto;padding-block:var(--tk-spacing-10) var(--tk-spacing-12) }.eyebrow{margin:0;color:var(--tk-color-accent);font-size:var(--tk-font-size-xs);font-weight:var(--tk-font-weight-bold);letter-spacing:.1em;text-transform:uppercase}h1{margin:var(--tk-spacing-2) 0 var(--tk-spacing-8);font-size:clamp(2.5rem,6vw,5rem);letter-spacing:-.05em}.checkout-grid{display:grid;grid-template-columns:minmax(0,1fr) 22rem;gap:var(--tk-spacing-8);align-items:start}.checkout-grid section,.checkout-grid aside,.success-card{padding:var(--tk-spacing-6);border:1px solid var(--tk-color-border);border-radius:var(--tk-radius-xl)}section h2:first-child,aside h2{margin-top:0}section h2:not(:first-child){margin-top:var(--tk-spacing-7)}label{display:grid;gap:var(--tk-spacing-2);color:var(--tk-color-fg-muted);font-size:var(--tk-font-size-sm)}input,textarea{box-sizing:border-box;width:100%;min-height:2.75rem;padding:var(--tk-spacing-3);border:1px solid var(--tk-color-border);border-radius:var(--tk-radius-md);background:var(--tk-color-bg);color:var(--tk-color-fg);font:inherit}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--tk-spacing-4)}.wide{grid-column:1/-1}aside{background:var(--tk-color-bg-subtle)}.order-lines{display:grid;gap:10px}.order-lines :global(.order-line){display:flex;justify-content:space-between;gap:12px;font-size:var(--tk-font-size-sm)}.total{display:flex;justify-content:space-between;margin-top:18px;padding:16px 0;border-block:1px solid var(--tk-color-border)}.payment,.cash-note{display:grid;gap:5px;margin:16px 0;padding:13px;border-radius:10px;background:color-mix(in srgb,var(--tk-color-accent) 9%,var(--tk-color-bg))}.payment span,.cash-note span{color:var(--tk-color-fg-muted);font-size:var(--tk-font-size-xs);line-height:1.5}button,.primary-link{display:flex;width:100%;min-height:2.9rem;box-sizing:border-box;align-items:center;justify-content:center;border:0;border-radius:var(--tk-radius-md);background:var(--tk-color-accent);color:var(--tk-color-accent-fg);font:inherit;font-weight:var(--tk-font-weight-semibold);text-decoration:none;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}aside>a{display:block;margin-top:var(--tk-spacing-4);color:var(--tk-color-accent);font-size:var(--tk-font-size-sm)}.checkout-error{padding:12px 14px;border-radius:10px;background:color-mix(in srgb,var(--tk-color-danger) 9%,var(--tk-color-bg));color:var(--tk-color-danger)}.success-card{max-width:38rem;margin:auto;text-align:center}.success-card h1{margin-bottom:20px}.success-icon{display:grid;width:60px;height:60px;margin:0 auto 20px;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--tk-color-success) 14%,var(--tk-color-bg));color:var(--tk-color-success);font-size:28px}.success-card .cash-note{text-align:left;margin:25px 0}.primary-link{width:fit-content;margin:auto;padding-inline:22px}@media(max-width:48rem){.checkout-grid,.fields{grid-template-columns:1fr}.wide{grid-column:auto}}
  .payment-methods { display: grid; gap: var(--tk-spacing-2); margin: 16px 0; padding: 0; border: 0; }
  .payment-methods legend { padding: 0 0 8px; color: var(--tk-color-fg); font-size: var(--tk-font-size-sm); font-weight: var(--tk-font-weight-semibold); }
  .payment-option { display: flex; flex-direction: row; align-items: center; gap: 8px; padding: 12px; border: 1px solid var(--tk-color-border); border-radius: var(--tk-radius-md); font-size: var(--tk-font-size-sm); color: var(--tk-color-fg); cursor: pointer; }
  .payment-option input { width: auto; min-height: auto; }
  .payment-option span { color: var(--tk-color-fg-muted); font-size: var(--tk-font-size-xs); }
  .proof-form { display: grid; gap: 10px; margin-top: 8px; }
  .proof-form input[type="file"] { padding: 8px; }
  .proof-form button { min-height: 2.5rem; }
</style>
