---
import Icon from "@karsa/ui/Icon.astro";
---
<template data-added-icon><Icon name="check" size={16} /></template>
<script>
  import { addToCart, cartCount, onCartChange, readCart } from "../../client/cart";

  function syncCartBadge(): void {
    const count = cartCount(readCart());
    for (const element of document.querySelectorAll<HTMLElement>("[data-site-action-badge]")) {
      element.textContent = String(count);
    }
  }

  const addedIconTemplate = document.querySelector<HTMLTemplateElement>("[data-added-icon]");

  // Delegated (not bound per-button) so any page can render a
  // [data-add-to-cart] button without wiring its own handler.
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-add-to-cart]");
    if (!button?.dataset["product"]) return;

    addToCart(JSON.parse(button.dataset["product"]));

    const addedLabel = document.documentElement.lang.toLowerCase().startsWith("id")
      ? "Ditambahkan"
      : "Added";
    const originalAriaLabel = button.getAttribute("aria-label");

    // Icon-only buttons (e.g. the product-card "+" button) get the SVG
    // swapped for a check mark instead of text, which would overflow their
    // fixed circular size.
    if (button.querySelector("svg") && addedIconTemplate) {
      const originalContent = button.innerHTML;
      button.replaceChildren(addedIconTemplate.content.cloneNode(true));
      if (originalAriaLabel) button.setAttribute("aria-label", addedLabel);
      window.setTimeout(() => {
        button.innerHTML = originalContent;
        if (originalAriaLabel) button.setAttribute("aria-label", originalAriaLabel);
      }, 1000);
    } else {
      const originalText = button.textContent;
      button.textContent = addedLabel;
      window.setTimeout(() => {
        button.textContent = originalText;
      }, 1000);
    }
  });

  onCartChange(syncCartBadge);
</script>
