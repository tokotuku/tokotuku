    "astro": "^7.0.9"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "astro": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "typecheck": "astro check"
