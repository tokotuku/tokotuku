{
  "name": "@tokotuku/orders",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
