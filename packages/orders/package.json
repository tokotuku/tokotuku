  },
  "dependencies": {
    "@tokotuku/catalog": "workspace:*",
    "@tokotuku/core": "workspace:*",
    "@tokotuku/ui": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
