---
import { env } from "cloudflare:workers";
import { createTranslator } from "@karsa/core";
import { brand, date } from "@karsa/core/brand";
import Icon from "@karsa/ui/Icon.astro";
import { listBookings } from "../../bookings";
import { bookingMessages } from "../../messages";

const t = createTranslator(brand, bookingMessages);
const todayIso = new Date().toISOString().slice(0, 10);
const sevenDaysOut = new Date();
sevenDaysOut.setUTCDate(sevenDaysOut.getUTCDate() + 7);
const upcomingPage = await listBookings(env.DB, {
  from: todayIso,
  to: sevenDaysOut.toISOString().slice(0, 10),
  pageSize: 5,
});
const upcoming = upcomingPage.items;

import "./BookingDashboardWidget.css";
---

<section class="booking-widget panel" data-dashboard-widget="booking" aria-labelledby="booking-widget-title">
  <div class="widget-heading"><div><p class="eyebrow">{t("booking.dashboard.eyebrow")}</p><h2 id="booking-widget-title">{t("booking.dashboard.title")}</h2></div><a href="/admin/bookings">{t("booking.dashboard.manage")} ↗</a></div>
  {upcoming.length === 0 && (
    <div class="zero-state"><div class="zero-icon"><Icon paths={["M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z", "M8 2v4", "M16 2v4", "M3 10h18"]} size={22} /></div><h3>{t("booking.dashboard.empty")}</h3><p>{t("booking.dashboard.emptyDescription")}</p></div>
  )}
  {upcoming.length > 0 && (
    <div class="booking-list">
      <h3>{t("booking.dashboard.upcoming")}</h3>
      {upcoming.slice(0, 5).map((booking) => (
        <a href={"/admin/inquiries#" + booking.orderId} class="booking-row">
          <span><strong>{booking.itemName}</strong><small>{booking.customerName}</small></span>
          <span class="booking-row-date">{date(new Date(booking.startDate))}</span>
        </a>
      ))}
    </div>
  )}
</section>
