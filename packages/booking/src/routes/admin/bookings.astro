---
import { env } from "cloudflare:workers";
import brand from "virtual:takontuku/config";
import { CursorError, createTranslator } from "@takontuku/core";
import { date } from "@takontuku/core/brand";
import AdminLayout from "@takontuku/core/layouts/AdminLayout.astro";
import AdminInspector from "@takontuku/ui/AdminInspector.astro";
import AdminPageHeader from "@takontuku/ui/AdminPageHeader.astro";
import AdminQuickView from "@takontuku/ui/AdminQuickView.astro";
import CursorPagination from "@takontuku/ui/CursorPagination.astro";
import Icon from "@takontuku/ui/Icon.astro";
import InspectorMetric from "@takontuku/ui/InspectorMetric.astro";
import { type Booking, getBookingDashboardSummary, listBookings } from "../../bookings";
import { bookingMessages } from "../../messages";

const t = createTranslator(brand, bookingMessages);
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";
const weekdayNames =
  locale === "id"
    ? ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"]
    : ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const showAll = Astro.url.searchParams.get("all") === "1";
const after = Astro.url.searchParams.get("after") ?? undefined;
const before = Astro.url.searchParams.get("before") ?? undefined;
const search = Astro.url.searchParams.get("q") ?? undefined;
const status = Astro.url.searchParams.get("status") || undefined;
const todayIso = new Date().toISOString().slice(0, 10);
let bookingPage: Awaited<ReturnType<typeof listBookings>>;
try {
  bookingPage = await listBookings(env.DB, {
    ...(showAll ? {} : { from: todayIso }),
    pageSize: 25,
    ...(status ? { status } : {}),
    ...(search ? { search } : {}),
    ...(after ? { after } : {}),
    ...(before ? { before } : {}),
  });
} catch (caught) {
  if (caught instanceof CursorError) return new Response(caught.message, { status: 400 });
  throw caught;
}
const bookings = bookingPage.items;
const overlapping = new Set(
  bookings.filter((booking) => booking.hasOverlap).map((booking) => booking.orderId),
);
const summary = await getBookingDashboardSummary(env.DB);
const statusOptions = [
  "inquiry",
  "quoted",
  "pending",
  "confirmed",
  "in_progress",
  "delivered",
  "completed",
  "cancelled",
];
function statusHref(nextStatus?: string): string {
  const params = new URLSearchParams();
  if (showAll) params.set("all", "1");
  if (nextStatus) params.set("status", nextStatus);
  if (search) params.set("q", search);
  const query = params.toString();
  return query ? `/admin/bookings?${query}` : "/admin/bookings";
}
function modeHref(): string {
  const params = new URLSearchParams();
  if (!showAll) params.set("all", "1");
  if (status) params.set("status", status);
  if (search) params.set("q", search);
  const query = params.toString();
  return query ? `/admin/bookings?${query}` : "/admin/bookings";
}
function dateRangeFor(booking: Booking): string {
  const start = date(new Date(booking.startDate));
  if (booking.mode === "slot") {
    const weekday = booking.slotWeekday === null ? "" : weekdayNames[booking.slotWeekday];
    return `${start} · ${weekday} ${booking.slotStartTime ?? ""}`;
  }
  if (booking.endDate && booking.endDate !== booking.startDate) {
    return `${start} – ${date(new Date(booking.endDate))}`;
  }
  return start;
}
function adminActionLabel(showingAll: boolean, localeCode: "id" | "en"): string {
  if (showingAll) return localeCode === "id" ? "Hanya mendatang" : "Upcoming only";
  return localeCode === "id" ? "Lihat semua" : "View all";
}
function bookingStatusTone(status: Booking["status"]): string {
  if (status === "cancelled") return "danger";
  if (status === "confirmed" || status === "completed") return "success";
  return "warning";
}
const bookingStatusClassByTone: Record<string, string> = {
  danger: "status--danger",
  success: "status--success",
  warning: "status--warning",
};
function bookingStatusClass(status: Booking["status"]): string {
  return bookingStatusClassByTone[bookingStatusTone(status)] ?? "status--warning";
}
const upcomingCount = summary.upcomingCount;
const nearestDate = summary.nearestDate ?? "—";
const statusCounts = new Map(Object.entries(summary.statusCounts));

import "../../styles/routes/booking-admin.css";
---

<AdminLayout title={t("booking.admin.title")}>
  {bookings.length === 0 && (
    <section class="standalone-empty" data-bookings-empty>
      <div class="empty-symbol"><Icon paths={["M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z", "M8 2v4", "M16 2v4", "M3 10h18"]} size={27} /></div>
      <p class="eyebrow">{t("booking.admin.eyebrow")}</p><h1>{t("booking.admin.empty")}</h1><p>{t("booking.admin.emptyDescription")}</p>
      {!showAll && <a class="admin-button" href={modeHref()}>{locale === "id" ? "Lihat semua" : "View all"}</a>}
    </section>
  )}
  {bookings.length > 0 && (
    <>
      <AdminPageHeader eyebrow={t("booking.admin.eyebrow")} title={t("booking.admin.title")} description={t("booking.admin.description")}>
        <Fragment slot="actions"><a class="admin-button" href={modeHref()}>{adminActionLabel(showAll, locale)}</a></Fragment>
      </AdminPageHeader>
      <section class="panel data-panel" data-booking-table data-result-template={`${bookings.length} booking`} data-no-match={locale === "id" ? "Tidak ada booking yang cocok" : "No matching bookings"}>
        <div class="table-toolbar"><div class="filter-tabs" role="tablist" aria-label={t("booking.admin.status")}><a aria-current={!status ? "page" : undefined} href={statusHref()}>{locale === "id" ? "Semua" : "All"}</a>{statusOptions.map((item) => <a aria-current={status === item ? "page" : undefined} href={statusHref(item)}>{item}</a>)}</div><form method="get" class="table-search"><label class="sr-only" for="booking-admin-search">{t("booking.admin.search")}</label><input id="booking-admin-search" type="search" name="q" value={search ?? ""} placeholder={t("booking.admin.searchPlaceholder")} />{showAll && <input type="hidden" name="all" value="1" />}{status && <input type="hidden" name="status" value={status} />}</form></div>
        <div class="table-wrap"><table class="admin-table"><thead><tr><th>{t("booking.admin.order")}</th><th>{t("booking.admin.service")}</th><th>{t("booking.admin.customer")}</th><th>{t("booking.admin.date")}</th><th>{t("booking.admin.address")}</th><th>{t("booking.admin.status")}</th><th><span class="sr-only">{t("booking.admin.previewTitle")}</span></th></tr></thead><tbody>
          {bookings.map((booking) => <tr data-row data-search={`${booking.orderNumber} ${booking.itemName} ${booking.customerName} ${booking.customerPhone} ${booking.serviceAddress}`.toLowerCase()}><td><strong>#{booking.orderNumber}</strong>{overlapping.has(booking.orderId) && <span class="overlap-badge">{t("booking.admin.overlap")}</span>}</td><td>{booking.itemName}</td><td><div class="entity"><span class="entity-avatar">{booking.customerName.slice(0, 2).toUpperCase()}</span><div><strong>{booking.customerName}</strong><span>{booking.customerPhone}</span></div></div></td><td>{dateRangeFor(booking)}</td><td class="address-cell">{booking.serviceAddress}</td><td><span class:list={["status", bookingStatusClass(booking.status)]}>{booking.status}</span></td><td><div class="row-actions"><button type="button" data-quick-view-target="booking-quick-view" data-quick-view-endpoint={`/admin/api/bookings/${booking.orderId}`} data-quick-view-title={`#${booking.orderNumber}`} data-quick-view-meta={booking.itemName} data-quick-view-overlap={String(overlapping.has(booking.orderId))} aria-label={`${t("booking.admin.previewTitle")}: ${booking.orderNumber}`}><Icon name="eye" size={16} /></button><a href={`/admin/orders#${booking.orderId}`} aria-label={t("booking.admin.viewOrder")}><Icon name="arrowRight" size={16} /></a></div></td></tr>)}
        </tbody></table></div><div class="table-footer"><span data-result-count>{bookings.length} booking</span></div>
      </section>
      <CursorPagination pageInfo={bookingPage.pageInfo} />
    </>
  )}

  <Fragment slot="inspector">
    <AdminInspector title={t("booking.admin.title")} description={t("booking.admin.description")}>
      <div class="inspector-metrics"><InspectorMetric label={locale === "id" ? "Mendatang" : "Upcoming"} value={String(upcomingCount)} tone={upcomingCount ? "positive" : "default"} /><InspectorMetric label={locale === "id" ? "Bentrok" : "Clashes"} value={String(summary.clashCount)} tone={summary.clashCount ? "warning" : "default"} /><InspectorMetric label={locale === "id" ? "Tanggal terdekat" : "Nearest date"} value={nearestDate === "—" ? nearestDate : date(new Date(nearestDate))} /></div>
    </AdminInspector>
    <AdminInspector title={t("booking.admin.status")}><dl class="inspector-list">{[...statusCounts.entries()].map(([status, count]) => <div><dt>{status}</dt><dd>{count}</dd></div>)}{statusCounts.size === 0 && <div><dt>—</dt><dd>0</dd></div>}</dl></AdminInspector>
  </Fragment>

  <AdminQuickView id="booking-quick-view" titleLabel={t("booking.admin.previewTitle")} closeLabel={t("booking.admin.previewClose")} loadingLabel={t("booking.admin.previewLoading")} errorLabel={t("booking.admin.previewError")} retryLabel={t("booking.admin.previewRetry")} />
</AdminLayout>

{bookings.length > 0 && <script>
  type BookingDetail = { orderId:number; orderNumber:string; itemId:number; itemName:string; mode:string; startDate:string; endDate:string|null; slotId:number|null; slotWeekday:number|null; slotStartTime:string|null; occurrencesPerDay:number; serviceAddress:string; note:string; status:string; customerName:string; customerPhone:string };
  const locale = document.documentElement.lang === "id" ? "id-ID" : "en-US";
  const addTextRow = (parent:HTMLElement, label:string, value:string) => { const row = document.createElement("div"); const dt = document.createElement("dt"); dt.textContent = label; const dd = document.createElement("dd"); dd.textContent = value || "—"; row.append(dt, dd); parent.append(row); };
  const addSection = (parent:HTMLElement, heading:string, content:HTMLElement) => { const section = document.createElement("section"); section.className = "quick-view-section"; const title = document.createElement("h3"); title.textContent = heading; section.append(title, content); parent.append(section); };
  document.addEventListener("takontuku:quick-view-loaded", (event) => { const detail = (event as CustomEvent<{data:BookingDetail;trigger:HTMLElement;dialog:HTMLDialogElement}>).detail; if (detail.dialog.id !== "booking-quick-view") return; const body = detail.dialog.querySelector<HTMLElement>("[data-quick-view-body]"); const footer = detail.dialog.querySelector<HTMLElement>("[data-quick-view-footer]"); if (!body || !footer) return; const booking = detail.data; body.replaceChildren(); footer.replaceChildren(); const wrapper = document.createElement("div"); wrapper.className = "quick-view-data"; const heading = document.createElement("h3"); heading.textContent = booking.itemName; wrapper.append(heading); const facts = document.createElement("dl"); addTextRow(facts, "Order", `#${booking.orderNumber}`); addTextRow(facts, "Tanggal", new Intl.DateTimeFormat(locale, { dateStyle:"medium" }).format(new Date(booking.startDate))); addTextRow(facts, "Slot", [booking.slotStartTime, booking.endDate && booking.endDate !== booking.startDate ? `sampai ${booking.endDate}` : ""].filter(Boolean).join(" · ") || booking.mode); addTextRow(facts, "Status", booking.status); addSection(wrapper, "Jadwal", facts); const customer = document.createElement("dl"); addTextRow(customer, "Nama", booking.customerName); addTextRow(customer, "Telepon", booking.customerPhone); addTextRow(customer, "Alamat", booking.serviceAddress); addSection(wrapper, "Pelanggan", customer); if (booking.note) { const note = document.createElement("p"); note.className = "quick-view-note"; note.textContent = booking.note; addSection(wrapper, "Catatan", note); } if (detail.trigger.dataset["quickViewOverlap"] === "true") { const warning = document.createElement("p"); warning.className = "booking-warning"; warning.textContent = "Booking ini memiliki bentrok jadwal dengan booking lain."; wrapper.append(warning); } body.append(wrapper); const orderLink = document.createElement("a"); orderLink.className = "admin-button admin-button--primary"; orderLink.href = `/admin/orders#${booking.orderId}`; orderLink.textContent = "Buka pesanan"; const serviceLink = document.createElement("a"); serviceLink.className = "admin-button"; serviceLink.href = `/admin/products/${booking.itemId}/edit`; serviceLink.textContent = "Lihat layanan"; footer.append(orderLink, serviceLink); });
</script>}
