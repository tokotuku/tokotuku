---
import { env } from "cloudflare:workers";
import { findItemById } from "@karsa/catalog";
import { createTranslator } from "@karsa/core";
import { brand } from "@karsa/core/brand";
import { createInquiryOrder } from "@karsa/orders";
import Layout from "@karsa/ui/DocumentLayout.astro";
import Icon from "@karsa/ui/Icon.astro";
import SiteHeader from "@karsa/ui/SiteHeader.astro";
import type { BookingRequestAttributes } from "../../booking-hooks";
import { findItemSchedule, listSlots } from "../../bookings";
import { bookingMessages } from "../../messages";
import {
  clientAddress,
  clientKey,
  consumeBookingQuota,
  daysBetweenIso,
  findBookingByFingerprint,
  isCanonicalIsoDate,
  submissionFingerprint,
  verifyTurnstile,
} from "../../submission-security";

const t = createTranslator(brand, bookingMessages);
const locale = brand.locale.toLowerCase().startsWith("id") ? "id" : "en";

const itemId = Number(Astro.params["id"]);
const service = await findItemById(env.DB, itemId, { presentation: "services" });
const schedule = service ? await findItemSchedule(env.DB, itemId) : null;
// A service that exists but isn't fulfillmentType 'scheduled', or one that
// is but has no booking_item_schedule row yet (the admin hasn't configured
// it), gets the same "not bookable" state — the customer has no use for
// the distinction, and it isn't a 404 (the service itself is real).
const notBookable = service?.fulfillmentType !== "scheduled" || !schedule;
const slots = !notBookable && schedule?.mode === "slot" ? await listSlots(env.DB, itemId) : [];
const turnstileConfigured = Boolean(
  env.TURNSTILE_SITE_KEY?.trim() && env.TURNSTILE_SECRET?.trim() && env.TURNSTILE_HOSTNAMES?.trim(),
);
const weekdayNames =
  locale === "id"
    ? ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"]
    : ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

const todayIso = new Date().toISOString().slice(0, 10);

function addDays(iso: string, days: number): string {
  const date = new Date(`${iso}T00:00:00Z`);
  date.setUTCDate(date.getUTCDate() + days);
  return date.toISOString().slice(0, 10);
}

let error = "";
let orderNumber = Astro.url.searchParams.get("order");

if (!notBookable && schedule && Astro.request.method === "POST" && !orderNumber) {
  try {
    const form = await Astro.request.formData();
    if (!turnstileConfigured) throw new Error(t("booking.form.error.securityUnavailable"));
    const address = clientAddress(Astro.request, Astro.clientAddress);
    if (!address) throw new Error(t("booking.form.error.securityUnavailable"));
    const token = String(form.get("cf-turnstile-response") ?? "");
    if (!(await verifyTurnstile(env, token, address))) {
      throw new Error(t("booking.form.error.securityUnavailable"));
    }
    const required = (name: string, label: string) => {
      const value = String(form.get(name) ?? "").trim();
      if (!value) throw new Error(t("booking.form.error.required", { label }));
      return value;
    };
    const customerName = required("customerName", t("booking.form.name"));
    const customerPhone = required("customerPhone", t("booking.form.phone"));
    const customerEmail = String(form.get("customerEmail") ?? "").trim();
    const serviceAddress = required("serviceAddress", t("booking.form.address"));
    const note = String(form.get("note") ?? "").trim();
    const startDate = required("startDate", t("booking.form.startDate"));
    const requestTodayIso = new Date().toISOString().slice(0, 10);

    if (
      customerName.length > 100 ||
      customerPhone.length > 32 ||
      customerEmail.length > 254 ||
      serviceAddress.length > 1000 ||
      note.length > 2000
    ) {
      throw new Error(t("booking.form.error.invalidInput"));
    }
    if (customerEmail && !customerEmail.includes("@")) {
      throw new Error(t("booking.form.error.invalidInput"));
    }
    if (!isCanonicalIsoDate(startDate)) {
      throw new Error(t("booking.form.error.invalidDate"));
    }

    if (daysBetweenIso(requestTodayIso, startDate) < schedule.leadTimeDays) {
      throw new Error(t("booking.form.error.leadTime", { days: schedule.leadTimeDays }));
    }

    let attributes: BookingRequestAttributes;
    if (schedule.mode === "slot") {
      const slotId = Number(form.get("slotId"));
      const slot = slots.find((candidate) => candidate.id === slotId);
      if (!slot) throw new Error(t("booking.form.error.slotRequired"));
      if (new Date(`${startDate}T00:00:00Z`).getUTCDay() !== slot.weekday) {
        throw new Error(t("booking.form.error.weekdayMismatch"));
      }
      attributes = {
        itemId,
        mode: "slot",
        startDate,
        endDate: null,
        slotId: slot.id,
        occurrencesPerDay: 1,
      };
    } else {
      const endDate = required("endDate", t("booking.form.endDate"));
      if (!isCanonicalIsoDate(endDate)) throw new Error(t("booking.form.error.invalidDate"));
      if (endDate < startDate) throw new Error(t("booking.form.error.invalidDateRange"));
      const days = daysBetweenIso(startDate, endDate) + 1;
      if (days < schedule.minDays) {
        throw new Error(t("booking.form.error.minDays", { days: schedule.minDays }));
      }
      if (schedule.maxDays !== null && days > schedule.maxDays) {
        throw new Error(t("booking.form.error.maxDays", { days: schedule.maxDays }));
      }
      attributes = {
        itemId,
        mode: "range",
        startDate,
        endDate,
        slotId: null,
        occurrencesPerDay: schedule.occurrencesPerDay,
      };
    }

    if (!env.BETTER_AUTH_SECRET) throw new Error(t("booking.form.error.securityUnavailable"));
    const key = await clientKey(env.BETTER_AUTH_SECRET, address);
    const bucket = Math.floor(Date.now() / (15 * 60 * 1000));
    const fingerprint = await submissionFingerprint(env.BETTER_AUTH_SECRET, key, bucket, {
      itemId,
      mode: attributes.mode,
      startDate: attributes.startDate,
      endDate: attributes.endDate,
      slotId: attributes.slotId,
      customerName,
      customerPhone,
      customerEmail,
      serviceAddress,
      note,
    });
    const existing = await findBookingByFingerprint(env.DB, fingerprint);
    if (existing) {
      return Astro.redirect(`/booking/${itemId}?order=${encodeURIComponent(existing)}`);
    }
    await consumeBookingQuota(env.DB, key);

    try {
      const created = await createInquiryOrder(
        env.DB,
        itemId,
        {
          customerName,
          customerPhone,
          // exactOptionalPropertyTypes: only include the key when there's a
          // real value — an explicit `customerEmail: undefined` isn't the
          // same as the property being absent.
          ...(customerEmail ? { customerEmail } : {}),
          serviceAddress,
          note,
        },
        { booking: { ...attributes, submissionFingerprint: fingerprint } },
      );
      return Astro.redirect(`/booking/${itemId}?order=${encodeURIComponent(created.orderNumber)}`);
    } catch (caught) {
      const duplicate = await findBookingByFingerprint(env.DB, fingerprint);
      if (duplicate)
        return Astro.redirect(`/booking/${itemId}?order=${encodeURIComponent(duplicate)}`);
      throw caught;
    }
  } catch (caught) {
    error = caught instanceof Error ? caught.message : t("booking.form.error.generic");
    orderNumber = null;
  }
}

import "../../styles/routes/booking-id.css";
---

<Layout title={t("booking.detail.title") + " — " + brand.name} siteName={brand.name} lang={locale}>
  <SiteHeader brand={brand} announcement={brand.site?.announcement} links={[{ href: "/services", label: locale === "id" ? "Layanan" : "Services" }]} labels={{ home: locale === "id" ? "Beranda" : "Home" }} />
  <main>
    {orderNumber && (
      <section class="success-card">
        <span class="success-icon"><Icon name="check" size={22} /></span>
        <p class="eyebrow">{t("booking.detail.eyebrow")}</p>
        <h1>{t("booking.success.title")}</h1>
        <p>{t("booking.success.description", { orderNumber })}</p>
        <a class="primary-link" href="/">{t("booking.success.backHome")}</a>
      </section>
    )}
    {!orderNumber && notBookable && (
      <section class="success-card">
        <p class="eyebrow">{t("booking.detail.eyebrow")}</p>
        <h1>{t("booking.detail.notFound")}</h1>
        <a class="primary-link" href="/services">{t("booking.detail.backToService")}</a>
      </section>
    )}
    {!orderNumber && !notBookable && (
      <>
        <p class="eyebrow">{t("booking.detail.eyebrow")}</p>
        <h1>{service?.name}</h1>
        <p class="description">{t("booking.detail.description")}</p>
        {error && <p class="booking-error" role="alert">{error}</p>}
        {!turnstileConfigured && <p class="booking-error" role="alert">{t("booking.form.error.securityUnavailable")}</p>}
        <form method="post" class="booking-form">
          <section>
            <h2>{locale === "id" ? "Kontak" : "Contact"}</h2>
            <div class="fields">
              <label>{t("booking.form.name")}<input name="customerName" required autocomplete="name" /></label>
              <label>{t("booking.form.phone")}<input name="customerPhone" type="tel" required autocomplete="tel" /></label>
              <label>{t("booking.form.email")}<input name="customerEmail" type="email" autocomplete="email" /></label>
              <label class="wide">{t("booking.form.address")}<textarea name="serviceAddress" required rows="3" autocomplete="street-address"></textarea></label>
            </div>
            <h2>{locale === "id" ? "Jadwal" : "Schedule"}</h2>
            {schedule?.mode === "slot" ? (
              <div class="fields">
                <label>{t("booking.form.startDate")}<input name="startDate" type="date" required min={addDays(todayIso, schedule.leadTimeDays)} /></label>
                <label>{t("booking.form.slot")}<select name="slotId" required>
                  <option value="">—</option>
                  {slots.map((slot) => <option value={slot.id}>{weekdayNames[slot.weekday]} {slot.startTime}</option>)}
                </select></label>
              </div>
            ) : (
              <div class="fields">
                <label>{t("booking.form.startDate")}<input name="startDate" type="date" required min={addDays(todayIso, schedule?.leadTimeDays ?? 0)} /></label>
                <label>{t("booking.form.endDate")}<input name="endDate" type="date" required min={addDays(todayIso, schedule?.leadTimeDays ?? 0)} /></label>
              </div>
            )}
            <div class="fields">
              <label class="wide">{t("booking.form.note")}<textarea name="note" rows="3"></textarea></label>
            </div>
          </section>
          {turnstileConfigured && <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-action="booking"></div>}
          <button type="submit" disabled={!turnstileConfigured}>{t("booking.form.submit")}</button>
        </form>
      </>
    )}
  </main>
</Layout>

{turnstileConfigured && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
