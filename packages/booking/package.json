{
  "name": "@karsa/booking",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
