    "./routes/*": "./src/routes/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@karsa/catalog": "^0.3.0",
    "@karsa/core": "^0.3.0",
    "@karsa/orders": "^0.3.0",
    "@karsa/ui": "^0.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260710.1",
    "@karsa/config": "^0.3.0",
    "astro": "^7.0.9"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "astro": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "astro check"
  }
