---
import type { TkButtonProps } from "../types.js";

type Props = TkButtonProps;

const { variant = "primary", size = "md", type = "button", disabled = false } = Astro.props;
---

<tk-button variant={variant} size={size} type={type} disabled={disabled ? true : undefined}>
  <slot />
</tk-button>

<script>
  import "@tokotuku/elements/button";
</script>
