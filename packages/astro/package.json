{
  "name": "@tokotuku/astro",
  "version": "0.0.0",
  "description": "Astro wrappers around @tokotuku/elements Web Components. No business logic lives here — thin pass-through only.",
  "type": "module",
  "sideEffects": true,
  "exports": {
    "./TkButton.astro": "./src/components/TkButton.astro",
    "./TkInput.astro": "./src/components/TkInput.astro",
    "./TkCard.astro": "./src/components/TkCard.astro",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "dependencies": {
    "@tokotuku/elements": "workspace:*"
  },
  "devDependencies": {
    "@tokotuku/config": "workspace:*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
