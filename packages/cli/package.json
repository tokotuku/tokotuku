{
  "name": "@tokotuku/cli",
  "version": "0.0.0",
  "description": "Developer CLI for Tokotuku UI: create component, generate icon/docs/playground/changelog.",
  "type": "module",
  "sideEffects": true,
  "bin": {
    "tokotuku": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@tokotuku/config": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
